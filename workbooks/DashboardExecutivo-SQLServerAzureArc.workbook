    {
      "type": 1,
      "content": {
        "json": "## 📊 Executive Dashboard - SQL Server enabled by Azure Arc\n**Inventário técnico, configuração da extensão SQL Server e estimativas de apoio para licenciamento. KPIs por host usam contagem distinta para evitar dupla contagem quando há múltiplas instâncias no mesmo servidor.**"
      },
      "name": "metrics_header",
      "conditionalVisibility": {
        "parameterName": "SelectedTab",
        "comparison": "isEqualTo",
        "value": "VisaoGeral"
      }
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type == \"microsoft.hybridcompute/machines\"\n| extend joinId = tolower(id)\n| join kind=inner (\n    resources\n    | where type == \"microsoft.azurearcdata/sqlserverinstances\"\n    | extend arcMachineId = tolower(tostring(properties.containerResourceId))\n    | distinct arcMachineId\n) on $left.joinId == $right.arcMachineId\n| where resourceGroup in~ ({ResourceGroup})\n| summarize HostsSQL = dcount(joinId)",
              "size": 4,
              "title": "🏢 Hosts SQL Server",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "tiles",
              "tileSettings": {
                "leftContent": {
                  "columnMatch": "HostsSQL",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "green"
                  }
                },
                "showBorder": true,
                "size": "small"
              }
            },
            "customWidth": "9",
            "name": "kpi_machines"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type == \"microsoft.azurearcdata/sqlserverinstances\"\n| where resourceGroup in~ ({ResourceGroup})\n| summarize InstanciasSQL = count()",
              "size": 4,
              "title": "⚙️ Instâncias SQL Server",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "tiles",
              "tileSettings": {
                "leftContent": {
                  "columnMatch": "InstanciasSQL",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "orange"
                  }
                },
                "showBorder": true,
                "size": "small"
              }
            },
            "customWidth": "9",
            "name": "kpi_instances"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type == \"microsoft.hybridcompute/machines/extensions\"\n| where properties.publisher =~ \"Microsoft.AzureData\"\n| where tostring(properties.type) in (\"WindowsAgent.SqlServer\", \"LinuxAgent.SqlServer\")\n| extend hostId = tolower(substring(id, 0, indexof(id, \"/extensions\")))\n| extend licenseTypeRaw = tostring(properties.settings.LicenseType)\n| extend esuRaw = tostring(properties.settings.enableExtendedSecurityUpdates)\n| extend extState = tostring(properties.provisioningState)\n| where resourceGroup in~ ({ResourceGroup})\n| project hostId, licenseTypeRaw, esuRaw, extState\n| join kind=inner (\n    resources\n    | where type == \"microsoft.hybridcompute/machines\"\n    | extend hostId = tolower(id)\n    | extend logicalCores = toint(properties.detectedProperties.logicalCoreCount)\n    | extend physicalCores = toint(properties.detectedProperties.coreCount)\n    | project hostId, machineName = name, logicalCores, physicalCores\n) on hostId\n| join kind=leftouter (\n    resources\n    | where type == \"microsoft.azurearcdata/sqlserverinstances\"\n    | where resourceGroup in~ ({ResourceGroup})\n    | extend hostId = tolower(tostring(properties.containerResourceId))\n    | extend edition = tostring(properties.edition)\n    | extend instLicType = tostring(properties.licenseType)\n    | extend sqlVersion = tostring(properties.version)\n    | extend SQLVersionMajor = case(sqlVersion has \"SQL Server 2014\" or sqlVersion startswith \"12.\", \"SQL Server 2014\", sqlVersion has \"SQL Server 2016\" or sqlVersion startswith \"13.\", \"SQL Server 2016\", sqlVersion has \"SQL Server 2017\" or sqlVersion startswith \"14.\", \"SQL Server 2017\", sqlVersion has \"SQL Server 2019\" or sqlVersion startswith \"15.\", \"SQL Server 2019\", sqlVersion has \"SQL Server 2022\" or sqlVersion startswith \"16.\", \"SQL Server 2022\", sqlVersion has \"SQL Server 2025\" or sqlVersion startswith \"17.\", \"SQL Server 2025\", \"Não identificado\")\n    | extend isSQLServerESUVersion = SQLVersionMajor in (\"SQL Server 2014\", \"SQL Server 2016\")\n    | extend editionRank = case(edition has \"Enterprise\", 6, edition has \"Standard\", 5, edition has \"Web\", 4, edition has \"Express\", 3, edition has \"Developer\", 2, edition has \"Evaluation\", 1, 0)\n    | summarize topRank = max(editionRank), ativos = countif(instLicType !~ \"HADR\"), qtdSQLServerESU = countif(isSQLServerESUVersion), versoesSQL = make_set(SQLVersionMajor, 20) by hostId\n) on hostId\n| extend topEdition = case(topRank == 6, \"Enterprise\", topRank == 5, \"Standard\", topRank == 4, \"Web\", topRank == 3, \"Express\", topRank == 2, \"Developer\", topRank == 1, \"Evaluation\", \"Sem instância\")\n| extend ed3 = case(topEdition == \"Enterprise\", \"Ent\", topEdition == \"Standard\", \"Std\", topEdition == \"Web\", \"Web\", topEdition == \"Express\", \"Exp\", topEdition)\n| extend isFreeEdition = topEdition in (\"Developer\", \"Evaluation\", \"Express\")\n| extend isPassivo = (topRank > 0 and ativos == 0)\n| extend hasSQLServerESUVersion = qtdSQLServerESU > 0\n| extend coresDetectados = coalesce(logicalCores, physicalCores, 0)\n| extend coresHost = iff(coresDetectados < 4, 4, coresDetectados)\n| extend coresLicencaEstimados = case(topEdition == \"Sem instância\", 0, isFreeEdition, 0, isPassivo and licenseTypeRaw in (\"Paid\", \"PAYG\"), 0, isempty(licenseTypeRaw), 0, coresHost)\n| extend coresPAYG = iff(coresLicencaEstimados > 0 and licenseTypeRaw == \"PAYG\", coresHost, 0)\n| extend coresPaid = iff(coresLicencaEstimados > 0 and licenseTypeRaw == \"Paid\", coresHost, 0)\n| extend coresLicenseOnlyComLicenciamento = iff(coresLicencaEstimados > 0 and licenseTypeRaw == \"LicenseOnly\", coresHost, 0)\n| extend coresRZero = case(isFreeEdition, coresHost, isPassivo and licenseTypeRaw in (\"Paid\", \"PAYG\"), coresHost, 0)\n| summarize CoresConsideradosAnalise = sum(coresLicencaEstimados)",
              "size": 4,
              "title": "📌 Cores considerados na análise",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "tiles",
              "tileSettings": {
                "leftContent": {
                  "columnMatch": "CoresConsideradosAnalise",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "purple"
                  }
                },
                "showBorder": true,
                "size": "small"
              }
            },
            "customWidth": "9",
            "name": "kpi_estimated_cores"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type == \"microsoft.hybridcompute/machines/extensions\"\n| where properties.publisher =~ \"Microsoft.AzureData\"\n| where tostring(properties.type) in (\"WindowsAgent.SqlServer\", \"LinuxAgent.SqlServer\")\n| extend hostId = tolower(substring(id, 0, indexof(id, \"/extensions\")))\n| where resourceGroup in~ ({ResourceGroup})\n| summarize HostsPaid = dcountif(hostId, tostring(properties.settings.LicenseType) =~ \"Paid\")",
              "size": 4,
              "title": "🗃️ LicenseType = Paid",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "tiles",
              "tileSettings": {
                "leftContent": {
                  "columnMatch": "HostsPaid",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "blue"
                  }
                },
                "showBorder": true,
                "size": "small"
              }
            },
            "customWidth": "9",
            "name": "kpi_paid_hosts"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type == \"microsoft.hybridcompute/machines/extensions\"\n| where properties.publisher =~ \"Microsoft.AzureData\"\n| where tostring(properties.type) in (\"WindowsAgent.SqlServer\", \"LinuxAgent.SqlServer\")\n| extend hostId = tolower(substring(id, 0, indexof(id, \"/extensions\")))\n| where resourceGroup in~ ({ResourceGroup})\n| summarize HostsPAYG = dcountif(hostId, tostring(properties.settings.LicenseType) =~ \"PAYG\")",
              "size": 4,
              "title": "💰 LicenseType = PAYG",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "tiles",
              "tileSettings": {
                "leftContent": {
                  "columnMatch": "HostsPAYG",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "red"
                  }
                },
                "showBorder": true,
                "size": "small"
              }
            },
            "customWidth": "9",
            "name": "kpi_payg_hosts"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type == \"microsoft.hybridcompute/machines/extensions\"\n| where properties.publisher =~ \"Microsoft.AzureData\"\n| where tostring(properties.type) in (\"WindowsAgent.SqlServer\", \"LinuxAgent.SqlServer\")\n| extend hostId = tolower(substring(id, 0, indexof(id, \"/extensions\")))\n| extend licenseTypeRaw = tostring(properties.settings.LicenseType)\n| extend esuRaw = tostring(properties.settings.enableExtendedSecurityUpdates)\n| extend extState = tostring(properties.provisioningState)\n| where resourceGroup in~ ({ResourceGroup})\n| project hostId, licenseTypeRaw, esuRaw, extState\n| join kind=inner (\n    resources\n    | where type == \"microsoft.hybridcompute/machines\"\n    | extend hostId = tolower(id)\n    | extend logicalCores = toint(properties.detectedProperties.logicalCoreCount)\n    | extend physicalCores = toint(properties.detectedProperties.coreCount)\n    | project hostId, machineName = name, logicalCores, physicalCores\n) on hostId\n| join kind=leftouter (\n    resources\n    | where type == \"microsoft.azurearcdata/sqlserverinstances\"\n    | where resourceGroup in~ ({ResourceGroup})\n    | extend hostId = tolower(tostring(properties.containerResourceId))\n    | extend edition = tostring(properties.edition)\n    | extend instLicType = tostring(properties.licenseType)\n    | extend sqlVersion = tostring(properties.version)\n    | extend SQLVersionMajor = case(sqlVersion has \"SQL Server 2014\" or sqlVersion startswith \"12.\", \"SQL Server 2014\", sqlVersion has \"SQL Server 2016\" or sqlVersion startswith \"13.\", \"SQL Server 2016\", sqlVersion has \"SQL Server 2017\" or sqlVersion startswith \"14.\", \"SQL Server 2017\", sqlVersion has \"SQL Server 2019\" or sqlVersion startswith \"15.\", \"SQL Server 2019\", sqlVersion has \"SQL Server 2022\" or sqlVersion startswith \"16.\", \"SQL Server 2022\", sqlVersion has \"SQL Server 2025\" or sqlVersion startswith \"17.\", \"SQL Server 2025\", \"Não identificado\")\n    | extend isSQLServerESUVersion = SQLVersionMajor in (\"SQL Server 2014\", \"SQL Server 2016\")\n    | extend editionRank = case(edition has \"Enterprise\", 6, edition has \"Standard\", 5, edition has \"Web\", 4, edition has \"Express\", 3, edition has \"Developer\", 2, edition has \"Evaluation\", 1, 0)\n    | summarize topRank = max(editionRank), ativos = countif(instLicType !~ \"HADR\"), qtdSQLServerESU = countif(isSQLServerESUVersion), versoesSQL = make_set(SQLVersionMajor, 20) by hostId\n) on hostId\n| extend topEdition = case(topRank == 6, \"Enterprise\", topRank == 5, \"Standard\", topRank == 4, \"Web\", topRank == 3, \"Express\", topRank == 2, \"Developer\", topRank == 1, \"Evaluation\", \"Sem instância\")\n| extend ed3 = case(topEdition == \"Enterprise\", \"Ent\", topEdition == \"Standard\", \"Std\", topEdition == \"Web\", \"Web\", topEdition == \"Express\", \"Exp\", topEdition)\n| extend isFreeEdition = topEdition in (\"Developer\", \"Evaluation\", \"Express\")\n| extend isPassivo = (topRank > 0 and ativos == 0)\n| extend hasSQLServerESUVersion = qtdSQLServerESU > 0\n| extend coresDetectados = coalesce(logicalCores, physicalCores, 0)\n| extend coresHost = iff(coresDetectados < 4, 4, coresDetectados)\n| extend coresLicencaEstimados = case(topEdition == \"Sem instância\", 0, isFreeEdition, 0, isPassivo and licenseTypeRaw in (\"Paid\", \"PAYG\"), 0, isempty(licenseTypeRaw), 0, coresHost)\n| extend coresPAYG = iff(coresLicencaEstimados > 0 and licenseTypeRaw == \"PAYG\", coresHost, 0)\n| extend coresPaid = iff(coresLicencaEstimados > 0 and licenseTypeRaw == \"Paid\", coresHost, 0)\n| extend coresLicenseOnlyComLicenciamento = iff(coresLicencaEstimados > 0 and licenseTypeRaw == \"LicenseOnly\", coresHost, 0)\n| extend coresRZero = case(isFreeEdition, coresHost, isPassivo and licenseTypeRaw in (\"Paid\", \"PAYG\"), coresHost, 0)\n| summarize HostsLicenseOnlyComLicenciamento = dcountif(hostId, coresLicenseOnlyComLicenciamento > 0)",
              "size": 4,
              "title": "⚠️ LicenseOnly com cores estimados",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "tiles",
              "tileSettings": {
                "leftContent": {
                  "columnMatch": "HostsLicenseOnlyComLicenciamento",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "orange"
                  }
                },
                "showBorder": true,
                "size": "small"
              }
            },
            "customWidth": "9",
            "name": "kpi_licenseonly_billable"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type == \"microsoft.azurearcdata/sqlserverinstances\"\n| where resourceGroup in~ ({ResourceGroup})\n| extend hostId = tolower(tostring(properties.containerResourceId))\n| extend sqlVersion = tostring(properties.version)\n| extend SQLVersionMajor = case(sqlVersion has \"SQL Server 2014\" or sqlVersion startswith \"12.\", \"SQL Server 2014\", sqlVersion has \"SQL Server 2016\" or sqlVersion startswith \"13.\", \"SQL Server 2016\", \"Outro\")\n| where SQLVersionMajor in (\"SQL Server 2014\", \"SQL Server 2016\")\n| summarize InstanciasSQL2014_2016 = count()",
              "size": 4,
              "title": "🕒 Instâncias SQL Server 2014/2016",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "tiles",
              "tileSettings": {
                "leftContent": {
                  "columnMatch": "InstanciasSQL2014_2016",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "orange"
                  }
                },
                "showBorder": true,
                "size": "small"
              }
            },
            "customWidth": "9",
            "name": "kpi_sql_eos_instances"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type == \"microsoft.azurearcdata/sqlserverinstances\"\n| where resourceGroup in~ ({ResourceGroup})\n| extend hostId = tolower(tostring(properties.containerResourceId))\n| extend sqlVersion = tostring(properties.version)\n| extend SQLVersionMajor = case(sqlVersion has \"SQL Server 2014\" or sqlVersion startswith \"12.\", \"SQL Server 2014\", sqlVersion has \"SQL Server 2016\" or sqlVersion startswith \"13.\", \"SQL Server 2016\", \"Outro\")\n| where SQLVersionMajor in (\"SQL Server 2014\", \"SQL Server 2016\")\n| summarize by hostId\n| join kind=leftouter (\n    resources\n| where type == \"microsoft.hybridcompute/machines/extensions\"\n| where properties.publisher =~ \"Microsoft.AzureData\"\n| where tostring(properties.type) in (\"WindowsAgent.SqlServer\", \"LinuxAgent.SqlServer\")\n| extend hostId = tolower(substring(id, 0, indexof(id, \"/extensions\")))\n| where resourceGroup in~ ({ResourceGroup})\n    | extend esuRaw = tostring(properties.settings.enableExtendedSecurityUpdates)\n    | project hostId, esuRaw\n) on hostId\n| summarize HostsSQL2014_2016_ESU_Habilitado = dcountif(hostId, esuRaw =~ \"true\")",
              "size": 4,
              "title": "🛡️ Hosts SQL 2014/2016 com ESU",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "tiles",
