            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type =~ \"microsoft.azurearcdata/sqlserverinstances\"\n| where resourceGroup in~ ({ResourceGroup})\n| extend HostId = tolower(tostring(properties.containerResourceId))\n| extend Instancia = name, Edicao = tostring(properties.edition), Versao = tostring(properties.version), vCore = toint(properties.vCore)\n| join kind=leftouter (\n    resources\n    | where type =~ \"microsoft.hybridcompute/machines\"\n    | extend HostId = tolower(id)\n    | project HostId, MachineName = name\n) on HostId\n| where isempty(MachineName)\n| project Instancia, Edicao, Versao, vCore, MaquinaArcEsperada = HostId, ResourceGroup = resourceGroup, SubscriptionId = subscriptionId\n| order by Instancia asc",
