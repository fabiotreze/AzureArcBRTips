    {
      "type": 1,
      "content": {
        "json": "## 📊 Azure Arc - dados reportados e estado técnico\r\n**Esta visão prioriza fatos observados no Azure Resource Graph: hosts, instâncias, edição, versão, configuração da extensão, conectividade e telemetria. `LicenseType` e ESU são configurações reportadas pelo Azure Arc, não validações de direito ou cobrança. As estimativas técnicas de cores ficam na aba Estimativa técnica de licenciamento.**"
      },
      "name": "metrics_header",
      "conditionalVisibility": {
        "parameterName": "SelectedTab",
        "comparison": "isEqualTo",
        "value": "VisaoGeral"
      }
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type =~ \"microsoft.hybridcompute/machines\"\n| where resourceGroup in~ ({ResourceGroup})\n| where tostring(properties.detectedProperties.mssqldiscovered) =~ \"true\"\n| summarize HostsSQLDescobertos = count_distinct(tolower(id))",
              "size": 4,
              "title": "🏢 Servidores com SQL descoberto pelo Arc",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "tiles",
              "tileSettings": {
                "leftContent": {
                  "columnMatch": "HostsSQLDescobertos",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "green"
                  }
                },
                "showBorder": true,
                "size": "small"
              }
            },
            "customWidth": "25",
            "name": "kpi_machines"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type =~ \"microsoft.azurearcdata/sqlserverinstances\"\n| where resourceGroup in~ ({ResourceGroup})\n| extend hostId = tolower(tostring(properties.containerResourceId))\n| join kind=inner (resources | where type =~ \"microsoft.hybridcompute/machines\" | extend hostId = tolower(id) | distinct hostId) on hostId\n| summarize InstanciasSQL = count()",
              "size": 4,
              "title": "⚙️ Instâncias SQL Server",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "tiles",
              "tileSettings": {
                "leftContent": {
                  "columnMatch": "InstanciasSQL",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "orange"
                  }
                },
                "showBorder": true,
                "size": "small"
              }
            },
            "customWidth": "25",
            "name": "kpi_instances"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type == \"microsoft.hybridcompute/machines/extensions\"\n| where properties.publisher =~ \"Microsoft.AzureData\"\n| where tostring(properties.type) in (\"WindowsAgent.SqlServer\", \"LinuxAgent.SqlServer\")\n| extend hostId = tolower(substring(id, 0, indexof(id, \"/extensions\")))\n| where resourceGroup in~ ({ResourceGroup})\n| join kind=inner (\n    resources\n    | where type =~ \"microsoft.azurearcdata/sqlserverinstances\"\n    | where resourceGroup in~ ({ResourceGroup})\n    | extend hostId = tolower(tostring(properties.containerResourceId))\n    | distinct hostId\n) on hostId\n| join kind=inner (\n    resources\n    | where type =~ \"microsoft.hybridcompute/machines\"\n    | extend hostId = tolower(id)\n    | distinct hostId\n) on hostId| summarize HostsPaid = count_distinctif(hostId, tostring(properties.settings.LicenseType) =~ \"Paid\")",
              "size": 4,
              "title": "🗃️ Arc reporta LicenseType = Paid",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "tiles",
              "tileSettings": {
                "leftContent": {
                  "columnMatch": "HostsPaid",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "blue"
                  }
                },
                "showBorder": true,
                "size": "small"
              }
            },
            "customWidth": "25",
            "name": "kpi_paid_hosts"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type == \"microsoft.hybridcompute/machines/extensions\"\n| where properties.publisher =~ \"Microsoft.AzureData\"\n| where tostring(properties.type) in (\"WindowsAgent.SqlServer\", \"LinuxAgent.SqlServer\")\n| extend hostId = tolower(substring(id, 0, indexof(id, \"/extensions\")))\n| where resourceGroup in~ ({ResourceGroup})\n| join kind=inner (\n    resources\n    | where type =~ \"microsoft.azurearcdata/sqlserverinstances\"\n    | where resourceGroup in~ ({ResourceGroup})\n    | extend hostId = tolower(tostring(properties.containerResourceId))\n    | distinct hostId\n) on hostId\n| join kind=inner (\n    resources\n    | where type =~ \"microsoft.hybridcompute/machines\"\n    | extend hostId = tolower(id)\n    | distinct hostId\n) on hostId| summarize HostsPAYG = count_distinctif(hostId, tostring(properties.settings.LicenseType) =~ \"PAYG\")",
              "size": 4,
              "title": "☁️ Arc reporta LicenseType = PAYG",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "tiles",
              "tileSettings": {
                "leftContent": {
                  "columnMatch": "HostsPAYG",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "red"
                  }
                },
                "showBorder": true,
                "size": "small"
              }
            },
            "customWidth": "25",
            "name": "kpi_payg_hosts"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type == \"microsoft.hybridcompute/machines/extensions\"\n| where properties.publisher =~ \"Microsoft.AzureData\"\n| where tostring(properties.type) in (\"WindowsAgent.SqlServer\", \"LinuxAgent.SqlServer\")\n| extend hostId = tolower(substring(id, 0, indexof(id, \"/extensions\")))\n| extend licenseTypeRaw = tostring(properties.settings.LicenseType)\n| extend esuRaw = tostring(properties.settings.enableExtendedSecurityUpdates)\n| extend extState = tostring(properties.provisioningState)\n| where resourceGroup in~ ({ResourceGroup})\n| project hostId, licenseTypeRaw, esuRaw, extState\n| join kind=inner (\n    resources\n    | where type == \"microsoft.hybridcompute/machines\"\n    | extend hostId = tolower(id)\n    | extend logicalCores = toint(properties.detectedProperties.logicalCoreCount)\n    | extend physicalCores = toint(properties.detectedProperties.coreCount)\n    | extend manufacturer = tostring(properties.detectedProperties.manufacturer)\n    | extend model = tostring(properties.detectedProperties.model)\n    | extend VMbyManufacturer = manufacturer contains_cs \"VMware\" or manufacturer contains_cs \"QEMU\" or manufacturer contains_cs \"Amazon EC2\" or manufacturer contains_cs \"OpenStack\" or manufacturer contains_cs \"Hetzner\" or manufacturer contains_cs \"Mission Critical Cloud\" or manufacturer contains_cs \"DigitalOcean\" or manufacturer contains_cs \"UpCloud\" or manufacturer contains_cs \"oVirt\" or manufacturer contains_cs \"Alibaba\" or manufacturer contains_cs \"KubeVirt\" or manufacturer contains_cs \"Parallels\" or manufacturer contains_cs \"Bochs\" or manufacturer contains_cs \"XEN\"\n    | extend VMbyModel = model contains_cs \"OpenStack\" or model contains_cs \"Droplet\" or model contains_cs \"oVirt\" or model contains_cs \"Hypervisor\" or model contains_cs \"Virtual\" or model contains_cs \"BHYVE\" or model contains_cs \"KVM\"\n    | extend GoogleVM = manufacturer contains_cs \"Google\" and model contains_cs \"Google Compute Engine\"\n    | extend NutanixVM = manufacturer contains_cs \"Nutanix\" and model contains_cs \"AHV\"\n    | extend MicrosoftVM = manufacturer contains_cs \"Microsoft Corporation\" and model contains_cs \"Virtual Machine\"\n    | extend isVM = VMbyManufacturer or VMbyModel or GoogleVM or NutanixVM or MicrosoftVM\n    | project hostId, machineName = name, logicalCores, physicalCores, manufacturer, model, isVM\n) on hostId\n| join kind=leftouter (\n    resources\n    | where type == \"microsoft.azurearcdata/sqlserverinstances\"\n    | where resourceGroup in~ ({ResourceGroup})\n    | extend hostId = tolower(tostring(properties.containerResourceId))\n    | extend edition = tostring(properties.edition)\n    | extend instLicType = tostring(properties.licenseType)\n    | extend sqlVersion = tostring(properties.version)\n    | extend SQLVersionMajor = case(sqlVersion has \"SQL Server 2014\" or sqlVersion startswith \"12.\", \"SQL Server 2014\", sqlVersion has \"SQL Server 2016\" or sqlVersion startswith \"13.\", \"SQL Server 2016\", sqlVersion has \"SQL Server 2017\" or sqlVersion startswith \"14.\", \"SQL Server 2017\", sqlVersion has \"SQL Server 2019\" or sqlVersion startswith \"15.\", \"SQL Server 2019\", sqlVersion has \"SQL Server 2022\" or sqlVersion startswith \"16.\", \"SQL Server 2022\", sqlVersion has \"SQL Server 2025\" or sqlVersion startswith \"17.\", \"SQL Server 2025\", isnotempty(sqlVersion), sqlVersion, \"Não identificado\")\n    | extend isSQLServerESUVersion = SQLVersionMajor in (\"SQL Server 2014\", \"SQL Server 2016\")\n    | extend editionRank = case(edition has \"Enterprise\", 6, edition has \"Standard\", 5, edition has \"Web\", 4, edition has \"Express\", 3, edition has \"Developer\", 2, edition has \"Evaluation\", 1, 0)\n    | summarize topRank = max(editionRank), ativos = countif(instLicType !~ \"HADR\"), qtdSQLServerESU = countif(isSQLServerESUVersion), versoesSQL = make_set(SQLVersionMajor, 20) by hostId\n) on hostId\n| extend topEdition = case(topRank == 6, \"Enterprise\", topRank == 5, \"Standard\", topRank == 4, \"Web\", topRank == 3, \"Express\", topRank == 2, \"Developer\", topRank == 1, \"Evaluation\", \"Sem instância\")\n| extend ed3 = case(topEdition == \"Enterprise\", \"Ent\", topEdition == \"Standard\", \"Std\", topEdition == \"Web\", \"Web\", topEdition == \"Express\", \"Exp\", topEdition)\n| extend isFreeEdition = topEdition in (\"Developer\", \"Evaluation\", \"Express\")\n| extend isPassivo = (topRank > 0 and ativos == 0)\n| extend hasSQLServerESUVersion = qtdSQLServerESU > 0\n| extend coresDetectados = iff(isVM, logicalCores, physicalCores)\n| extend coresHostBase = iff(coalesce(coresDetectados, 0) < 4, 4, coresDetectados)\n| extend coresHost = iff(topEdition == \"Standard\" and coresHostBase > 24, 24, coresHostBase)\n| extend coresLicencaEstimados = case(topEdition == \"Sem instância\", 0, isFreeEdition, 0, isPassivo and licenseTypeRaw in (\"Paid\", \"PAYG\"), 0, isempty(licenseTypeRaw), 0, coresHost)\n| extend coresPAYG = iff(coresLicencaEstimados > 0 and licenseTypeRaw == \"PAYG\", coresHost, 0)\n| extend coresPaid = iff(coresLicencaEstimados > 0 and licenseTypeRaw == \"Paid\", coresHost, 0)\n| extend coresLicenseOnlyComLicenciamento = iff(coresLicencaEstimados > 0 and licenseTypeRaw == \"LicenseOnly\", coresHost, 0)\n| extend coresRZero = case(isFreeEdition, coresHost, isPassivo and licenseTypeRaw in (\"Paid\", \"PAYG\"), coresHost, 0)\n| summarize HostsLicenseOnlyComLicenciamento = count_distinctif(hostId, coresLicenseOnlyComLicenciamento > 0)",
              "size": 4,
              "title": "⚠️ Hosts LicenseOnly com cores incluídos na estimativa",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "tiles",
              "tileSettings": {
                "leftContent": {
                  "columnMatch": "HostsLicenseOnlyComLicenciamento",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "orange"
                  }
                },
                "showBorder": true,
                "size": "small"
              }
            },
            "customWidth": "25",
            "name": "kpi_licenseonly_billable"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type =~ \"microsoft.azurearcdata/sqlserverinstances\"\n| where resourceGroup in~ ({ResourceGroup})\n| extend hostId = tolower(tostring(properties.containerResourceId))\n| join kind=inner (resources | where type =~ \"microsoft.hybridcompute/machines\" | extend hostId = tolower(id) | distinct hostId) on hostId\n| extend sqlVersion = tostring(properties.version)\n| extend SQLVersionMajor = case(sqlVersion has \"SQL Server 2014\" or sqlVersion startswith \"12.\", \"SQL Server 2014\", sqlVersion has \"SQL Server 2016\" or sqlVersion startswith \"13.\", \"SQL Server 2016\", \"Outro\")\n| where SQLVersionMajor in (\"SQL Server 2014\", \"SQL Server 2016\")\n| summarize InstanciasSQL2014_2016 = count()",
              "size": 4,
              "title": "🕒 Instâncias SQL Server 2014/2016",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "tiles",
              "tileSettings": {
                "leftContent": {
                  "columnMatch": "InstanciasSQL2014_2016",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "orange"
                  }
                },
                "showBorder": true,
                "size": "small"
              }
            },
            "customWidth": "25",
            "name": "kpi_sql_eos_instances"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type =~ \"microsoft.azurearcdata/sqlserverinstances\"\n| where resourceGroup in~ ({ResourceGroup})\n| extend hostId = tolower(tostring(properties.containerResourceId))\n| join kind=inner (resources | where type =~ \"microsoft.hybridcompute/machines\" | extend hostId = tolower(id), MachineOSType = tostring(properties.osType) | where MachineOSType =~ \"windows\" | distinct hostId) on hostId\n| extend sqlVersion = tostring(properties.version)\n| extend sqlEdition = tostring(properties.edition)\n| where sqlEdition in~ (\"Enterprise\", \"Standard\")\n| extend SQLVersionMajor = case(sqlVersion has \"SQL Server 2014\" or sqlVersion startswith \"12.\", \"SQL Server 2014\", sqlVersion has \"SQL Server 2016\" or sqlVersion startswith \"13.\", \"SQL Server 2016\", \"Outro\")\n| where SQLVersionMajor in (\"SQL Server 2014\", \"SQL Server 2016\")\n| summarize by hostId\n| join kind=leftouter (resources | where type =~ \"microsoft.hybridcompute/machines/extensions\" | where tostring(properties.publisher) =~ \"Microsoft.AzureData\" | where tostring(properties.type) in (\"WindowsAgent.SqlServer\",\"LinuxAgent.SqlServer\") | extend hostId = tolower(substring(id, 0, indexof(id, \"/extensions\"))) | where resourceGroup in~ ({ResourceGroup}) | extend esuRaw = tostring(properties.settings.enableExtendedSecurityUpdates), licenseTypeRaw = tostring(properties.settings.LicenseType) | project hostId, esuRaw, licenseTypeRaw) on hostId\n| summarize HostsSQL2014_2016_ESU_Habilitado = count_distinctif(hostId, licenseTypeRaw in~ (\"Paid\", \"PAYG\") and esuRaw =~ \"true\")",
              "size": 4,
              "title": "🛡️ SQL 2014/2016 Paid/PAYG com ESU habilitado",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "tiles",
              "tileSettings": {
                "leftContent": {
                  "columnMatch": "HostsSQL2014_2016_ESU_Habilitado",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "purple"
                  }
                },
                "showBorder": true,
                "size": "small"
              }
            },
            "customWidth": "25",
            "name": "kpi_sql_eos_esu_enabled"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type =~ \"microsoft.azurearcdata/sqlserverinstances\"\n| where resourceGroup in~ ({ResourceGroup})\n| extend hostId = tolower(tostring(properties.containerResourceId))\n| join kind=inner (resources | where type =~ \"microsoft.hybridcompute/machines\" | extend hostId = tolower(id), MachineOSType = tostring(properties.osType) | where MachineOSType =~ \"windows\" | distinct hostId) on hostId\n| extend sqlVersion = tostring(properties.version)\n| extend sqlEdition = tostring(properties.edition)\n| where sqlEdition in~ (\"Enterprise\", \"Standard\")\n| extend SQLVersionMajor = case(sqlVersion has \"SQL Server 2014\" or sqlVersion startswith \"12.\", \"SQL Server 2014\", sqlVersion has \"SQL Server 2016\" or sqlVersion startswith \"13.\", \"SQL Server 2016\", \"Outro\")\n| where SQLVersionMajor in (\"SQL Server 2014\", \"SQL Server 2016\")\n| summarize by hostId\n| join kind=leftouter (resources | where type =~ \"microsoft.hybridcompute/machines/extensions\" | where tostring(properties.publisher) =~ \"Microsoft.AzureData\" | where tostring(properties.type) in (\"WindowsAgent.SqlServer\",\"LinuxAgent.SqlServer\") | extend hostId = tolower(substring(id, 0, indexof(id, \"/extensions\"))) | where resourceGroup in~ ({ResourceGroup}) | extend esuRaw = tostring(properties.settings.enableExtendedSecurityUpdates), licenseTypeRaw = tostring(properties.settings.LicenseType) | project hostId, esuRaw, licenseTypeRaw) on hostId\n| summarize HostsSQL2014_2016_ESU_NaoHabilitado = count_distinctif(hostId, licenseTypeRaw in~ (\"Paid\", \"PAYG\") and (esuRaw !~ \"true\" or isempty(esuRaw)))",
              "size": 4,
              "title": "🚨 SQL 2014/2016 Paid/PAYG sem ESU habilitado",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "tiles",
              "tileSettings": {
                "leftContent": {
                  "columnMatch": "HostsSQL2014_2016_ESU_NaoHabilitado",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "red"
                  }
                },
                "showBorder": true,
                "size": "small"
              }
            },
            "customWidth": "25",
            "name": "kpi_sql_eos_esu_not_enabled"
          }
        ]
      },
      "name": "metrics_group",
      "conditionalVisibility": {
        "parameterName": "SelectedTab",
        "comparison": "isEqualTo",
        "value": "VisaoGeral"
      }
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type =~ \"microsoft.azurearcdata/sqlserverinstances\"\n| where resourceGroup in~ ({ResourceGroup})\n| extend hostId = tolower(tostring(properties.containerResourceId))\n| join kind=inner (resources | where type =~ \"microsoft.hybridcompute/machines\" | extend hostId = tolower(id) | distinct hostId) on hostId\n| extend edition = tostring(properties.edition)\n| extend editionRank = case(edition has \"Enterprise\", 6, edition has \"Standard\", 5, edition has \"Web\", 4, edition has \"Express\", 3, edition has \"Developer\", 2, edition has \"Evaluation\", 1, 0)\n| summarize topRank = max(editionRank) by hostId\n| extend EdicaoHost = case(topRank == 6, \"Enterprise\", topRank == 5, \"Standard\", topRank == 4, \"Web\", topRank == 3, \"Express\", topRank == 2, \"Developer\", topRank == 1, \"Evaluation\", \"Não identificado\")\n| summarize HostsEnterprise = count_distinctif(hostId, EdicaoHost == \"Enterprise\")",
              "size": 4,
              "title": "🏢 Hosts por maior edição: Enterprise",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "tiles",
              "tileSettings": {
                "leftContent": {
                  "columnMatch": "HostsEnterprise",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "purple"
                  }
                },
                "showBorder": true,
                "size": "small"
              }
            },
            "customWidth": "25",
            "name": "kpi_hosts_enterprise"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type =~ \"microsoft.azurearcdata/sqlserverinstances\"\n| where resourceGroup in~ ({ResourceGroup})\n| extend hostId = tolower(tostring(properties.containerResourceId))\n| join kind=inner (resources | where type =~ \"microsoft.hybridcompute/machines\" | extend hostId = tolower(id) | distinct hostId) on hostId\n| extend edition = tostring(properties.edition)\n| extend editionRank = case(edition has \"Enterprise\", 6, edition has \"Standard\", 5, edition has \"Web\", 4, edition has \"Express\", 3, edition has \"Developer\", 2, edition has \"Evaluation\", 1, 0)\n| summarize topRank = max(editionRank) by hostId\n| extend EdicaoHost = case(topRank == 6, \"Enterprise\", topRank == 5, \"Standard\", topRank == 4, \"Web\", topRank == 3, \"Express\", topRank == 2, \"Developer\", topRank == 1, \"Evaluation\", \"Não identificado\")\n| summarize HostsStandard = count_distinctif(hostId, EdicaoHost == \"Standard\")",
              "size": 4,
              "title": "🏢 Hosts por maior edição: Standard",
              "queryType": 1,
