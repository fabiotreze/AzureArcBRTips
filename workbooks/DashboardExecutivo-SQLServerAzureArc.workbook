          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type =~ \"microsoft.azurearcdata/sqlserverinstances\"\n| where resourceGroup in~ ({ResourceGroup})\n| extend hostId = tolower(tostring(properties.containerResourceId))\n| join kind=inner (resources | where type =~ \"microsoft.hybridcompute/machines\" | extend hostId = tolower(id) | distinct hostId) on hostId\n| extend edition = tostring(properties.edition)\n| extend editionRank = case(edition has \"Enterprise\", 6, edition has \"Standard\", 5, edition has \"Web\", 4, edition has \"Express\", 3, edition has \"Developer\", 2, edition has \"Evaluation\", 1, 0)\n| summarize topRank = max(editionRank) by hostId\n| extend EdicaoHost = case(topRank == 6, \"Enterprise\", topRank == 5, \"Standard\", topRank == 4, \"Web\", topRank == 3, \"Express\", topRank == 2, \"Developer\", topRank == 1, \"Evaluation\", \"Não identificado\")\n| summarize HostsOutrasEdicoes = count_distinctif(hostId, EdicaoHost !in (\"Enterprise\", \"Standard\", \"Developer\", \"Evaluation\", \"Express\"))",
              "size": 4,
              "title": "📦 Hosts por maior edição: outras",
