          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type =~ \"microsoft.azurearcdata/sqlserverinstances\"\n| where resourceGroup in~ ({ResourceGroup})\n| extend hostId = tolower(tostring(properties.containerResourceId))\n| join kind=inner (resources | where type =~ \"microsoft.hybridcompute/machines\" | extend hostId = tolower(id) | distinct hostId) on hostId\n| extend sqlVersion = tostring(properties.version)\n| extend SQLVersionMajor = case(sqlVersion has \"SQL Server 2014\" or sqlVersion startswith \"12.\", \"SQL Server 2014\", sqlVersion has \"SQL Server 2016\" or sqlVersion startswith \"13.\", \"SQL Server 2016\", sqlVersion has \"SQL Server 2017\" or sqlVersion startswith \"14.\", \"SQL Server 2017\", sqlVersion has \"SQL Server 2019\" or sqlVersion startswith \"15.\", \"SQL Server 2019\", sqlVersion has \"SQL Server 2022\" or sqlVersion startswith \"16.\", \"SQL Server 2022\", sqlVersion has \"SQL Server 2025\" or sqlVersion startswith \"17.\", \"SQL Server 2025\", \"Não identificado\")\n| summarize Instancias=count(), Hosts=count_distinct(hostId) by SQLVersionMajor\n| join kind=leftouter (\n    resources\n    | where type =~ \"microsoft.azurearcdata/sqlserverinstances\"\n    | where resourceGroup in~ ({ResourceGroup})\n    | extend hostId = tolower(tostring(properties.containerResourceId))\n    | join kind=inner (resources | where type =~ \"microsoft.hybridcompute/machines\" | extend hostId = tolower(id), MachineOSType = tostring(properties.osType) | where MachineOSType =~ \"windows\" | distinct hostId) on hostId\n    | extend sqlVersion = tostring(properties.version)\n    | extend sqlEdition = tostring(properties.edition)\n    | where sqlEdition in~ (\"Enterprise\", \"Standard\")\n    | extend SQLVersionMajor = case(sqlVersion has \"SQL Server 2014\" or sqlVersion startswith \"12.\", \"SQL Server 2014\", sqlVersion has \"SQL Server 2016\" or sqlVersion startswith \"13.\", \"SQL Server 2016\", \"Other\")\n    | where SQLVersionMajor in (\"SQL Server 2014\", \"SQL Server 2016\")\n    | summarize by SQLVersionMajor, hostId\n    | join kind=leftouter (\n        resources\n        | where type =~ \"microsoft.hybridcompute/machines/extensions\"\n        | where tostring(properties.publisher) =~ \"Microsoft.AzureData\"\n        | where tostring(properties.type) in (\"WindowsAgent.SqlServer\", \"LinuxAgent.SqlServer\")\n        | extend hostId = tolower(substring(id, 0, indexof(id, \"/extensions\")))\n        | extend esuRaw = tostring(properties.settings.enableExtendedSecurityUpdates)\n        | extend licenseTypeRaw = tostring(properties.settings.LicenseType)\n        | project hostId, esuRaw, licenseTypeRaw\n    ) on hostId\n    | where licenseTypeRaw in~ (\"Paid\", \"PAYG\")\n    | summarize HostsElegiveisESU=count_distinct(hostId), HostsESUHabilitado=count_distinctif(hostId, esuRaw =~ \"true\"), HostsESUNaoHabilitado=count_distinctif(hostId, esuRaw !~ \"true\" or isempty(esuRaw)) by SQLVersionMajor\n) on SQLVersionMajor\n| extend AplicabilidadeESU = iff(SQLVersionMajor in (\"SQL Server 2014\", \"SQL Server 2016\"), \"Avaliada para Windows Enterprise/Standard\", \"Não aplicável\")\n| project SQLVersionMajor, Instancias, Hosts, AplicabilidadeESU, HostsElegiveisESU=coalesce(HostsElegiveisESU,0), HostsESUHabilitado=coalesce(HostsESUHabilitado,0), HostsESUNaoHabilitado=coalesce(HostsESUNaoHabilitado,0)\n| order by SQLVersionMajor asc",
              "size": 0,
              "title": "🛡️ SQL Server ESU readiness (Windows Enterprise/Standard)",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "table",
              "gridSettings": {
                "filter": true
              }
            },
            "name": "esu_readiness",
            "customWidth": "100"
          }
        ]
      },
      "name": "analysis_matrices",
      "conditionalVisibility": {
        "parameterName": "SelectedTab",
        "comparison": "isEqualTo",
        "value": "Licenciamento"
      }
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type =~ \"microsoft.hybridcompute/machines/extensions\"\n| where tostring(properties.publisher) =~ \"Microsoft.AzureData\"\n| where tostring(properties.type) in (\"WindowsAgent.SqlServer\",\"LinuxAgent.SqlServer\")\n| where resourceGroup in~ ({ResourceGroup})\n| extend HostId = tolower(substring(id, 0, indexof(id, \"/extensions\")))\n| extend Host = tostring(split(id, \"/\")[8])\n| extend LicenseType = tostring(properties.settings.LicenseType)\n| extend SQLServerESU = case(tostring(properties.settings.enableExtendedSecurityUpdates) =~ \"true\", \"Enabled\", tostring(properties.settings.enableExtendedSecurityUpdates) =~ \"false\", \"Not enabled\", \"Not reported\")\n| extend ExtensionState = tostring(properties.provisioningState)\n| project HostId, Host, LicenseType, SQLServerESU, ExtensionState, ResourceGroup = tostring(resourceGroup), SubscriptionId = tostring(subscriptionId)\n| join kind=leftouter (\n    resources\n    | where type =~ \"microsoft.hybridcompute/machines\"\n    | where resourceGroup in~ ({ResourceGroup})\n    | extend HostId = tolower(id)\n    | extend ArcStatus = tostring(properties.status)\n    | extend LogicalCoreCount = toint(properties.detectedProperties.logicalCoreCount)\n    | extend PhysicalCoreCount = toint(properties.detectedProperties.coreCount)\n    | extend Manufacturer = tostring(properties.detectedProperties.manufacturer)\n    | extend Model = tostring(properties.detectedProperties.model)\n    | extend VMbyManufacturer = Manufacturer contains_cs \"VMware\" or Manufacturer contains_cs \"QEMU\" or Manufacturer contains_cs \"Amazon EC2\" or Manufacturer contains_cs \"OpenStack\" or Manufacturer contains_cs \"Hetzner\" or Manufacturer contains_cs \"Mission Critical Cloud\" or Manufacturer contains_cs \"DigitalOcean\" or Manufacturer contains_cs \"UpCloud\" or Manufacturer contains_cs \"oVirt\" or Manufacturer contains_cs \"Alibaba\" or Manufacturer contains_cs \"KubeVirt\" or Manufacturer contains_cs \"Parallels\" or Manufacturer contains_cs \"Bochs\" or Manufacturer contains_cs \"XEN\"\n    | extend VMbyModel = Model contains_cs \"OpenStack\" or Model contains_cs \"Droplet\" or Model contains_cs \"oVirt\" or Model contains_cs \"Hypervisor\" or Model contains_cs \"Virtual\" or Model contains_cs \"BHYVE\" or Model contains_cs \"KVM\"\n    | extend GoogleVM = Manufacturer contains_cs \"Google\" and Model contains_cs \"Google Compute Engine\"\n    | extend NutanixVM = Manufacturer contains_cs \"Nutanix\" and Model contains_cs \"AHV\"\n    | extend MicrosoftVM = Manufacturer contains_cs \"Microsoft Corporation\" and Model contains_cs \"Virtual Machine\"\n    | extend IsVM = VMbyManufacturer or VMbyModel or GoogleVM or NutanixVM or MicrosoftVM\n    | extend HostTypeTecnico = iff(IsVM, \"Virtual\", \"Physical\")\n    | extend CoresDetectados = iff(IsVM, LogicalCoreCount, PhysicalCoreCount)\n    | extend CoresHostBase = iff(coalesce(CoresDetectados, 0) < 4, 4, CoresDetectados)\n    | project HostId, ArcStatus, Manufacturer, Model, HostTypeTecnico, LogicalCoreCount, PhysicalCoreCount, CoresHostBase\n) on HostId\n| join kind=leftouter (\n    resources\n    | where type =~ \"microsoft.azurearcdata/sqlserverinstances\"\n    | where resourceGroup in~ ({ResourceGroup})\n    | extend HostId = tolower(tostring(properties.containerResourceId))\n    | extend EdicaoSQL = tostring(properties.edition)\n    | extend InstanceLicenseType = tostring(properties.licenseType)\n    | extend SQLVersion = tostring(properties.version)\n    | extend SQLVersionMajor = case(SQLVersion has \"SQL Server 2014\" or SQLVersion startswith \"12.\", \"SQL Server 2014\", SQLVersion has \"SQL Server 2016\" or SQLVersion startswith \"13.\", \"SQL Server 2016\", SQLVersion has \"SQL Server 2017\" or SQLVersion startswith \"14.\", \"SQL Server 2017\", SQLVersion has \"SQL Server 2019\" or SQLVersion startswith \"15.\", \"SQL Server 2019\", SQLVersion has \"SQL Server 2022\" or SQLVersion startswith \"16.\", \"SQL Server 2022\", SQLVersion has \"SQL Server 2025\" or SQLVersion startswith \"17.\", \"SQL Server 2025\", \"Não identificado\")\n    | extend VCoreInstancia = toint(properties.vCore)\n    | extend EditionRank = case(EdicaoSQL has \"Enterprise\", 6, EdicaoSQL has \"Standard\", 5, EdicaoSQL has \"Web\", 4, EdicaoSQL has \"Express\", 3, EdicaoSQL has \"Developer\", 2, EdicaoSQL has \"Evaluation\", 1, 0)\n    | summarize InstanciasSQL = count(), InstanciasAtivas = countif(InstanceLicenseType !~ \"HADR\"), EditionRank = max(EditionRank), EdicoesRaw = make_set(EdicaoSQL, 20), VersoesRaw = make_set(SQLVersionMajor, 20), InstanceLicenseTypesRaw = make_set(InstanceLicenseType, 20), vCoreInstanciaTotal = sum(VCoreInstancia) by HostId\n) on HostId\n| extend EdicaoMaisAlta = case(EditionRank == 6, \"Enterprise\", EditionRank == 5, \"Standard\", EditionRank == 4, \"Web\", EditionRank == 3, \"Express\", EditionRank == 2, \"Developer\", EditionRank == 1, \"Evaluation\", \"Não identificado\")\n| extend EdicoesSQL = tostring(EdicoesRaw), VersoesSQL = tostring(VersoesRaw), LicenseTypesInstancia = tostring(InstanceLicenseTypesRaw)\n| extend CoresHost = iff(EdicaoMaisAlta == \"Standard\" and CoresHostBase > 24, 24, CoresHostBase)\n| extend IsFreeEdition = EdicaoMaisAlta in (\"Developer\",\"Evaluation\",\"Express\")\n| extend IsPassivoHADR = coalesce(InstanciasSQL, 0) > 0 and coalesce(InstanciasAtivas, 0) == 0\n| extend CoresConsideradosAnalise = case(coalesce(InstanciasSQL, 0) == 0, 0, IsFreeEdition, 0, IsPassivoHADR and LicenseType in (\"Paid\",\"PAYG\"), 0, isempty(LicenseType), 0, CoresHost)\n| extend ClassificacaoWorkbook = case(isempty(LicenseType), \"LicenseType pendente\", IsFreeEdition, \"Edição gratuita / avaliação\", IsPassivoHADR, \"Somente HA/DR reportado\", LicenseType == \"PAYG\", \"Configuração PAYG\", LicenseType == \"Paid\", \"Configuração Paid\", LicenseType == \"LicenseOnly\", \"Configuração LicenseOnly\", \"Configuração reportada\")\n| extend InterpretacaoConfiguracao = case(isempty(LicenseType), \"Revisar configuração da extensão SQL Server\", IsFreeEdition, \"Cores não considerados na análise\", IsPassivoHADR, \"Cores não considerados na análise HA/DR\", CoresConsideradosAnalise > 0, \"Cores considerados na análise técnica\", \"Sem cores considerados\")\n| project Host, ArcStatus, ExtensionState, LicenseType, SQLServerESU, EdicaoMaisAlta, EdicoesSQL, VersoesSQL, LicenseTypesInstancia, InstanciasSQL, vCoreInstanciaTotal, Manufacturer, Model, HostTypeTecnico, LogicalCoreCount, PhysicalCoreCount, CoresHostBase, CoresHost, CoresConsideradosAnalise, ClassificacaoWorkbook, InterpretacaoConfiguracao, ResourceGroup, SubscriptionId\n| order by Host asc",
              "size": 0,
              "title": "🧾 Estimativa técnica SQL Server por Host/OSE",
              "noDataMessage": "Nenhum host SQL Server enabled by Azure Arc com extensão SQL Server no escopo selecionado.",
              "noDataMessageStyle": 3,
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "table",
              "gridSettings": {
                "filter": true,
                "formatters": [
                  {
                    "columnMatch": "CoresConsideradosAnalise",
                    "formatter": 8,
                    "formatOptions": {
                      "palette": "red"
                    }
                  },
                  {
                    "columnMatch": "CoresHost",
                    "formatter": 8,
                    "formatOptions": {
                      "palette": "blue"
                    }
                  }
                ]
              }
            },
            "customWidth": "100",
            "name": "trueup_table"
          },
          {
            "type": 1,
            "content": {
              "json": "### Como ler a tabela\n\n**Host/OSE** é o servidor físico ou máquina virtual que hospeda uma ou mais instâncias SQL Server. Esta visão é consolidada por host, não por instância individual.\n\n| Campo | Leitura |\n| --- | --- |\n| **LicenseType** | valor reportado pela Azure Extension for SQL Server: `Paid`, `PAYG`, `LicenseOnly` ou pendente. Representa configuração técnica observada, não uma validação final de licenciamento contratual. |\n| **CoresConsideradosAnalise** | estimativa técnica calculada pelo workbook para apoiar análise de configuração SQL Server por host/OSE. Não substitui Product Terms, contrato, billing real ou avaliação SAM oficial. |\n| **HostTypeTecnico** | classificação derivada com a expressão oficial Microsoft baseada em `manufacturer` e `model`; não usa `sqlserverinstances.properties.hostType`, pois esse campo pode não ser reportado. |\n| **CoresHostBase** | para VM usa `logicalCoreCount`; para físico usa `coreCount`; aplica mínimo técnico de 4 cores por OSE. |\n| **CoresHost** | estimativa após o limite de 24 cores para a maior edição Standard do host; Enterprise preserva `CoresHostBase`. |\n| **ArcStatus** | conectividade reportada pelo Azure Arc. Hosts `Disconnected` permanecem no inventário, mas seus dados podem estar desatualizados e não representam consumo ou cobrança corrente. |\n| **ClassificacaoWorkbook** | classificação auxiliar calculada pelo workbook com base em edição, LicenseType e estado HA/DR reportado. É um rótulo de análise técnica, não uma conclusão legal/comercial. |\n| **InterpretacaoConfiguracao** | leitura auxiliar da configuração reportada, não uma linha de fatura nem uma confirmação de conformidade. |\n| **SQLServerESU** | estado da configuração de Extended Security Updates do SQL Server quando a versão é SQL Server 2014 ou SQL Server 2016. |\n| **VersoesSQL** | versões principais identificadas nas instâncias SQL Server do host. |\n\n**Nota:** a configuração `UsePhysicalCoreLicense` é documentada para cenários específicos, mas não foi mantida como coluna/KPI principal porque pode aparecer vazia em consultas de Azure Resource Graph em alguns ambientes. A query de validação está na aba **Referências**. O workbook é um inventário técnico e suporte de análise, e não um atestado de licenciamento final."
            },
            "name": "trueup_legend",
            "customWidth": "100"
          }
        ]
      },
      "name": "trueup_detail",
      "conditionalVisibility": {
        "parameterName": "SelectedTab",
        "comparison": "isEqualTo",
        "value": "Licenciamento"
      }
    },
    {
      "type": 1,
      "content": {
        "json": "---\n## 📊 Capacidade Técnica das Instâncias SQL Server\n**Visão técnica de `properties.vCore` por instância SQL Server. Não representa fatura, AHB, PAYG, true-up ou ACR.**"
      },
      "name": "distribution_header",
      "conditionalVisibility": {
        "parameterName": "SelectedTab",
        "comparison": "isEqualTo",
        "value": "Inventario"
      }
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type =~ \"microsoft.azurearcdata/sqlserverinstances\"\n| where resourceGroup in~ ({ResourceGroup})\n| extend hostId = tolower(tostring(properties.containerResourceId))\n| join kind=inner (resources | where type =~ \"microsoft.hybridcompute/machines\" | extend hostId = tolower(id) | distinct hostId) on hostId\n| extend sqlEdition = tostring(properties.edition)\n| extend sqlVcores = toint(properties.vCore)\n| where isnotempty(sqlEdition)\n| summarize VCoreInstancias = sum(sqlVcores) by sqlEdition\n| order by VCoreInstancias desc",
              "size": 4,
              "title": "💻 vCores por edição SQL Server (instâncias)",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "tiles",
              "tileSettings": {
                "titleContent": {
                  "columnMatch": "sqlEdition",
                  "formatter": 1
                },
                "leftContent": {
                  "columnMatch": "VCoreInstancias",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "blue"
                  }
                },
                "showBorder": true,
                "size": "small"
              }
            },
            "customWidth": "50",
            "name": "vcores_by_edition"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type == \"microsoft.hybridcompute/machines/extensions\"\n| where properties.publisher =~ \"Microsoft.AzureData\"\n| where tostring(properties.type) in (\"WindowsAgent.SqlServer\", \"LinuxAgent.SqlServer\")\n| extend hostId = tolower(substring(id, 0, indexof(id, \"/extensions\")))\n| extend licenseTypeRaw = tostring(properties.settings.LicenseType)\n| where resourceGroup in~ ({ResourceGroup})\n| join kind=leftouter (\n    resources\n    | where type == \"microsoft.azurearcdata/sqlserverinstances\"\n    | where resourceGroup in~ ({ResourceGroup})\n    | extend hostId = tolower(tostring(properties.containerResourceId))\n    | extend sqlVcores = toint(properties.vCore)\n    | project hostId, sqlVcores\n) on hostId\n| extend LicenseType = case(licenseTypeRaw == \"PAYG\", \"PAYG\", licenseTypeRaw == \"Paid\", \"Paid\", licenseTypeRaw == \"LicenseOnly\", \"LicenseOnly\", isempty(licenseTypeRaw), \"Pendente\", licenseTypeRaw)\n| summarize VCoreInstancias = sum(sqlVcores) by LicenseType\n| order by VCoreInstancias desc",
              "size": 4,
              "title": "💳 vCores por LicenseType (instâncias)",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "tiles",
              "tileSettings": {
                "titleContent": {
                  "columnMatch": "LicenseType",
                  "formatter": 1
                },
                "leftContent": {
                  "columnMatch": "VCoreInstancias",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "yellow"
                  }
                },
                "showBorder": true,
                "size": "small"
              }
            },
            "customWidth": "50",
            "name": "vcores_by_license"
          }
        ]
      },
      "name": "capacity_group",
      "conditionalVisibility": {
        "parameterName": "SelectedTab",
        "comparison": "isEqualTo",
        "value": "Inventario"
      }
    },
    {
      "type": 1,
      "content": {
        "json": "---\r\n## 📋 Inventário Técnico de Instâncias SQL Server\r\n**Registro por instância para auditoria técnica de versão, edição, LicenseType, plataforma detectada e sinais de HA/FCI reportados pelo Azure Arc. A edição desta tabela é a edição reportada pela instância; matrizes por host podem usar a maior edição identificada no host. Classificações de plataforma e topologia são evidências técnicas, não comprovação contratual ou desenho completo da arquitetura.**"
      },
      "name": "inventory_header",
      "conditionalVisibility": {
        "parameterName": "SelectedTab",
        "comparison": "isEqualTo",
        "value": "Inventario"
      }
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\r\n| where type =~ \"microsoft.hybridcompute/machines\"\r\n| where resourceGroup in~ ({ResourceGroup})\r\n| extend HostId = tolower(id)\r\n| join kind=inner (\r\n    resources\r\n    | where type =~ \"microsoft.azurearcdata/sqlserverinstances\"\r\n    | where resourceGroup in~ ({ResourceGroup})\r\n    | extend HostId = tolower(tostring(properties.containerResourceId))\r\n    | distinct HostId\r\n) on HostId\r\n| extend Manufacturer = tostring(properties.detectedProperties.manufacturer), Model = tostring(properties.detectedProperties.model), CloudProvider = tostring(properties.detectedProperties.cloudprovider), HypervisorType = tostring(properties.detectedProperties.hypervisorType)\r\n| extend PlataformaReportada = case(isnotempty(HypervisorType) and HypervisorType !~ \"None\" and HypervisorType !~ \"N/A\", HypervisorType, isnotempty(CloudProvider) and CloudProvider !~ \"N/A\", CloudProvider, Model =~ \"Virtual Machine\", \"Máquina virtual (hipervisor não reportado)\", isnotempty(Manufacturer) or isnotempty(Model), \"Servidor físico ou não classificado\", \"Não reportado\")\r\n| summarize Hosts = dcount(HostId) by PlataformaReportada\r\n| order by Hosts desc",
              "size": 1,
              "title": "🖥️ Hosts SQL por plataforma reportada",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "piechart",
              "chartSettings": {
                "createOtherGroup": 0,
                "showLegend": true,
                "labelColumn": "PlataformaReportada",
                "valueColumn": "Hosts"
              }
            },
            "customWidth": "30",
            "name": "platform_summary"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type == \"microsoft.hybridcompute/machines\"\n| extend MachineStatusRaw = tostring(properties.status), MachineProvisioningStatus = tostring(properties.provisioningState), MachineErrors = tostring(properties.errorDetails), MachineOSType = tostring(properties.osType)\n| extend Manufacturer = tostring(properties.detectedProperties.manufacturer), Model = tostring(properties.detectedProperties.model), CloudProvider = tostring(properties.detectedProperties.cloudprovider), HypervisorType = tostring(properties.detectedProperties.hypervisorType), ServerType = tostring(properties.detectedProperties.serverType)\n| extend arcStatus = case(tolower(MachineStatusRaw) == \"connected\", \"Connected\", tolower(MachineStatusRaw) == \"disconnected\", \"Offline\", tolower(MachineStatusRaw) == \"error\", \"Error\", tolower(MachineStatusRaw) == \"expired\", \"Expired\", \"Unknown\")\n| extend joinId = tolower(id)\n| join kind = leftouter (\n    resources\n    | where type == \"microsoft.azurearcdata/sqlserverinstances\"\n    | extend arcMachineId = tolower(tostring(properties.containerResourceId))\n    | extend sqlVersion = tostring(properties.version)\n    | extend SQLVersionMajor = case(sqlVersion has \"SQL Server 2014\" or sqlVersion startswith \"12.\", \"SQL Server 2014\", sqlVersion has \"SQL Server 2016\" or sqlVersion startswith \"13.\", \"SQL Server 2016\", sqlVersion has \"SQL Server 2017\" or sqlVersion startswith \"14.\", \"SQL Server 2017\", sqlVersion has \"SQL Server 2019\" or sqlVersion startswith \"15.\", \"SQL Server 2019\", sqlVersion has \"SQL Server 2022\" or sqlVersion startswith \"16.\", \"SQL Server 2022\", sqlVersion has \"SQL Server 2025\" or sqlVersion startswith \"17.\", \"SQL Server 2025\", \"Não identificado\")\n    | extend sqlVcores = toint(properties.vCore)\n    | extend sqlEdition = tostring(properties.edition)\n    | extend sqlInstanceName = name\n    | extend sqlModel = tostring(properties.licenseType)\n| extend isHadrEnabled = tostring(properties.isHadrEnabled), alwaysOnRole = tostring(properties.alwaysOnRole), failoverCluster = todynamic(properties.failoverCluster)\n| extend failoverClusterName = tostring(failoverCluster.networkName), failoverClusterHosts = strcat_array(failoverCluster.hostNames, \", \")\n    | project arcMachineId, sqlInstanceName, sqlVersion, SQLVersionMajor, sqlEdition, sqlVcores, sqlModel, isHadrEnabled, alwaysOnRole, failoverClusterName, failoverClusterHosts\n) on $left.joinId == $right.arcMachineId\n| join kind = leftouter (\n    resources\n    | where type == \"microsoft.hybridcompute/machines/extensions\"\n    | where properties.publisher =~ \"Microsoft.AzureData\"\n    | where tostring(properties.type) in (\"WindowsAgent.SqlServer\", \"LinuxAgent.SqlServer\")\n    | extend extMachineId = tolower(substring(id, 0, indexof(id, \"/extensions\")))\n    | extend licenseTypeRaw = tostring(properties.settings.LicenseType)\n    | extend esuRaw = tostring(properties.settings.enableExtendedSecurityUpdates)\n    | extend extStateRaw = tostring(properties.provisioningState)\n    | extend extMsg = tostring(properties.instanceView.status.message)\n    | extend extUploadTs = coalesce(extract(\"timestampUTC : ([0-9]{4}[/-][0-9]{2}[/-][0-9]{2})\", 1, extMsg), extract(\"timestampUTC: ([0-9]{4}[/-][0-9]{2}[/-][0-9]{2})\", 1, extMsg))\n    | extend extUploadDate = todatetime(strcat(replace_string(extUploadTs, \"/\", \"-\"), \"T00:00:00Z\"))\n    | extend extHealthOK = extMsg contains \"SQL Server Extension Agent: Healthy\"\n    | extend extUploadOK = extMsg contains \"uploadStatus : OK\" or extMsg contains \"uploadStatus: OK\" or extMsg contains \"uploadStatus:OK\"\n    | extend extUploadOutsideRange = isnull(extUploadDate) or extUploadDate < startofday(ago(3d)) or extUploadDate > startofday(now())\n    | project extMachineId, licenseTypeRaw, esuRaw, extStateRaw, extHealthOK, extUploadOK, extUploadOutsideRange\n) on $left.joinId == $right.extMachineId\n| where isnotempty(sqlVersion)\n| where resourceGroup in~ ({ResourceGroup})\n| extend LicenseTypeExtensao = case(licenseTypeRaw == \"Paid\", \"Paid\", licenseTypeRaw == \"PAYG\", \"PAYG\", licenseTypeRaw == \"LicenseOnly\", \"LicenseOnly\", \"Pendente\")\n| extend IsESUEligibilityEvaluated = MachineOSType =~ \"windows\" and sqlEdition in~ (\"Enterprise\", \"Standard\") and SQLVersionMajor in (\"SQL Server 2014\", \"SQL Server 2016\")\n| extend SQLServerESU = case(IsESUEligibilityEvaluated and esuRaw =~ \"true\", \"SQL Server ESU habilitado\", IsESUEligibilityEvaluated, \"SQL Server ESU não habilitado\", SQLVersionMajor in (\"SQL Server 2014\", \"SQL Server 2016\"), \"Elegibilidade não avaliada\", \"Não aplicável\")\n| extend DataConfidenceHealthy = MachineStatusRaw =~ \"Connected\" and MachineProvisioningStatus =~ \"Succeeded\" and (isempty(MachineErrors) or MachineErrors == \"[]\") and extStateRaw =~ \"Succeeded\" and extHealthOK and extUploadOK and extUploadOutsideRange == false\n| extend ExtensaoSQL = case(isempty(extStateRaw), \"Sem extensão\", DataConfidenceHealthy, \"Saudável\", \"Com atenção\")\n| extend LicenseTypeInstancia = case(sqlModel =~ \"HADR\", \"HA/DR passivo\", sqlModel =~ \"ServerCAL\", \"Server+CAL\", sqlModel =~ \"PerCore\", \"Per-core\", sqlModel =~ \"Free\", \"Free/Eval/Express\", isempty(sqlModel), \"-\", sqlModel)\n| extend PlataformaReportada = case(isnotempty(HypervisorType) and HypervisorType !~ \"None\" and HypervisorType !~ \"N/A\", HypervisorType, isnotempty(CloudProvider) and CloudProvider !~ \"N/A\", CloudProvider, Model =~ \"Virtual Machine\", \"Máquina virtual (hipervisor não reportado)\", isnotempty(Manufacturer) or isnotempty(Model), \"Servidor físico ou não classificado\", \"Não reportado\")\n| extend TopologiaHAReportada = case(alwaysOnRole =~ \"AvailabilityGroupReplica\", \"Réplica de Availability Group\", alwaysOnRole =~ \"FailoverClusterInstance\", \"Instância FCI\", alwaysOnRole =~ \"FailoverClusterNode\", \"Nó de failover cluster\", isHadrEnabled =~ \"true\", \"HADR habilitado; papel não reportado\", \"Sem topologia HA reportada\")\n| project Host = name, ArcStatus = arcStatus, ExtensaoSQL, PlataformaReportada, Manufacturer, Model, CloudProvider, HypervisorType, ServerType, InstanciaSQL = sqlInstanceName, VersaoSQL = sqlVersion, SQLVersionMajor, EdicaoSQL = sqlEdition, LicenseTypeInstancia, LicenseTypeExtensao, TopologiaHAReportada, IsHadrEnabled = isHadrEnabled, AlwaysOnRole = alwaysOnRole, FailoverClusterName = failoverClusterName, FailoverClusterHosts = failoverClusterHosts, SQLServerESU, vCoreInstancia = sqlVcores\n| order by Host asc",
              "size": 0,
              "title": "📋 Inventário de Instâncias, Plataforma e HA/FCI reportados pelo Azure Arc",
              "noDataMessage": "Nenhuma instância SQL Server enabled by Azure Arc no escopo selecionado.",
              "noDataMessageStyle": 3,
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "table",
              "gridSettings": {
                "filter": true,
                "sortBy": [
                  {
                    "itemKey": "Host",
                    "sortOrder": 1
                  }
                ],
                "formatters": [
                  {
                    "columnMatch": "vCoreInstancia",
                    "formatter": 8,
                    "formatOptions": {
                      "palette": "blue"
                    }
                  }
                ]
              }
            },
            "customWidth": "70",
            "name": "inventory_table"
          },
          {
            "type": 1,
            "content": {
              "json": "### Guia de interpretação\r\n\r\n| Coluna | Significado |\r\n| --- | --- |\r\n| **Host** | servidor Arc que hospeda a instância SQL Server |\r\n| **ArcStatus** | estado do Arc-enabled server |\r\n| **ExtensaoSQL** | confiança operacional consolidada: `Saudável` somente quando máquina, provisioning, mensagem, upload e recência estão válidos; caso contrário `Com atenção` ou `Sem extensão` |\r\n| **PlataformaReportada** | classificação conservadora baseada em `hypervisorType`, `cloudprovider`, fabricante e modelo reportados pelo Arc; ausência de valor resulta em `Não reportado` ou `não classificado` |\r\n| **Manufacturer / Model** | fabricante e modelo detectados pelo Connected Machine agent; servem como evidência, não como inventário físico definitivo |\r\n| **SQLVersionMajor** | classificação da versão principal identificada pela string de versão reportada |\r\n| **LicenseTypeInstancia** | modelo técnico reportado no recurso da instância SQL Server; `HADR` indica tratamento técnico de licenciamento, mas não prova sozinho AG, FCI, papel Primary/Secondary ou passividade operacional |\r\n| **LicenseTypeExtensao** | `Paid`, `PAYG`, `LicenseOnly` ou pendente. Valor técnico reportado pela extensão; não substitui decisão contratual |\r\n| **TopologiaHAReportada** | sinal derivado somente de `alwaysOnRole` e `isHadrEnabled` reportados pela instância |\r\n| **AlwaysOnRole** | papel reportado, como `AvailabilityGroupReplica`, `FailoverClusterInstance` ou `FailoverClusterNode`; não inventa Primary/Secondary quando essa informação não existe |\r\n| **FailoverClusterName / Hosts** | nome e membros reportados em `failoverCluster`; podem estar vazios ou parciais conforme o recurso |\r\n| **SQLServerESU** | configuração ESU avaliada como habilitada/não habilitada somente para SQL Server 2014/2016 Enterprise ou Standard em Windows; demais casos não são declarados como falha |\r\n| **vCoreInstancia** | capacidade técnica por instância; não é base isolada para true-up, billing ou conformidade final |\r\n\r\n**Ação prática:** use os campos de plataforma e HA/FCI para segmentação e investigação. Confirme arquitetura, papéis operacionais e direitos de licenciamento em fontes próprias antes de decisões comerciais ou de compliance."
            },
            "name": "inventory_legend",
            "customWidth": "100"
          }
        ]
      },
      "name": "inventory_group",
      "conditionalVisibility": {
        "parameterName": "SelectedTab",
        "comparison": "isEqualTo",
        "value": "Inventario"
      }
    },
    {
      "type": 1,
      "content": {
        "json": "## 📡 Saúde operacional como confiança dos dados\r\n\r\nEsta aba não substitui o dashboard operacional oficial de SQL Server enabled by Azure Arc. Ela indica a confiança e a atualidade dos dados usados nas demais abas para o universo canônico de máquinas Arc reais com instância SQL associada.\r\n\r\n### Como ler o sinal de confiança\r\nUma extensão só é **saudável** quando todos os critérios abaixo são comprovados:\r\n1. máquina Arc `Connected`;\r\n2. provisioning da máquina `Succeeded` e sem erros reportados;\r\n3. provisioning da extensão `Succeeded`;\r\n4. mensagem contendo `SQL Server Extension Agent: Healthy`;\r\n5. `uploadStatus = OK`;\r\n6. timestamp presente, não futuro e dentro da janela dos últimos três dias de calendário.\r\n\r\nO critério parte da consulta oficial de troubleshooting e é propositalmente mais conservador ao incluir provisioning e erros da máquina. Qualquer ausência, ambiguidade ou falha resulta em **com atenção**. Use `FailureReasons` e `RecommendedAction` para distinguir conectividade, provisioning, erro da máquina, saúde do agente e upload. Poucos saudáveis indicam menor confiança/frescura; não invalidam isoladamente `LicenseType` nem determinam conformidade. A cobertura usa máquinas Arc reais com instância SQL associada como universo canônico."
      },
      "name": "operational_health_intro",
      "conditionalVisibility": {
        "parameterName": "SelectedTab",
        "comparison": "isEqualTo",
        "value": "SaudeOperacional"
      }
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type =~ \"microsoft.azurearcdata/sqlserverinstances\"\n| where resourceGroup in~ ({ResourceGroup})\n| extend hostId = tolower(tostring(properties.containerResourceId))\n| distinct hostId\n| join kind=inner (resources | where type =~ \"microsoft.hybridcompute/machines\" | extend hostId = tolower(id) | distinct hostId) on hostId\n| join kind=leftouter (resources | where type =~ \"microsoft.hybridcompute/machines/extensions\" | where resourceGroup in~ ({ResourceGroup}) | where tostring(properties.publisher) =~ \"Microsoft.AzureData\" | where tostring(properties.type) in (\"WindowsAgent.SqlServer\",\"LinuxAgent.SqlServer\") | extend hostId = tolower(substring(id, 0, indexof(id, \"/extensions\"))) | distinct hostId | extend HasExt = \"yes\") on hostId\n| summarize SQLDiscoveredHosts = count(), SQLExtensionHosts = countif(HasExt == \"yes\")\n| extend CoveragePct = iff(SQLDiscoveredHosts == 0, 0.0, round(100.0 * todouble(SQLExtensionHosts) / todouble(SQLDiscoveredHosts), 2))\n| extend Metric = \"Cobertura SQL extension (%)\", Value = CoveragePct, Detail = strcat(tostring(SQLExtensionHosts), \" de \", tostring(SQLDiscoveredHosts), \" hosts SQL\")\n| project Metric, Value, Detail",
              "size": 1,
              "title": "Cobertura Azure Arc SQL",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "tiles",
              "tileSettings": {
                "showBorder": false,
                "titleContent": {
                  "columnMatch": "Metric"
                },
                "leftContent": {
                  "columnMatch": "Value",
                  "formatter": 12
                },
                "secondaryContent": {
                  "columnMatch": "Detail"
                }
              }
            },
            "customWidth": "25",
            "name": "op_extension_coverage"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type =~ \"microsoft.hybridcompute/machines/extensions\"\n| where resourceGroup in~ ({ResourceGroup})\n| where tostring(properties.publisher) =~ \"Microsoft.AzureData\"\n| where tostring(properties.type) in (\"WindowsAgent.SqlServer\",\"LinuxAgent.SqlServer\")\n| extend HostId = tolower(substring(id, 0, indexof(id, \"/extensions\")))\n| join kind=inner (\n    resources\n    | where type =~ \"microsoft.azurearcdata/sqlserverinstances\"\n    | where resourceGroup in~ ({ResourceGroup})\n    | extend HostId = tolower(tostring(properties.containerResourceId))\n    | distinct HostId\n) on HostId\n| extend ExtensionResourceID = tostring(id)\n| extend targetMachineName = tolower(tostring(split(id, \"/\")[8]))\n| extend ExtensionProvisioningState = tostring(properties.provisioningState)\n| extend LicenseType = tostring(properties.settings.LicenseType)\n| extend Message = tostring(properties.instanceView.status.message)\n| extend LastReportedExtensionHealth = iff(Message contains \"SQL Server Extension Agent: Healthy\", \"Healthy\", \"Unhealthy\")\n| extend LastExtensionUploadStatus = iff(Message contains \"uploadStatus : OK\" or Message contains \"uploadStatus: OK\" or Message contains \"uploadStatus:OK\", \"OK\", \"Unhealthy\")\n| extend LastExtensionUploadTimestamp = coalesce(extract(\"timestampUTC : ([0-9]{4}[/-][0-9]{2}[/-][0-9]{2})\", 1, Message), extract(\"timestampUTC: ([0-9]{4}[/-][0-9]{2}[/-][0-9]{2})\", 1, Message))\n| extend LastExtensionUploadDate = todatetime(strcat(replace_string(LastExtensionUploadTimestamp, \"/\", \"-\"), \"T00:00:00Z\"))\n| extend LastUploadOutsideAcceptableRange = isnull(LastExtensionUploadDate) or LastExtensionUploadDate < startofday(ago(3d)) or LastExtensionUploadDate > startofday(now())\n| join kind=leftouter (\n    resources\n    | where type =~ \"microsoft.hybridcompute/machines\"\n    | where resourceGroup in~ ({ResourceGroup})\n    | extend LowerMachineName = tolower(tostring(name))\n    | project MachineId = tostring(id), MachineName = tostring(name), LowerMachineName, MachineStatus = tostring(properties.status), MachineProvisioningStatus = tostring(properties.provisioningState), MachineErrors = tostring(properties.errorDetails), subscriptionId, resourceGroup, TenantID = tenantId\n) on $left.targetMachineName == $right.LowerMachineName, subscriptionId, resourceGroup\n| extend IsHealthy = MachineStatus =~ \"Connected\" and MachineProvisioningStatus =~ \"Succeeded\" and (isempty(MachineErrors) or MachineErrors == \"[]\") and ExtensionProvisioningState =~ \"Succeeded\" and LastReportedExtensionHealth =~ \"Healthy\" and LastExtensionUploadStatus =~ \"OK\" and LastUploadOutsideAcceptableRange == false\n| extend HealthState = iff(IsHealthy, \"Healthy\", \"Needs attention\")\n| extend FailureReasons = strcat(\n    iif(MachineStatus !~ \"Connected\", strcat(\"Machine status is \", MachineStatus, \"; \"), \"\"),\n    iif(MachineProvisioningStatus !~ \"Succeeded\", strcat(\"Machine provisioning state is \", MachineProvisioningStatus, \"; \"), \"\"),\n    iif(isnotempty(MachineErrors) and MachineErrors != \"[]\", \"Machine reports errors; \", \"\"),\n    iif(LastReportedExtensionHealth !~ \"Healthy\", \"Extension reported unhealthy; \", \"\"),\n    iif(LastUploadOutsideAcceptableRange, \"Last upload outside acceptable range; \", \"\"),\n    iif(LastExtensionUploadStatus !~ \"OK\", \"Upload status not OK; \", \"\"),\n    iif(ExtensionProvisioningState !~ \"Succeeded\", strcat(\"Extension provisioning state is \", ExtensionProvisioningState, \"; \"), \"\")\n)\n| extend RecommendedAction = case(\n    MachineStatus =~ \"Disconnected\", \"Reconnect the Azure Arc machine and validate agent connectivity.\",\n    MachineStatus =~ \"Expired\", \"Renew or repair the Azure Arc machine certificate and reconnect the machine.\",\n    MachineProvisioningStatus !~ \"Succeeded\", \"Validate Azure Arc machine provisioning state.\",\n    isnotempty(MachineErrors) and MachineErrors != \"[]\", \"Review and resolve errors reported by the Azure Arc machine.\",\n    ExtensionProvisioningState !~ \"Succeeded\", \"Validate SQL extension provisioning state.\",\n    LastExtensionUploadStatus !~ \"OK\", \"Review SQL extension status message, DPS connectivity and extension logs.\",\n    LastUploadOutsideAcceptableRange, \"Validate whether the extension is still uploading inventory and billing data.\",\n    LastReportedExtensionHealth !~ \"Healthy\", \"Review SQL extension status message and failure reasons.\",\n    \"No immediate action from this workbook signal.\"\n)\n| project MachineName, MachineStatus, HealthState, LastReportedExtensionHealth, LastExtensionUploadStatus, LastExtensionUploadTimestamp, LicenseType, ExtensionProvisioningState, RecommendedAction, FailureReasons, SubscriptionID = subscriptionId, ResourceGroup = resourceGroup, ExtensionResourceID, MachineId\n| order by HealthState desc, MachineName asc\n| summarize Value = countif(HealthState == \"Healthy\")\n| extend Metric = \"SQL extensions saudáveis\", Detail = \"Sinal de confiança dos dados reportados\"\n| project Metric, Value, Detail",
              "size": 1,
              "title": "SQL extensions saudáveis",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "tiles",
              "tileSettings": {
                "showBorder": false,
                "titleContent": {
                  "columnMatch": "Metric"
                },
                "leftContent": {
                  "columnMatch": "Value",
                  "formatter": 12
                },
                "secondaryContent": {
                  "columnMatch": "Detail"
                }
              }
            },
            "customWidth": "25",
            "name": "op_healthy_extensions"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type =~ \"microsoft.hybridcompute/machines/extensions\"\n| where resourceGroup in~ ({ResourceGroup})\n| where tostring(properties.publisher) =~ \"Microsoft.AzureData\"\n| where tostring(properties.type) in (\"WindowsAgent.SqlServer\",\"LinuxAgent.SqlServer\")\n| extend HostId = tolower(substring(id, 0, indexof(id, \"/extensions\")))\n| join kind=inner (\n    resources\n    | where type =~ \"microsoft.azurearcdata/sqlserverinstances\"\n    | where resourceGroup in~ ({ResourceGroup})\n    | extend HostId = tolower(tostring(properties.containerResourceId))\n    | distinct HostId\n) on HostId\n| extend ExtensionResourceID = tostring(id)\n| extend targetMachineName = tolower(tostring(split(id, \"/\")[8]))\n| extend ExtensionProvisioningState = tostring(properties.provisioningState)\n| extend LicenseType = tostring(properties.settings.LicenseType)\n| extend Message = tostring(properties.instanceView.status.message)\n| extend LastReportedExtensionHealth = iff(Message contains \"SQL Server Extension Agent: Healthy\", \"Healthy\", \"Unhealthy\")\n| extend LastExtensionUploadStatus = iff(Message contains \"uploadStatus : OK\" or Message contains \"uploadStatus: OK\" or Message contains \"uploadStatus:OK\", \"OK\", \"Unhealthy\")\n| extend LastExtensionUploadTimestamp = coalesce(extract(\"timestampUTC : ([0-9]{4}[/-][0-9]{2}[/-][0-9]{2})\", 1, Message), extract(\"timestampUTC: ([0-9]{4}[/-][0-9]{2}[/-][0-9]{2})\", 1, Message))\n| extend LastExtensionUploadDate = todatetime(strcat(replace_string(LastExtensionUploadTimestamp, \"/\", \"-\"), \"T00:00:00Z\"))\n| extend LastUploadOutsideAcceptableRange = isnull(LastExtensionUploadDate) or LastExtensionUploadDate < startofday(ago(3d)) or LastExtensionUploadDate > startofday(now())\n| join kind=leftouter (\n    resources\n    | where type =~ \"microsoft.hybridcompute/machines\"\n    | where resourceGroup in~ ({ResourceGroup})\n    | extend LowerMachineName = tolower(tostring(name))\n    | project MachineId = tostring(id), MachineName = tostring(name), LowerMachineName, MachineStatus = tostring(properties.status), MachineProvisioningStatus = tostring(properties.provisioningState), MachineErrors = tostring(properties.errorDetails), subscriptionId, resourceGroup, TenantID = tenantId\n) on $left.targetMachineName == $right.LowerMachineName, subscriptionId, resourceGroup\n| extend IsHealthy = MachineStatus =~ \"Connected\" and MachineProvisioningStatus =~ \"Succeeded\" and (isempty(MachineErrors) or MachineErrors == \"[]\") and ExtensionProvisioningState =~ \"Succeeded\" and LastReportedExtensionHealth =~ \"Healthy\" and LastExtensionUploadStatus =~ \"OK\" and LastUploadOutsideAcceptableRange == false\n| extend HealthState = iff(IsHealthy, \"Healthy\", \"Needs attention\")\n| extend FailureReasons = strcat(\n    iif(MachineStatus !~ \"Connected\", strcat(\"Machine status is \", MachineStatus, \"; \"), \"\"),\n    iif(MachineProvisioningStatus !~ \"Succeeded\", strcat(\"Machine provisioning state is \", MachineProvisioningStatus, \"; \"), \"\"),\n    iif(isnotempty(MachineErrors) and MachineErrors != \"[]\", \"Machine reports errors; \", \"\"),\n    iif(LastReportedExtensionHealth !~ \"Healthy\", \"Extension reported unhealthy; \", \"\"),\n    iif(LastUploadOutsideAcceptableRange, \"Last upload outside acceptable range; \", \"\"),\n    iif(LastExtensionUploadStatus !~ \"OK\", \"Upload status not OK; \", \"\"),\n    iif(ExtensionProvisioningState !~ \"Succeeded\", strcat(\"Extension provisioning state is \", ExtensionProvisioningState, \"; \"), \"\")\n)\n| extend RecommendedAction = case(\n    MachineStatus =~ \"Disconnected\", \"Reconnect the Azure Arc machine and validate agent connectivity.\",\n    MachineStatus =~ \"Expired\", \"Renew or repair the Azure Arc machine certificate and reconnect the machine.\",\n    MachineProvisioningStatus !~ \"Succeeded\", \"Validate Azure Arc machine provisioning state.\",\n    isnotempty(MachineErrors) and MachineErrors != \"[]\", \"Review and resolve errors reported by the Azure Arc machine.\",\n    ExtensionProvisioningState !~ \"Succeeded\", \"Validate SQL extension provisioning state.\",\n    LastExtensionUploadStatus !~ \"OK\", \"Review SQL extension status message, DPS connectivity and extension logs.\",\n    LastUploadOutsideAcceptableRange, \"Validate whether the extension is still uploading inventory and billing data.\",\n    LastReportedExtensionHealth !~ \"Healthy\", \"Review SQL extension status message and failure reasons.\",\n    \"No immediate action from this workbook signal.\"\n)\n| project MachineName, MachineStatus, HealthState, LastReportedExtensionHealth, LastExtensionUploadStatus, LastExtensionUploadTimestamp, LicenseType, ExtensionProvisioningState, RecommendedAction, FailureReasons, SubscriptionID = subscriptionId, ResourceGroup = resourceGroup, ExtensionResourceID, MachineId\n| order by HealthState desc, MachineName asc\n| summarize Value = countif(HealthState != \"Healthy\")\n| extend Metric = \"SQL extensions com atenção\", Detail = \"Indica risco de dados incompletos ou desatualizados\"\n| project Metric, Value, Detail",
              "size": 1,
              "title": "SQL extensions com atenção",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "tiles",
              "tileSettings": {
                "showBorder": false,
                "titleContent": {
                  "columnMatch": "Metric"
                },
                "leftContent": {
                  "columnMatch": "Value",
                  "formatter": 12
                },
                "secondaryContent": {
                  "columnMatch": "Detail"
                }
              }
            },
            "customWidth": "25",
            "name": "op_unhealthy_extensions"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type =~ \"microsoft.hybridcompute/machines/extensions\"\n| where resourceGroup in~ ({ResourceGroup})\n| where tostring(properties.publisher) =~ \"Microsoft.AzureData\"\n| where tostring(properties.type) in (\"WindowsAgent.SqlServer\",\"LinuxAgent.SqlServer\")\n| extend HostId = tolower(substring(id, 0, indexof(id, \"/extensions\")))\n| join kind=inner (\n    resources\n    | where type =~ \"microsoft.azurearcdata/sqlserverinstances\"\n    | where resourceGroup in~ ({ResourceGroup})\n    | extend HostId = tolower(tostring(properties.containerResourceId))\n    | distinct HostId\n) on HostId\n| extend ExtensionResourceID = tostring(id)\n| extend targetMachineName = tolower(tostring(split(id, \"/\")[8]))\n| extend ExtensionProvisioningState = tostring(properties.provisioningState)\n| extend LicenseType = tostring(properties.settings.LicenseType)\n| extend Message = tostring(properties.instanceView.status.message)\n| extend LastReportedExtensionHealth = iff(Message contains \"SQL Server Extension Agent: Healthy\", \"Healthy\", \"Unhealthy\")\n| extend LastExtensionUploadStatus = iff(Message contains \"uploadStatus : OK\" or Message contains \"uploadStatus: OK\" or Message contains \"uploadStatus:OK\", \"OK\", \"Unhealthy\")\n| extend LastExtensionUploadTimestamp = coalesce(extract(\"timestampUTC : ([0-9]{4}[/-][0-9]{2}[/-][0-9]{2})\", 1, Message), extract(\"timestampUTC: ([0-9]{4}[/-][0-9]{2}[/-][0-9]{2})\", 1, Message))\n| extend LastExtensionUploadDate = todatetime(strcat(replace_string(LastExtensionUploadTimestamp, \"/\", \"-\"), \"T00:00:00Z\"))\n| extend LastUploadOutsideAcceptableRange = isnull(LastExtensionUploadDate) or LastExtensionUploadDate < startofday(ago(3d)) or LastExtensionUploadDate > startofday(now())\n| join kind=leftouter (\n    resources\n    | where type =~ \"microsoft.hybridcompute/machines\"\n    | where resourceGroup in~ ({ResourceGroup})\n    | extend LowerMachineName = tolower(tostring(name))\n    | project MachineId = tostring(id), MachineName = tostring(name), LowerMachineName, MachineStatus = tostring(properties.status), MachineProvisioningStatus = tostring(properties.provisioningState), MachineErrors = tostring(properties.errorDetails), subscriptionId, resourceGroup, TenantID = tenantId\n) on $left.targetMachineName == $right.LowerMachineName, subscriptionId, resourceGroup\n| extend IsHealthy = MachineStatus =~ \"Connected\" and MachineProvisioningStatus =~ \"Succeeded\" and (isempty(MachineErrors) or MachineErrors == \"[]\") and ExtensionProvisioningState =~ \"Succeeded\" and LastReportedExtensionHealth =~ \"Healthy\" and LastExtensionUploadStatus =~ \"OK\" and LastUploadOutsideAcceptableRange == false\n| extend HealthState = iff(IsHealthy, \"Healthy\", \"Needs attention\")\n| extend FailureReasons = strcat(\n    iif(MachineStatus !~ \"Connected\", strcat(\"Machine status is \", MachineStatus, \"; \"), \"\"),\n    iif(MachineProvisioningStatus !~ \"Succeeded\", strcat(\"Machine provisioning state is \", MachineProvisioningStatus, \"; \"), \"\"),\n    iif(isnotempty(MachineErrors) and MachineErrors != \"[]\", \"Machine reports errors; \", \"\"),\n    iif(LastReportedExtensionHealth !~ \"Healthy\", \"Extension reported unhealthy; \", \"\"),\n    iif(LastUploadOutsideAcceptableRange, \"Last upload outside acceptable range; \", \"\"),\n    iif(LastExtensionUploadStatus !~ \"OK\", \"Upload status not OK; \", \"\"),\n    iif(ExtensionProvisioningState !~ \"Succeeded\", strcat(\"Extension provisioning state is \", ExtensionProvisioningState, \"; \"), \"\")\n)\n| extend RecommendedAction = case(\n    MachineStatus =~ \"Disconnected\", \"Reconnect the Azure Arc machine and validate agent connectivity.\",\n    MachineStatus =~ \"Expired\", \"Renew or repair the Azure Arc machine certificate and reconnect the machine.\",\n    MachineProvisioningStatus !~ \"Succeeded\", \"Validate Azure Arc machine provisioning state.\",\n    isnotempty(MachineErrors) and MachineErrors != \"[]\", \"Review and resolve errors reported by the Azure Arc machine.\",\n    ExtensionProvisioningState !~ \"Succeeded\", \"Validate SQL extension provisioning state.\",\n    LastExtensionUploadStatus !~ \"OK\", \"Review SQL extension status message, DPS connectivity and extension logs.\",\n    LastUploadOutsideAcceptableRange, \"Validate whether the extension is still uploading inventory and billing data.\",\n    LastReportedExtensionHealth !~ \"Healthy\", \"Review SQL extension status message and failure reasons.\",\n    \"No immediate action from this workbook signal.\"\n)\n| project MachineName, MachineStatus, HealthState, LastReportedExtensionHealth, LastExtensionUploadStatus, LastExtensionUploadTimestamp, LicenseType, ExtensionProvisioningState, RecommendedAction, FailureReasons, SubscriptionID = subscriptionId, ResourceGroup = resourceGroup, ExtensionResourceID, MachineId\n| order by HealthState desc, MachineName asc\n| summarize Value = countif(LastExtensionUploadStatus != \"OK\")\n| extend Metric = \"DPS upload com atenção\", Detail = \"UploadStatus diferente de OK\"\n| project Metric, Value, Detail",
              "size": 1,
              "title": "DPS upload com atenção",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "tiles",
              "tileSettings": {
                "showBorder": false,
                "titleContent": {
                  "columnMatch": "Metric"
                },
                "leftContent": {
                  "columnMatch": "Value",
                  "formatter": 12
                },
                "secondaryContent": {
                  "columnMatch": "Detail"
                }
              }
            },
            "customWidth": "25",
            "name": "op_dps_attention"
          },
          {
            "type": 1,
            "content": {
              "json": "> **Como ler o gráfico ao lado:** cada extensão \"com atenção\" é classificada pelo primeiro motivo aplicável, em ordem conservadora: máquina expirada/desconectada, provisioning ou erros da máquina, provisioning da extensão, saúde do agente, upload não OK e timestamp ausente/antigo/futuro. Nenhuma dessas categorias deve ser interpretada como benigna sem verificar `FailureReasons`, `RecommendedAction` e a mensagem da extensão."
            },
            "name": "op_attention_reasons_note",
            "customWidth": "50"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type =~ \"microsoft.hybridcompute/machines/extensions\"\n| where resourceGroup in~ ({ResourceGroup})\n| where tostring(properties.publisher) =~ \"Microsoft.AzureData\"\n| where tostring(properties.type) in (\"WindowsAgent.SqlServer\",\"LinuxAgent.SqlServer\")\n| extend HostId = tolower(substring(id, 0, indexof(id, \"/extensions\")))\n| join kind=inner (\n    resources\n    | where type =~ \"microsoft.azurearcdata/sqlserverinstances\"\n    | where resourceGroup in~ ({ResourceGroup})\n    | extend HostId = tolower(tostring(properties.containerResourceId))\n    | distinct HostId\n) on HostId\n| extend targetMachineName = tolower(tostring(split(id, \"/\")[8]))\n| extend ExtensionProvisioningState = tostring(properties.provisioningState)\n| extend Message = tostring(properties.instanceView.status.message)\n| extend LastReportedExtensionHealth = iff(Message contains \"SQL Server Extension Agent: Healthy\", \"Healthy\", \"Unhealthy\")\n| extend LastExtensionUploadStatus = iff(Message contains \"uploadStatus : OK\" or Message contains \"uploadStatus: OK\" or Message contains \"uploadStatus:OK\", \"OK\", \"Unhealthy\")\n| extend LastExtensionUploadTimestamp = coalesce(extract(\"timestampUTC : ([0-9]{4}[/-][0-9]{2}[/-][0-9]{2})\", 1, Message), extract(\"timestampUTC: ([0-9]{4}[/-][0-9]{2}[/-][0-9]{2})\", 1, Message))\n| extend LastExtensionUploadDate = todatetime(strcat(replace_string(LastExtensionUploadTimestamp, \"/\", \"-\"), \"T00:00:00Z\"))\n| extend LastUploadOutsideAcceptableRange = isnull(LastExtensionUploadDate) or LastExtensionUploadDate < startofday(ago(3d)) or LastExtensionUploadDate > startofday(now())\n| join kind=leftouter (\n    resources\n    | where type =~ \"microsoft.hybridcompute/machines\"\n    | where resourceGroup in~ ({ResourceGroup})\n    | extend LowerMachineName = tolower(tostring(name))\n    | project LowerMachineName, MachineStatus = tostring(properties.status), MachineProvisioningStatus = tostring(properties.provisioningState), MachineErrors = tostring(properties.errorDetails), subscriptionId, resourceGroup\n) on $left.targetMachineName == $right.LowerMachineName, subscriptionId, resourceGroup\n| extend IsHealthy = MachineStatus =~ \"Connected\" and MachineProvisioningStatus =~ \"Succeeded\" and (isempty(MachineErrors) or MachineErrors == \"[]\") and ExtensionProvisioningState =~ \"Succeeded\" and LastReportedExtensionHealth =~ \"Healthy\" and LastExtensionUploadStatus =~ \"OK\" and LastUploadOutsideAcceptableRange == false\n| where IsHealthy == false\n| extend Motivo = case(MachineStatus =~ \"Expired\", \"Máquina expirada\", MachineStatus =~ \"Disconnected\", \"Máquina desconectada\", MachineStatus !~ \"Connected\", \"Máquina indisponível\", MachineProvisioningStatus !~ \"Succeeded\", \"Provisionamento da máquina\", isnotempty(MachineErrors) and MachineErrors != \"[]\", \"Erros da máquina\", ExtensionProvisioningState !~ \"Succeeded\", \"Provisionamento da extensão\", LastReportedExtensionHealth !~ \"Healthy\", \"Extensão unhealthy\", LastExtensionUploadStatus !~ \"OK\", \"Upload status não OK\", LastUploadOutsideAcceptableRange, \"Upload ausente, atrasado ou futuro\", \"Sinal de saúde incompleto\")\n| summarize Extensoes = count() by Motivo\n| order by Extensoes desc",
              "size": 1,
              "title": "🪧 Motivos das extensões com atenção",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "piechart",
              "chartSettings": {
                "createOtherGroup": 0,
                "showLegend": true,
                "labelColumn": "Motivo",
                "valueColumn": "Extensoes"
              }
            },
            "customWidth": "50",
            "name": "op_attention_reasons"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type =~ \"microsoft.hybridcompute/machines/extensions\"\n| where resourceGroup in~ ({ResourceGroup})\n| where tostring(properties.publisher) =~ \"Microsoft.AzureData\"\n| where tostring(properties.type) in (\"WindowsAgent.SqlServer\",\"LinuxAgent.SqlServer\")\n| extend HostId = tolower(substring(id, 0, indexof(id, \"/extensions\")))\n| join kind=inner (\n    resources\n    | where type =~ \"microsoft.azurearcdata/sqlserverinstances\"\n    | where resourceGroup in~ ({ResourceGroup})\n    | extend HostId = tolower(tostring(properties.containerResourceId))\n    | distinct HostId\n) on HostId\n| extend ExtensionResourceID = tostring(id)\n| extend targetMachineName = tolower(tostring(split(id, \"/\")[8]))\n| extend ExtensionProvisioningState = tostring(properties.provisioningState)\n| extend LicenseType = tostring(properties.settings.LicenseType)\n| extend Message = tostring(properties.instanceView.status.message)\n| extend LastReportedExtensionHealth = iff(Message contains \"SQL Server Extension Agent: Healthy\", \"Healthy\", \"Unhealthy\")\n| extend LastExtensionUploadStatus = iff(Message contains \"uploadStatus : OK\" or Message contains \"uploadStatus: OK\" or Message contains \"uploadStatus:OK\", \"OK\", \"Unhealthy\")\n| extend LastExtensionUploadTimestamp = coalesce(extract(\"timestampUTC : ([0-9]{4}[/-][0-9]{2}[/-][0-9]{2})\", 1, Message), extract(\"timestampUTC: ([0-9]{4}[/-][0-9]{2}[/-][0-9]{2})\", 1, Message))\n| extend LastExtensionUploadDate = todatetime(strcat(replace_string(LastExtensionUploadTimestamp, \"/\", \"-\"), \"T00:00:00Z\"))\n| extend LastUploadOutsideAcceptableRange = isnull(LastExtensionUploadDate) or LastExtensionUploadDate < startofday(ago(3d)) or LastExtensionUploadDate > startofday(now())\n| join kind=leftouter (\n    resources\n    | where type =~ \"microsoft.hybridcompute/machines\"\n    | where resourceGroup in~ ({ResourceGroup})\n    | extend LowerMachineName = tolower(tostring(name))\n    | project MachineId = tostring(id), MachineName = tostring(name), LowerMachineName, MachineStatus = tostring(properties.status), MachineProvisioningStatus = tostring(properties.provisioningState), MachineErrors = tostring(properties.errorDetails), subscriptionId, resourceGroup, TenantID = tenantId\n) on $left.targetMachineName == $right.LowerMachineName, subscriptionId, resourceGroup\n| extend IsHealthy = MachineStatus =~ \"Connected\" and MachineProvisioningStatus =~ \"Succeeded\" and (isempty(MachineErrors) or MachineErrors == \"[]\") and ExtensionProvisioningState =~ \"Succeeded\" and LastReportedExtensionHealth =~ \"Healthy\" and LastExtensionUploadStatus =~ \"OK\" and LastUploadOutsideAcceptableRange == false\n| extend HealthState = iff(IsHealthy, \"Healthy\", \"Needs attention\")\n| extend FailureReasons = strcat(\n    iif(MachineStatus !~ \"Connected\", strcat(\"Machine status is \", MachineStatus, \"; \"), \"\"),\n    iif(MachineProvisioningStatus !~ \"Succeeded\", strcat(\"Machine provisioning state is \", MachineProvisioningStatus, \"; \"), \"\"),\n    iif(isnotempty(MachineErrors) and MachineErrors != \"[]\", \"Machine reports errors; \", \"\"),\n    iif(LastReportedExtensionHealth !~ \"Healthy\", \"Extension reported unhealthy; \", \"\"),\n    iif(LastUploadOutsideAcceptableRange, \"Last upload outside acceptable range; \", \"\"),\n    iif(LastExtensionUploadStatus !~ \"OK\", \"Upload status not OK; \", \"\"),\n    iif(ExtensionProvisioningState !~ \"Succeeded\", strcat(\"Extension provisioning state is \", ExtensionProvisioningState, \"; \"), \"\")\n)\n| extend RecommendedAction = case(\n    MachineStatus =~ \"Disconnected\", \"Reconnect the Azure Arc machine and validate agent connectivity.\",\n    MachineStatus =~ \"Expired\", \"Renew or repair the Azure Arc machine certificate and reconnect the machine.\",\n    MachineProvisioningStatus !~ \"Succeeded\", \"Validate Azure Arc machine provisioning state.\",\n    isnotempty(MachineErrors) and MachineErrors != \"[]\", \"Review and resolve errors reported by the Azure Arc machine.\",\n    ExtensionProvisioningState !~ \"Succeeded\", \"Validate SQL extension provisioning state.\",\n    LastExtensionUploadStatus !~ \"OK\", \"Review SQL extension status message, DPS connectivity and extension logs.\",\n    LastUploadOutsideAcceptableRange, \"Validate whether the extension is still uploading inventory and billing data.\",\n    LastReportedExtensionHealth !~ \"Healthy\", \"Review SQL extension status message and failure reasons.\",\n    \"No immediate action from this workbook signal.\"\n)\n| project MachineName, MachineStatus, HealthState, LastReportedExtensionHealth, LastExtensionUploadStatus, LastExtensionUploadTimestamp, LicenseType, ExtensionProvisioningState, RecommendedAction, FailureReasons, SubscriptionID = subscriptionId, ResourceGroup = resourceGroup, ExtensionResourceID, MachineId\n| order by HealthState desc, MachineName asc",
              "size": 0,
              "title": "Detalhe de confiança e telemetria da extensão SQL",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "table",
