ake_set(SQLVersionMajor, 20), instancias=count(), vCoreInstanciaTotal=sum(sqlVcores) by hostId\n) on hostId\n| extend topEdition = case(topRank == 6, \"Enterprise\", topRank == 5, \"Standard\", topRank == 4, \"Web\", topRank == 3, \"Express\", topRank == 2, \"Developer\", topRank == 1, \"Evaluation\", \"Sem instância\")\n| extend ed3 = case(topEdition == \"Enterprise\", \"Ent\", topEdition == \"Standard\", \"Std\", topEdition == \"Web\", \"Web\", topEdition == \"Express\", \"Exp\", topEdition)\n| extend isFreeEdition = topEdition in (\"Developer\", \"Evaluation\", \"Express\")\n| extend isPassivo = (topRank > 0 and ativos == 0)\n| extend hasSQLServerESUVersion = qtdSQLServerESU > 0\n| extend coresDetectados = iff(isVM, logicalCores, physicalCores)\n| extend coresHostBase = iff(coalesce(coresDetectados, 0) < 4, 4, coresDetectados)\n| extend coresHost = iff(topEdition == \"Standard\" and coresHostBase > 24, 24, coresHostBase)\n| extend CoresConsideradosAnalise = case(topEdition == \"Sem instância\", 0, isFreeEdition, 0, isPassivo and licenseTypeRaw in (\"Paid\", \"PAYG\"), 0, isempty(licenseTypeRaw), 0, coresHost)\n| extend coresPAYG = iff(CoresConsideradosAnalise > 0 and licenseTypeRaw == \"PAYG\", coresHost, 0)\n| extend coresPaid = iff(CoresConsideradosAnalise > 0 and licenseTypeRaw == \"Paid\", coresHost, 0)\n| extend coresLicenseOnlyComAnalise = iff(CoresConsideradosAnalise > 0 and licenseTypeRaw == \"LicenseOnly\", coresHost, 0)\n| extend coresNaoConsiderados = case(isFreeEdition, coresHost, isPassivo and licenseTypeRaw in (\"Paid\", \"PAYG\"), coresHost, 0)\n| summarize Hosts=count_distinct(hostId), Instancias=sum(instancias), vCoreInstancia=sum(vCoreInstanciaTotal), CoresConsideradosAnalise=sum(CoresConsideradosAnalise) by EdicaoSQL=topEdition\n| order by CoresConsideradosAnalise desc, Hosts desc",
