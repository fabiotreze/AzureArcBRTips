          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type =~ \"microsoft.azurearcdata/sqlserverinstances\"\n| where resourceGroup in~ ({ResourceGroup})\n| extend HostId = tolower(tostring(properties.containerResourceId))\n| join kind=leftouter (\n    resources\n    | where type =~ \"microsoft.hybridcompute/machines\"\n    | extend HostId = tolower(id)\n    | project HostId, MachineName = name\n) on HostId\n| where isempty(MachineName)\n| summarize Value = count()\n| extend Metric = \"Instâncias SQL órfãs\", Detail = \"sqlserverinstances sem máquina Arc correspondente\"\n| project Metric, Value, Detail",
