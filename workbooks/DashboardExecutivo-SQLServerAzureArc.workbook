          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type == \"microsoft.hybridcompute/machines/extensions\"\n| where properties.publisher =~ \"Microsoft.AzureData\"\n| where tostring(properties.type) in (\"WindowsAgent.SqlServer\", \"LinuxAgent.SqlServer\")\n| extend hostId = tolower(substring(id, 0, indexof(id, \"/extensions\")))\n| extend licenseTypeRaw = tostring(properties.settings.LicenseType)\n| extend esuRaw = tostring(properties.settings.enableExtendedSecurityUpdates)\n| extend extState = tostring(properties.provisioningState)\n| where resourceGroup in~ ({ResourceGroup})\n| project hostId, licenseTypeRaw, esuRaw, extState\n| join kind=inner (\n    resources\n    | where type == \"microsoft.hybridcompute/machines\"\n    | extend hostId = tolower(id)\n    | extend logicalCores = toint(properties.detectedProperties.logicalCoreCount)\n    | extend physicalCores = toint(properties.detectedProperties.coreCount)\n    | extend manufacturer = tostring(properties.detectedProperties.manufacturer)\n    | extend model = tostring(properties.detectedProperties.model)\n    | extend VMbyManufacturer = manufacturer contains_cs \"VMware\" or manufacturer contains_cs \"QEMU\" or manufacturer contains_cs \"Amazon EC2\" or manufacturer contains_cs \"OpenStack\" or manufacturer contains_cs \"Hetzner\" or manufacturer contains_cs \"Mission Critical Cloud\" or manufacturer contains_cs \"DigitalOcean\" or manufacturer contains_cs \"UpCloud\" or manufacturer contains_cs \"oVirt\" or manufacturer contains_cs \"Alibaba\" or manufacturer contains_cs \"KubeVirt\" or manufacturer contains_cs \"Parallels\" or manufacturer contains_cs \"Bochs\" or manufacturer contains_cs \"XEN\"\n    | extend VMbyModel = model contains_cs \"OpenStack\" or model contains_cs \"Droplet\" or model contains_cs \"oVirt\" or model contains_cs \"Hypervisor\" or model contains_cs \"Virtual\" or model contains_cs \"BHYVE\" or model contains_cs \"KVM\"\n    | extend GoogleVM = manufacturer contains_cs \"Google\" and model contains_cs \"Google Compute Engine\"\n    | extend NutanixVM = manufacturer contains_cs \"Nutanix\" and model contains_cs \"AHV\"\n    | extend MicrosoftVM = manufacturer contains_cs \"Microsoft Corporation\" and model contains_cs \"Virtual Machine\"\n    | extend isVM = VMbyManufacturer or VMbyModel or GoogleVM or NutanixVM or MicrosoftVM\n    | project hostId, machineName = name, logicalCores, physicalCores, manufacturer, model, isVM, arcStatus = tostring(properties.status)\n) on hostId\n| join kind=leftouter (\n    resources\n    | where type == \"microsoft.azurearcdata/sqlserverinstances\"\n    | where resourceGroup in~ ({ResourceGroup})\n    | extend hostId = tolower(tostring(properties.containerResourceId))\n    | extend edition = tostring(properties.edition)\n    | extend instLicType = tostring(properties.licenseType)\n    | extend sqlVersion = tostring(properties.version)\n    | extend sqlVcores = toint(properties.vCore)\n    | extend SQLVersionMajor = case(sqlVersion has \"SQL Server 2014\" or sqlVersion startswith \"12.\", \"SQL Server 2014\", sqlVersion has \"SQL Server 2016\" or sqlVersion startswith \"13.\", \"SQL Server 2016\", sqlVersion has \"SQL Server 2017\" or sqlVersion startswith \"14.\", \"SQL Server 2017\", sqlVersion has \"SQL Server 2019\" or sqlVersion startswith \"15.\", \"SQL Server 2019\", sqlVersion has \"SQL Server 2022\" or sqlVersion startswith \"16.\", \"SQL Server 2022\", sqlVersion has \"SQL Server 2025\" or sqlVersion startswith \"17.\", \"SQL Server 2025\", isnotempty(sqlVersion), sqlVersion, \"Não identificado\")\n    | extend isSQLServerESUVersion = SQLVersionMajor in (\"SQL Server 2014\", \"SQL Server 2016\")\n    | extend editionRank = case(edition has \"Enterprise\", 6, edition has \"Standard\", 5, edition has \"Web\", 4, edition has \"Express\", 3, edition has \"Developer\", 2, edition has \"Evaluation\", 1, 0)\n    | summarize topRank = max(editionRank), ativos = countif(instLicType !~ \"HADR\"), qtdSQLServerESU = countif(isSQLServerESUVersion), versoesSQL = make_set(SQLVersionMajor, 20), instancias=count(), vCoreInstanciaTotal=sum(sqlVcores) by hostId\n) on hostId\n| extend topEdition = case(topRank == 6, \"Enterprise\", topRank == 5, \"Standard\", topRank == 4, \"Web\", topRank == 3, \"Express\", topRank == 2, \"Developer\", topRank == 1, \"Evaluation\", \"Sem instância\")\n| extend ed3 = case(topEdition == \"Enterprise\", \"Ent\", topEdition == \"Standard\", \"Std\", topEdition == \"Web\", \"Web\", topEdition == \"Express\", \"Exp\", topEdition)\n| extend isFreeEdition = topEdition in (\"Developer\", \"Evaluation\", \"Express\")\n| extend isPassivo = (topRank > 0 and ativos == 0)\n| extend hasSQLServerESUVersion = qtdSQLServerESU > 0\n| extend coresDetectados = iff(isVM, logicalCores, physicalCores)\n| extend coresHostBase = iff(coalesce(coresDetectados, 0) < 4, 4, coresDetectados)\n| extend coresHost = iff(topEdition == \"Standard\" and coresHostBase > 24, 24, coresHostBase)\n| extend CoresConsideradosAnalise = case(topEdition == \"Sem instância\", 0, isFreeEdition, 0, isPassivo and licenseTypeRaw in (\"Paid\", \"PAYG\"), 0, isempty(licenseTypeRaw), 0, coresHost)\n| extend coresPAYG = iff(CoresConsideradosAnalise > 0 and licenseTypeRaw == \"PAYG\", coresHost, 0)\n| extend coresPaid = iff(CoresConsideradosAnalise > 0 and licenseTypeRaw == \"Paid\", coresHost, 0)\n| extend coresLicenseOnlyComAnalise = iff(CoresConsideradosAnalise > 0 and licenseTypeRaw == \"LicenseOnly\", coresHost, 0)\n| extend coresNaoConsiderados = case(isFreeEdition, coresHost, isPassivo and licenseTypeRaw in (\"Paid\", \"PAYG\"), coresHost, 0)\n| extend LicenseType = iff(isempty(licenseTypeRaw), \"Pendente\", licenseTypeRaw)\n| summarize Hosts=count_distinct(hostId), Instancias=sum(instancias), Edicoes=make_set(topEdition, 20), vCoreInstancia=sum(vCoreInstanciaTotal), CoresConsideradosAnalise=sum(CoresConsideradosAnalise) by LicenseType\n| order by Hosts desc",
              "size": 0,
