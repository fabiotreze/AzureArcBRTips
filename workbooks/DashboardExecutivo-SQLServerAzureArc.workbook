          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type =~ \"microsoft.azurearcdata/sqlserverinstances\"\n| where resourceGroup in~ ({ResourceGroup})\n| extend hostId = tolower(tostring(properties.containerResourceId))\n| join kind=inner (resources | where type =~ \"microsoft.hybridcompute/machines\" | extend hostId = tolower(id) | distinct hostId) on hostId\n| extend sqlVersion = tostring(properties.version)\n| extend SQLVersionMajor = case(sqlVersion has \"SQL Server 2014\" or sqlVersion startswith \"12.\", \"SQL Server 2014\", sqlVersion has \"SQL Server 2016\" or sqlVersion startswith \"13.\", \"SQL Server 2016\", sqlVersion has \"SQL Server 2017\" or sqlVersion startswith \"14.\", \"SQL Server 2017\", sqlVersion has \"SQL Server 2019\" or sqlVersion startswith \"15.\", \"SQL Server 2019\", sqlVersion has \"SQL Server 2022\" or sqlVersion startswith \"16.\", \"SQL Server 2022\", sqlVersion has \"SQL Server 2025\" or sqlVersion startswith \"17.\", \"SQL Server 2025\", isnotempty(sqlVersion), sqlVersion, \"Não identificado\")\n| summarize Instancias=count(), Hosts=count_distinct(hostId) by SQLVersionMajor\n| join kind=leftouter (\n    resources\n    | where type =~ \"microsoft.azurearcdata/sqlserverinstances\"\n    | where resourceGroup in~ ({ResourceGroup})\n    | extend hostId = tolower(tostring(properties.containerResourceId))\n    | join kind=inner (resources | where type =~ \"microsoft.hybridcompute/machines\" | extend hostId = tolower(id), MachineOSType = tostring(properties.osType) | where MachineOSType =~ \"windows\" | distinct hostId) on hostId\n    | extend sqlVersion = tostring(properties.version)\n    | extend sqlEdition = tostring(properties.edition)\n    | where sqlEdition in~ (\"Enterprise\", \"Standard\")\n    | extend SQLVersionMajor = case(sqlVersion has \"SQL Server 2014\" or sqlVersion startswith \"12.\", \"SQL Server 2014\", sqlVersion has \"SQL Server 2016\" or sqlVersion startswith \"13.\", \"SQL Server 2016\", \"Other\")\n    | where SQLVersionMajor in (\"SQL Server 2014\", \"SQL Server 2016\")\n    | summarize by SQLVersionMajor, hostId\n    | join kind=leftouter (\n        resources\n        | where type =~ \"microsoft.hybridcompute/machines/extensions\"\n        | where tostring(properties.publisher) =~ \"Microsoft.AzureData\"\n        | where tostring(properties.type) in (\"WindowsAgent.SqlServer\", \"LinuxAgent.SqlServer\")\n        | extend hostId = tolower(substring(id, 0, indexof(id, \"/extensions\")))\n        | extend esuRaw = tostring(properties.settings.enableExtendedSecurityUpdates)\n        | extend licenseTypeRaw = tostring(properties.settings.LicenseType)\n        | project hostId, esuRaw, licenseTypeRaw\n    ) on hostId\n    | where licenseTypeRaw in~ (\"Paid\", \"PAYG\")\n    | summarize HostsElegiveisESU=count_distinct(hostId), HostsESUHabilitado=count_distinctif(hostId, esuRaw =~ \"true\"), HostsESUNaoHabilitado=count_distinctif(hostId, esuRaw !~ \"true\" or isempty(esuRaw)) by SQLVersionMajor\n) on SQLVersionMajor\n| extend AplicabilidadeESU = iff(SQLVersionMajor in (\"SQL Server 2014\", \"SQL Server 2016\"), \"Avaliada para Windows Enterprise/Standard\", \"Não aplicável\")\n| project SQLVersionMajor, Instancias, Hosts, AplicabilidadeESU, HostsElegiveisESU=coalesce(HostsElegiveisESU,0), HostsESUHabilitado=coalesce(HostsESUHabilitado,0), HostsESUNaoHabilitado=coalesce(HostsESUNaoHabilitado,0)\n| order by SQLVersionMajor asc",
              "size": 0,
              "title": "🛡️ Prontidão para SQL Server ESU (Windows Enterprise/Standard)",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
