      "name": "metrics_group",
      "conditionalVisibility": {
        "parameterName": "SelectedTab",
        "comparison": "isEqualTo",
        "value": "VisaoGeral"
      }
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type == \"microsoft.azurearcdata/sqlserverinstances\"\n| where resourceGroup in~ ({ResourceGroup})\n| extend hostId = tolower(tostring(properties.containerResourceId))\n| extend edition = tostring(properties.edition)\n| extend editionRank = case(edition has \"Enterprise\", 6, edition has \"Standard\", 5, edition has \"Web\", 4, edition has \"Express\", 3, edition has \"Developer\", 2, edition has \"Evaluation\", 1, 0)\n| summarize topRank = max(editionRank) by hostId\n| extend EdicaoHost = case(topRank == 6, \"Enterprise\", topRank == 5, \"Standard\", topRank == 4, \"Web\", topRank == 3, \"Express\", topRank == 2, \"Developer\", topRank == 1, \"Evaluation\", \"Não identificado\")\n| summarize HostsEnterprise = dcountif(hostId, EdicaoHost == \"Enterprise\")",
              "size": 4,
              "title": "🏢 Hosts Enterprise",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
