            "name": "WorkbookVersion",
            "label": "Versão interna do workbook",
            "type": 1,
            "value": "v2.9.2",
            "defaultValue": "v2.9.2",
            "isHiddenWhenLocked": true
          }
        ],
        "style": "pills"
      },
      "name": "workbook_version_internal",
      "conditionalVisibility": {
        "parameterName": "SelectedTab",
        "comparison": "isEqualTo",
        "value": "Changelog"
      }
    }
  ],
