      "name": "trueup_kpis_group"
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type == \"microsoft.hybridcompute/machines/extensions\"\n| where properties.publisher =~ \"Microsoft.AzureData\"\n| where tostring(properties.type) in (\"WindowsAgent.SqlServer\", \"LinuxAgent.SqlServer\")\n| extend hostId = tolower(substring(id, 0, indexof(id, \"/extensions\")))\n| extend licenseTypeRaw = tostring(properties.settings.LicenseType)\n| extend esuRaw = tostring(properties.settings.enableExtendedSecurityUpdates)\n| extend pcoreRaw = tostring(properties.settings.UsePhysicalCoreLicense.IsApplied)\n| extend extState = tostring(properties.provisioningState)\n| where resourceGroup in~ ({ResourceGroup})\n| project hostId, licenseTypeRaw, esuRaw, pcoreRaw, extState\n| join kind=inner (\n    resources\n    | where type == \"microsoft.hybridcompute/machines\"\n    | extend hostId = tolower(id)\n    | extend logicalCores = toint(properties.detectedProperties.logicalCoreCount)\n    | extend physicalCores = toint(properties.detectedProperties.coreCount)\n    | project hostId, machineName = name, osName = tostring(properties.osName), logicalCores, physicalCores\n) on hostId\n| join kind=leftouter (\n    resources\n    | where type == \"microsoft.azurearcdata/sqlserverinstances\"\n    | extend hostId = tolower(tostring(properties.containerResourceId))\n    | extend edition = tostring(properties.edition)\n    | extend instLicType = tostring(properties.licenseType)\n    | extend editionRank = case(edition has \"Enterprise\", 6, edition has \"Standard\", 5, edition has \"Web\", 4, edition has \"Express\", 3, edition has \"Developer\", 2, edition has \"Evaluation\", 1, 0)\n    | summarize topRank = max(editionRank), ativos = countif(instLicType !~ \"HADR\") by hostId\n) on hostId\n| extend topEdition = case(topRank == 6, \"Enterprise\", topRank == 5, \"Standard\", topRank == 4, \"Web\", topRank == 3, \"Express\", topRank == 2, \"Developer\", topRank == 1, \"Evaluation\", \"Sem instância\")\n| extend ed3 = case(topEdition == \"Enterprise\", \"Ent\", topEdition == \"Standard\", \"Std\", topEdition == \"Web\", \"Web\", topEdition == \"Express\", \"Exp\", topEdition)\n| extend isPassivo = (topRank > 0 and ativos == 0)\n| extend coresDetectados = coalesce(logicalCores, physicalCores, 0)\n| extend coresHost = iff(coresDetectados < 4, 4, coresDetectados)\n| extend meterSku = case(topEdition == \"Sem instância\", \"Aguardando inventário SQL\", topEdition in (\"Developer\", \"Evaluation\"), strcat(topEdition, \" edition — R$ 0\"), topEdition == \"Express\", \"Express edition — R$ 0\", isPassivo and licenseTypeRaw in (\"Paid\", \"PAYG\"), strcat(ed3, \" edition - DR replica — R$ 0\"), isempty(licenseTypeRaw), \"Configuração pendente\", pcoreRaw =~ \"true\", strcat(ed3, \" edition - Virtual license\"), licenseTypeRaw == \"PAYG\", strcat(ed3, \" edition - PAYG\"), licenseTypeRaw == \"Paid\", strcat(ed3, \" edition - AHB\"), licenseTypeRaw == \"LicenseOnly\", strcat(ed3, \" edition - License only\"), \"—\")\n| extend coresCobravels = case(topEdition == \"Sem instância\", 0, topEdition in (\"Developer\", \"Evaluation\", \"Express\"), 0, isPassivo and licenseTypeRaw in (\"Paid\", \"PAYG\"), 0, isempty(licenseTypeRaw), 0, coresHost)\n| extend Tipo = iff(osName =~ \"windows\", \"Windows\", \"Linux\")\n| extend isPassivoIsento = (isPassivo and licenseTypeRaw in (\"Paid\", \"PAYG\"))\n| extend Estado = case(topEdition == \"Sem instância\", \"Sem instância\", isPassivoIsento, \"🔁 Passivo isento (R$ 0)\", isPassivo, \"🔁 Passivo cobrável (sem AHB)\", \"Ativo\")\n| extend ESU = case(esuRaw =~ \"true\", \"✅\", licenseTypeRaw in (\"Paid\", \"PAYG\"), \"❌\", \"🚫\")\n| extend PCore = iff(pcoreRaw =~ \"true\", \"✅ p-core\", \"v-core\")\n| extend Extensao = case(extState =~ \"Succeeded\", \"✅ OK\", extState =~ \"Failed\", \"❌ Falha\", isempty(extState), \"—\", strcat(\"⏳ \", extState))\n| extend FaturaAzure = case(topEdition == \"Sem instância\", \"—\", isempty(licenseTypeRaw), \"⏳ pendente\", coresCobravels > 0 and licenseTypeRaw == \"PAYG\", \"💰 PAYG — Azure cobra\", coresCobravels > 0 and licenseTypeRaw == \"Paid\", \"🏦 AHB — R$ 0 (SA própria)\", coresCobravels > 0 and licenseTypeRaw == \"LicenseOnly\", \"⚠️ LicenseOnly — R$ 0 (sem SA)\", \"R$ 0 (isento)\")\n| project Host = machineName, Tipo, Edicao = topEdition, Extensao, LicenseType = iff(isempty(licenseTypeRaw), \"pendente\", licenseTypeRaw), Estado, FaturaAzure, MeterSKU = meterSku, CoresLicenca = coresCobravels, CoresHost = coresHost, ESU, PCore\n| order by CoresLicenca desc, Host asc",
              "size": 0,
              "title": "🧾 Posição de Licenciamento SQL Server por Host (OSE)",
              "noDataMessage": "Nenhum host SQL Server (Azure Arc) com extensão Microsoft.AzureData no escopo selecionado.",
              "noDataMessageStyle": 3,
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "table",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "Extensao",
                    "formatter": 18,
                    "formatOptions": {
                      "thresholdsOptions": "colors",
                      "thresholdsGrid": [
                        {
                          "operator": "contains",
                          "thresholdValue": "OK",
                          "representation": "green",
                          "text": "{0}{1}"
                        },
                        {
                          "operator": "contains",
                          "thresholdValue": "Falha",
                          "representation": "red",
                          "text": "{0}{1}"
                        },
                        {
                          "operator": "Default",
                          "thresholdValue": null,
                          "representation": "yellow",
                          "text": "{0}{1}"
                        }
                      ]
                    }
                  },
                  {
                    "columnMatch": "Estado",
                    "formatter": 18,
                    "formatOptions": {
                      "thresholdsOptions": "colors",
                      "thresholdsGrid": [
                        {
                          "operator": "contains",
                          "thresholdValue": "isento",
                          "representation": "green",
                          "text": "{0}{1}"
                        },
                        {
                          "operator": "contains",
                          "thresholdValue": "cobrável",
                          "representation": "orange",
                          "text": "{0}{1}"
                        },
                        {
                          "operator": "contains",
                          "thresholdValue": "Ativo",
                          "representation": "red",
                          "text": "{0}{1}"
                        },
                        {
                          "operator": "Default",
                          "thresholdValue": null,
                          "representation": "gray",
                          "text": "{0}{1}"
                        }
                      ]
                    }
                  },
                  {
                    "columnMatch": "FaturaAzure",
                    "formatter": 18,
                    "formatOptions": {
                      "thresholdsOptions": "colors",
                      "thresholdsGrid": [
                        {
                          "operator": "contains",
                          "thresholdValue": "PAYG",
                          "representation": "red",
                          "text": "{0}{1}"
                        },
                        {
                          "operator": "contains",
                          "thresholdValue": "AHB",
                          "representation": "blue",
                          "text": "{0}{1}"
                        },
                        {
                          "operator": "contains",
                          "thresholdValue": "LicenseOnly",
                          "representation": "orange",
                          "text": "{0}{1}"
                        },
                        {
                          "operator": "contains",
                          "thresholdValue": "isento",
                          "representation": "green",
                          "text": "{0}{1}"
                        },
                        {
                          "operator": "Default",
                          "thresholdValue": null,
                          "representation": "gray",
                          "text": "{0}{1}"
                        }
                      ]
                    }
                  },
                  {
                    "columnMatch": "CoresLicenca",
                    "formatter": 8,
                    "formatOptions": {
                      "palette": "red"
                    }
                  },
                  {
                    "columnMatch": "CoresHost",
                    "formatter": 8,
                    "formatOptions": {
                      "palette": "blue"
                    }
                  }
                ],
                "filter": true
              },
              "sortBy": []
            },
            "customWidth": "70",
            "name": "trueup_table"
          },
          {
            "type": 1,
            "content": {
              "json": "### 🧾 Como ler a Posição de Licenciamento\n\n**Host (OSE)** = a base é o **servidor** (VM/físico), **não** a instância. A tabela mostra **onde cai a cobrança** e quantos cores exigem licença — base do **true-up** (EA) e da auditoria.\n\n#### 💰 Fatura do Azure × Licença que você possui\n| LicenseType | Fatura do Azure | Sua obrigação |\n| --- | --- | --- |\n| **PAYG** | 💰 **cobra** por hora/core | nada a possuir |\n| **Paid (AHB/SA)** | **R$ 0** | possuir licenças core **com SA** |\n| **LicenseOnly** | **R$ 0** | perpétua **sem** SA (sem DR grátis/ESU) |\n| Dev/Eval/Express · Passivo (Paid/PAYG) | **R$ 0** | isento |\n\n> ⚠️ **Só PAYG gera custo na fatura do Azure.** AHB e LicenseOnly custam **R$ 0** no Azure — o custo real é a licença que você já possui (paga no EA/LSP).\n\n#### ⚙️ Regras de cálculo\n| Regra | Detalhe |\n| --- | --- |\n| Por host | 1× por servidor, pela **edição mais cara** |\n| Cores | `logicalCoreCount` (VM) ou `coreCount` (físico), **mín. 4** |\n| Passivo HA/DR | **R$ 0 só se** host for **Paid/PAYG** |\n| Dev/Eval/Express | sempre **R$ 0** |\n| p-core (UV) | meter *Virtual license* |\n\n#### 🔁 Por que um nó HA/DR pode ser cobrado?\nO medidor **DR replica (R$ 0)** exige **Software Assurance/Subscrição** — ou seja, LicenseType **Paid** ou **PAYG**. Um secundário passivo com **LicenseOnly** (ou pendente) **não** tem direito ao benefício → entra como **cobrável**.\n\n| Estado | Significado |\n| --- | --- |\n| 🔁 **Passivo isento (R$ 0)** | passivo **e** Paid/PAYG |\n| 🔁 **Passivo cobrável (sem AHB)** | passivo, mas **LicenseOnly/pendente** |\n| **Ativo** | nó primário/ativo → cobrável |\n\n> **Ex.: `sqlnode2`** é HA/DR passivo, mas está **LicenseOnly** → aparece **cobrável**. Defina **Paid** (com SA) ou **PAYG** para torná-lo **R$ 0**.\n\n#### 💰 Meter SKU projetado\n| Edição + Licença | Meter |\n| --- | --- |\n| Ent/Std + PAYG | `… - PAYG` |\n| Ent/Std + Paid (SA/AHB) | `… - AHB` |\n| Ent/Std + LicenseOnly | `… - License only` |\n| p-core (UV) | `… - Virtual license` |\n| Passivo (Paid/PAYG) | `… - DR replica` (R$ 0) |\n| Dev/Eval/Express | R$ 0 |\n\n#### 📋 Colunas da tabela\n| Coluna | Significado |\n| --- | --- |\n| **Host** | servidor (OSE), base do licenciamento |\n| **Tipo** | Windows · Linux (Linux não reporta passivo → conta como ativo) |\n| **Edicao** | edição SQL mais cara do host (Enterprise / Standard / Web / Express / Developer / Evaluation) |\n| **Extensao** | saúde da extensão `Microsoft.AzureData` (✅ OK · ❌ Falha · ⏳ em progresso) |\n| **LicenseType** | Paid (AHB/SA) · PAYG · LicenseOnly · pendente |\n| **Estado** | 🔁 Passivo isento (R$ 0) · 🔁 Passivo cobrável · Ativo |\n| **FaturaAzure** | 💰 PAYG (Azure cobra) · 🏦 AHB (R$ 0) · ⚠️ LicenseOnly (R$ 0) · R$ 0 (isento) |\n| **MeterSKU** | medidor projetado (ver tabela acima) |\n| **CoresLicenca** | cores que **exigem licença** (PAYG + AHB + LicenseOnly ativos) |\n| **CoresHost** | cores do host (mín. 4) |\n| **ESU** | ✅ habilitado · ❌ elegível sem ESU · 🚫 exige Paid/PAYG |\n| **PCore** | ✅ p-core (licença física / UV) · v-core |\n\n#### ⚠️ Avisos\n- **CoresLicenca ≠ fatura do Azure**: a fatura só vem de hosts **PAYG** (coluna **FaturaAzure** = 💰).\n- Depende da extensão `Microsoft.AzureData` **Succeeded** (coluna **Extensao**).\n- **Linux** não reporta passivo → conta como **ativo**.\n- Hosts com **LicenseType pendente/vazio** não entram em nenhum total (aguardam definição do tipo de licença).\n- Projeção **indicativa**: fatura real = medição horária (ACR) no **Cost Management**.\n\n*Fontes: aka.ms/sqlserverlicensing · learn.microsoft.com/sql/sql-server/azure-arc/manage-license-billing*"
            },
            "customWidth": "30",
            "name": "trueup_legend"
          }
        ]
      },
      "conditionalVisibility": {
        "parameterName": "SelectedTab",
        "comparison": "isEqualTo",
        "value": "Licenciamento"
      },
      "name": "trueup_detail_group"
    },
    {
      "type": 1,
      "content": {
        "json": "---\n## 📊 Distribuição de Capacidade Técnica\n**vCores alocados por edição SQL e por modelo de licença (visão técnica de capacidade — não-faturável)**"
      },
      "conditionalVisibility": {
        "parameterName": "SelectedTab",
        "comparison": "isEqualTo",
        "value": "Inventario"
      },
      "name": "distribution_header"
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type == \"microsoft.hybridcompute/machines\"\n| extend joinId = tolower(id)\n| join kind = leftouter (\n    resources\n    | where type == \"microsoft.azurearcdata/sqlserverinstances\"\n    | extend arcMachineId = tolower(tostring(properties.containerResourceId))\n    | extend sqlEdition = tostring(properties.edition)\n    | extend vCores = toint(properties.vCore)\n    | project arcMachineId, sqlEdition, sqlVcores = vCores\n)\non $left.joinId == $right.arcMachineId\n| where resourceGroup in~ ({ResourceGroup})\n| where isnotempty(sqlEdition)\n| summarize TotalVCores = sum(sqlVcores) by sqlEdition\n| order by TotalVCores desc",
              "size": 4,
              "title": "💻 Capacidade por Edição SQL",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "tiles",
              "tileSettings": {
                "titleContent": {
                  "columnMatch": "sqlEdition",
                  "formatter": 1
                },
                "leftContent": {
                  "columnMatch": "TotalVCores",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "blue"
                  }
                },
                "showBorder": true,
                "size": "small"
              }
            },
            "customWidth": "50",
            "name": "vcores_by_edition_tiles"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type == \"microsoft.hybridcompute/machines\"\n| extend joinId = tolower(id)\n| join kind = leftouter (\n    resources\n    | where type == \"microsoft.hybridcompute/machines/extensions\"\n    | where properties.publisher =~ \"Microsoft.AzureData\"\n    | where tostring(properties.type) in (\"WindowsAgent.SqlServer\", \"LinuxAgent.SqlServer\")\n    | extend extMachineId = tolower(substring(id, 0, indexof(id, \"/extensions\")))\n    | extend licenseTypeRaw = tostring(properties.settings.LicenseType)\n    | project extMachineId, licenseTypeRaw\n)\non $left.joinId == $right.extMachineId\n| where isnotempty(extMachineId)\n| join kind = leftouter (\n    resources\n    | where type == \"microsoft.azurearcdata/sqlserverinstances\"\n    | extend arcMachineId = tolower(tostring(properties.containerResourceId))\n    | extend vCores = toint(properties.vCore)\n    | project arcMachineId, sqlVcores = vCores\n)\non $left.joinId == $right.arcMachineId\n| extend LicenseType = case(\n    licenseTypeRaw == \"PAYG\", \"Pay-as-you-go (PAYG)\",\n    licenseTypeRaw == \"Paid\", \"Software Assurance (Paid)\",\n    licenseTypeRaw == \"LicenseOnly\", \"License Only\",\n    isempty(licenseTypeRaw), \"Configuração pendente\",\n    licenseTypeRaw)\n| where resourceGroup in~ ({ResourceGroup})\n| summarize TotalVCores = sum(sqlVcores) by LicenseType\n| order by TotalVCores desc",
              "size": 4,
              "title": "💳 Capacidade por Modelo de Licença",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "tiles",
              "tileSettings": {
                "titleContent": {
                  "columnMatch": "LicenseType",
                  "formatter": 1
                },
                "leftContent": {
                  "columnMatch": "TotalVCores",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "yellow"
                  }
                },
                "showBorder": true,
                "size": "small"
              }
            },
            "customWidth": "50",
            "name": "vcores_by_license_tiles"
          }
        ]
      },
      "conditionalVisibility": {
        "parameterName": "SelectedTab",
        "comparison": "isEqualTo",
        "value": "Inventario"
      },
      "name": "charts_group"
    },
    {
      "type": 1,
      "content": {
        "json": "---\n## 📈 Análise Visual de Compliance\n**Status operacional e distribuição de recursos críticos**"
      },
      "conditionalVisibility": {
        "parameterName": "SelectedTab",
        "comparison": "isEqualTo",
        "value": "VisaoGeral"
      },
      "name": "pie_charts_header"
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type == \"microsoft.hybridcompute/machines\"\n| extend status = case(\n    tolower(properties.status) == 'connected', 'Connected',\n    tolower(properties.status) == 'disconnected', 'Offline',\n    tolower(properties.status) == 'error', 'Error',\n    tolower(properties.status) == 'expired', 'Expired',\n    'Unknown'\n)\n| extend joinId = tolower(id)\n| join kind = leftouter (\n    resources\n    | where type == \"microsoft.azurearcdata/sqlserverinstances\"\n    | extend arcMachineId = tolower(tostring(properties.containerResourceId))\n    | extend sqlEdition = tostring(properties.edition)\n    | project arcMachineId, sqlEdition\n)\non $left.joinId == $right.arcMachineId\n| where isnotempty(sqlEdition)\n| where resourceGroup in~ ({ResourceGroup})\n| summarize Machines = dcount(joinId) by status",
              "size": 1,
              "title": "🔍 Status Operacional dos Servidores",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "piechart",
              "chartSettings": {
                "createOtherGroup": 0,
                "showLegend": true,
                "labelColumn": "status",
                "valueColumn": "Machines",
                "seriesLabelSettings": [
                  {
                    "seriesName": "Connected",
                    "color": "#28a745"
                  },
                  {
                    "seriesName": "Offline",
                    "color": "#dc3545"
                  },
                  {
                    "seriesName": "Error",
                    "color": "#ffc107"
                  },
                  {
                    "seriesName": "Expired",
                    "color": "#fd7e14"
                  },
                  {
                    "seriesName": "Unknown",
                    "color": "#6c757d"
                  }
                ]
              }
            },
            "customWidth": "50",
            "name": "status_pie"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type == \"microsoft.hybridcompute/machines\"\n| extend joinId = tolower(id)\n| join kind = leftouter (\n    resources\n    | where type == \"microsoft.hybridcompute/machines/extensions\"\n    | where properties.publisher =~ \"Microsoft.AzureData\"\n    | where tostring(properties.type) in (\"WindowsAgent.SqlServer\", \"LinuxAgent.SqlServer\")\n    | extend extMachineId = tolower(substring(id, 0, indexof(id, \"/extensions\")))\n    | extend licenseTypeRaw = tostring(properties.settings.LicenseType)\n    | project extMachineId, licenseTypeRaw\n)\non $left.joinId == $right.extMachineId\n| where isnotempty(extMachineId)\n| extend LicenseType = case(\n    licenseTypeRaw == \"PAYG\", \"Pay-as-you-go (PAYG)\",\n    licenseTypeRaw == \"Paid\", \"Software Assurance (Paid)\",\n    licenseTypeRaw == \"LicenseOnly\", \"License Only\",\n    isempty(licenseTypeRaw), \"Configuração pendente\",\n    licenseTypeRaw)\n| where resourceGroup in~ ({ResourceGroup})\n| summarize Servidores = dcount(joinId) by LicenseType\n| order by Servidores desc",
              "size": 1,
              "title": "📊 Distribuição por Modelo de Licença",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "piechart",
              "chartSettings": {
                "labelColumn": "LicenseType",
                "valueColumn": "Servidores",
                "showLegend": true,
                "createOtherGroup": 0,
                "seriesLabelSettings": [
                  {
                    "seriesName": "Pay-as-you-go (PAYG)",
                    "color": "#007bff"
                  },
                  {
                    "seriesName": "Software Assurance (Paid)",
                    "color": "#28a745"
                  },
                  {
                    "seriesName": "License Only",
                    "color": "#fd7e14"
                  },
                  {
                    "seriesName": "Configuração pendente",
                    "color": "#6c757d"
                  }
                ]
              }
            },
            "customWidth": "50",
            "name": "license_pie"
          }
        ]
      },
      "conditionalVisibility": {
        "parameterName": "SelectedTab",
        "comparison": "isEqualTo",
        "value": "VisaoGeral"
      },
      "name": "pie_charts_group"
    },
    {
      "type": 1,
      "content": {
        "json": "---\n## 🗃️ Ativação de Licenciamento SQL (SA × ESU)\n**Hosts com SQL Server: SA SQL (`LicenseType = Paid`/AHB) e ESU SQL (`enableExtendedSecurityUpdates`) ativados vs não ativados.**"
      },
      "conditionalVisibility": {
        "parameterName": "SelectedTab",
        "comparison": "isEqualTo",
        "value": "VisaoGeral"
      },
      "name": "sa_activation_header"
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type == \"microsoft.hybridcompute/machines\"\n| extend joinId = tolower(id)\n| join kind=inner (\n    resources\n    | where type == \"microsoft.azurearcdata/sqlserverinstances\"\n    | extend arcMachineId = tolower(tostring(properties.containerResourceId))\n    | distinct arcMachineId\n) on $left.joinId == $right.arcMachineId\n| join kind=leftouter (\n    resources\n    | where type == \"microsoft.hybridcompute/machines/extensions\"\n    | where properties.publisher =~ \"Microsoft.AzureData\"\n    | where tostring(properties.type) in (\"WindowsAgent.SqlServer\", \"LinuxAgent.SqlServer\")\n    | extend extMachineId = tolower(substring(id, 0, indexof(id, \"/extensions\")))\n    | extend licenseTypeRaw = tostring(properties.settings.LicenseType)\n    | project extMachineId, licenseTypeRaw\n) on $left.joinId == $right.extMachineId\n| where resourceGroup in~ ({ResourceGroup})\n| extend SA_SQL = iff(licenseTypeRaw == \"Paid\", \"✅ Ativado (Paid/SA)\", \"❌ Não ativado\")\n| summarize Hosts = dcount(joinId) by SA_SQL",
              "size": 1,
              "title": "🗃️ SA SQL — Ativação (Paid/AHB)",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "piechart",
              "chartSettings": {
                "createOtherGroup": 0,
                "showLegend": true,
                "labelColumn": "SA_SQL",
                "valueColumn": "Hosts",
                "seriesLabelSettings": [
                  {
                    "seriesName": "✅ Ativado (Paid/SA)",
                    "color": "#28a745"
                  },
                  {
                    "seriesName": "❌ Não ativado",
                    "color": "#dc3545"
                  }
                ]
              }
            },
            "customWidth": "50",
            "name": "sa_sql_activation_pie"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type == \"microsoft.hybridcompute/machines\"\n| extend joinId = tolower(id)\n| join kind=inner (\n    resources\n    | where type == \"microsoft.azurearcdata/sqlserverinstances\"\n    | extend arcMachineId = tolower(tostring(properties.containerResourceId))\n    | distinct arcMachineId\n) on $left.joinId == $right.arcMachineId\n| join kind=leftouter (\n    resources\n    | where type == \"microsoft.hybridcompute/machines/extensions\"\n    | where properties.publisher =~ \"Microsoft.AzureData\"\n    | where tostring(properties.type) in (\"WindowsAgent.SqlServer\", \"LinuxAgent.SqlServer\")\n    | extend extMachineId = tolower(substring(id, 0, indexof(id, \"/extensions\")))\n    | extend esuRaw = tostring(properties.settings.enableExtendedSecurityUpdates)\n    | project extMachineId, esuRaw\n) on $left.joinId == $right.extMachineId\n| where resourceGroup in~ ({ResourceGroup})\n| extend ESU_SQL = iff(esuRaw =~ \"true\", \"✅ Habilitado\", \"❌ Não habilitado\")\n| summarize Hosts = dcount(joinId) by ESU_SQL",
              "size": 1,
              "title": "🛡️ ESU SQL — Ativação (hosts SQL)",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "piechart",
              "chartSettings": {
                "createOtherGroup": 0,
                "showLegend": true,
                "labelColumn": "ESU_SQL",
                "valueColumn": "Hosts",
                "seriesLabelSettings": [
                  {
                    "seriesName": "✅ Habilitado",
                    "color": "#28a745"
                  },
                  {
                    "seriesName": "❌ Não habilitado",
                    "color": "#dc3545"
                  }
                ]
              }
            },
            "customWidth": "50",
            "name": "esu_sql_activation_pie"
          }
        ]
      },
      "conditionalVisibility": {
        "parameterName": "SelectedTab",
        "comparison": "isEqualTo",
        "value": "VisaoGeral"
      },
      "name": "sa_activation_group"
    },
    {
      "type": 1,
      "content": {
        "json": "---\n## 📋 Inventário Corporativo\n**Registro detalhado para auditoria e compliance**"
      },
      "conditionalVisibility": {
        "parameterName": "SelectedTab",
        "comparison": "isEqualTo",
        "value": "Inventario"
      },
      "name": "inventory_header"
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type == \"microsoft.hybridcompute/machines\"\n| extend status = case(\n    tolower(properties.status) == 'connected', 'Connected',\n    tolower(properties.status) == 'disconnected', 'Offline',\n    tolower(properties.status) == 'error', 'Error',\n    tolower(properties.status) == 'expired', 'Expired',\n    'Unknown'\n)\n| extend joinId = tolower(id)\n| join kind = leftouter (\n    resources\n    | where type == \"microsoft.azurearcdata/sqlserverinstances\"\n    | extend arcMachineId = tolower(tostring(properties.containerResourceId))\n    | extend sqlVersion = tostring(properties.version)\n    | extend vCores = toint(properties.vCore)\n    | extend sqlEdition = tostring(properties.edition)\n    | extend sqlInstanceName = name\n    | extend instLicType = tostring(properties.licenseType)\n    | project arcMachineId, sqlInstanceName, sqlVersion, sqlEdition, sqlVcores = vCores, instLicType\n)\non $left.joinId == $right.arcMachineId\n| join kind = leftouter (\n    resources\n    | where type == \"microsoft.hybridcompute/machines/extensions\"\n    | where properties.publisher =~ \"Microsoft.AzureData\"\n    | where tostring(properties.type) in (\"WindowsAgent.SqlServer\", \"LinuxAgent.SqlServer\")\n    | extend extMachineId = tolower(substring(id, 0, indexof(id, \"/extensions\")))\n    | extend licenseTypeRaw = tostring(properties.settings.LicenseType)\n    | extend esuRaw = tostring(properties.settings.enableExtendedSecurityUpdates)\n    | extend pcoreRaw = tostring(properties.settings.UsePhysicalCoreLicense.IsApplied)\n    | extend extStateRaw = tostring(properties.provisioningState)\n    | project extMachineId, licenseTypeRaw, esuRaw, pcoreRaw, extStateRaw\n)\non $left.joinId == $right.extMachineId\n| where isnotempty(sqlVersion)\n| extend SA_SQL = case(licenseTypeRaw == \"Paid\", \"✅ Paid (SA)\", licenseTypeRaw == \"PAYG\", \"☁️ PAYG\", licenseTypeRaw == \"LicenseOnly\", \"❌ License only\", \"⏳ pendente\")\n| extend ESU_SQL = case(esuRaw =~ \"true\", \"✅ Habilitado\", licenseTypeRaw in (\"Paid\", \"PAYG\"), \"❌ Não (elegível)\", \"🚫 N/A (exige Paid/PAYG)\")\n| extend LicencaPCore = iff(pcoreRaw =~ \"true\", \"✅ p-core (UV)\", \"v-core\")\n| extend Extensao = case(extStateRaw =~ \"Succeeded\", \"✅ OK\", extStateRaw =~ \"Failed\", \"❌ Falha\", isempty(extStateRaw), \"❔ Sem extensão\", strcat(\"⏳ \", extStateRaw))\n| extend ModeloSQL = case(instLicType =~ \"HADR\", \"🔁 HA/DR (passivo)\", instLicType =~ \"ServerCAL\", \"Server+CAL\", instLicType =~ \"PerCore\", \"Per-core\", instLicType =~ \"Free\", \"Grátis (Eval/Express)\", isempty(instLicType), \"—\", instLicType)\n| where resourceGroup in~ ({ResourceGroup})\n| project \n    machineName = name,\n    status,\n    Extensao,\n    operatingSystem = tostring(properties.osSku),\n    sqlInstanceName,\n    sqlVersion,\n    sqlEdition,\n    ModeloSQL,\n    SA_SQL,\n    ESU_SQL,\n    LicencaPCore,\n    sqlVcores\n| order by machineName asc",
              "size": 0,
              "title": "📋 Registro Oficial de Instâncias SQL Server",
              "noDataMessage": "Nenhuma instância SQL Server (Azure Arc) no escopo selecionado.",
              "noDataMessageStyle": 3,
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "table",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "status",
                    "formatter": 18,
                    "formatOptions": {
                      "thresholdsOptions": "icons",
                      "thresholdsGrid": [
                        {
                          "operator": "==",
                          "thresholdValue": "Connected",
                          "representation": "success",
                          "text": "{0}{1}"
                        },
                        {
                          "operator": "==",
                          "thresholdValue": "Offline",
                          "representation": "failed",
                          "text": "{0}{1}"
                        },
                        {
                          "operator": "Default",
                          "thresholdValue": null,
                          "representation": "warning",
                          "text": "{0}{1}"
                        }
                      ]
                    }
                  },
                  {
                    "columnMatch": "Extensao",
                    "formatter": 18,
                    "formatOptions": {
                      "thresholdsOptions": "colors",
                      "thresholdsGrid": [
                        {
                          "operator": "contains",
                          "thresholdValue": "OK",
                          "representation": "green",
                          "text": "{0}{1}"
                        },
                        {
                          "operator": "contains",
                          "thresholdValue": "Falha",
                          "representation": "red",
                          "text": "{0}{1}"
                        },
                        {
                          "operator": "Default",
                          "thresholdValue": null,
                          "representation": "yellow",
                          "text": "{0}{1}"
                        }
                      ]
                    }
                  },
                  {
                    "columnMatch": "sqlVcores",
                    "formatter": 8,
                    "formatOptions": {
                      "palette": "blue"
                    }
                  },
                  {
                    "columnMatch": "sqlEdition",
                    "formatter": 18,
                    "formatOptions": {
                      "thresholdsOptions": "colors",
                      "thresholdsGrid": [
                        {
                          "operator": "contains",
                          "thresholdValue": "Enterprise",
                          "representation": "purple",
                          "text": "{0}{1}"
                        },
                        {
                          "operator": "contains",
                          "thresholdValue": "Standard",
                          "representation": "blue",
                          "text": "{0}{1}"
                        },
                        {
                          "operator": "contains",
                          "thresholdValue": "Developer",
                          "representation": "orange",
                          "text": "{0}{1}"
                        },
                        {
                          "operator": "Default",
                          "thresholdValue": null,
                          "representation": "gray",
                          "text": "{0}{1}"
                        }
                      ]
                    }
                  },
                  {
                    "columnMatch": "ModeloSQL",
                    "formatter": 18,
                    "formatOptions": {
                      "thresholdsOptions": "colors",
                      "thresholdsGrid": [
                        {
                          "operator": "contains",
                          "thresholdValue": "HA/DR",
                          "representation": "green",
                          "text": "{0}{1}"
                        },
                        {
                          "operator": "contains",
                          "thresholdValue": "Grátis",
                          "representation": "gray",
                          "text": "{0}{1}"
                        },
                        {
                          "operator": "Default",
                          "thresholdValue": null,
                          "representation": "blue",
                          "text": "{0}{1}"
                        }
                      ]
                    }
                  },
                  {
                    "columnMatch": "ESU_SQL",
                    "formatter": 18,
                    "formatOptions": {
                      "thresholdsOptions": "colors",
                      "thresholdsGrid": [
                        {
                          "operator": "contains",
                          "thresholdValue": "Habilitado",
                          "representation": "green",
                          "text": "{0}{1}"
                        },
                        {
                          "operator": "contains",
                          "thresholdValue": "elegível",
                          "representation": "orange",
                          "text": "{0}{1}"
                        },
                        {
                          "operator": "Default",
                          "thresholdValue": null,
                          "representation": "gray",
                          "text": "{0}{1}"
                        }
                      ]
                    }
                  },
                  {
                    "columnMatch": "SA_SQL",
                    "formatter": 18,
                    "formatOptions": {
                      "thresholdsOptions": "colors",
                      "thresholdsGrid": [
                        {
                          "operator": "contains",
                          "thresholdValue": "Paid",
                          "representation": "green",
                          "text": "{0}{1}"
                        },
                        {
                          "operator": "contains",
                          "thresholdValue": "PAYG",
                          "representation": "blue",
                          "text": "{0}{1}"
                        },
                        {
                          "operator": "contains",
                          "thresholdValue": "License only",
                          "representation": "orange",
                          "text": "{0}{1}"
                        },
                        {
                          "operator": "Default",
                          "thresholdValue": null,
                          "representation": "gray",
                          "text": "{0}{1}"
                        }
                      ]
                    }
                  }
                ],
                "filter": true,
                "sortBy": [
                  {
                    "itemKey": "machineName",
                    "sortOrder": 1
                  }
                ]
              }
            },
            "customWidth": "70",
            "name": "Tabela_Detalhes"
          },
          {
            "type": 1,
            "content": {
              "json": "### 📝 Guia de Interpretação\n*(colunas da tabela ao lado)*\n\n#### 🔑 Os 2 conceitos de licenciamento SQL\n\n| Conceito | Campo (fonte oficial) | Valores |\n| --- | --- | --- |\n| 🗃️ **SA SQL** | extensão · `settings.LicenseType` | Paid · PAYG · LicenseOnly |\n| 🛡️ **ESU SQL** | extensão · `settings.enableExtendedSecurityUpdates` | ✅ · ❌ · 🚫 |\n\nSão **independentes**: **SA SQL** (Software Assurance / AHB) cobre o licenciamento; **ESU SQL** exige LicenseType **Paid/PAYG** e cobre atualizações de segurança estendidas.\n\n#### 📋 Demais colunas\n\n| Coluna | Significado |\n| --- | --- |\n| **status** | 🟢 Connected · 🔴 Offline · 🟡 Error/Expired |\n| **Extensao** | saúde de `Microsoft.AzureData` (✅ OK · ❌ Falha · ⏳ · ❔). Se ≠ OK, licença/ESU podem estar desatualizados |\n| **sqlEdition** | 🟣 Enterprise · 🔵 Standard · 🟠 Developer · ⚪ Express/Eval/Web |\n| **Modelo SQL** | papel da instância (`licenseType`): 🔁 HA/DR passivo · Server+CAL · Per-core · Grátis |\n| **Licença p-core** | ✅ p-core (UV, virtualização ilimitada) · v-core |\n| **sqlVcores** | capacidade técnica — **não** é base de cobrança (a base é o nº de cores do host) |\n\n#### 🗃️ SA SQL (detalhe)\n- ✅ **Paid (SA)** = licença com SA / Azure Hybrid Benefit.\n- ☁️ **PAYG** = pago por hora (sem SA).\n- ❌ **License only** = perpétua / Server+CAL sem SA.\n- ⏳ **pendente** = LicenseType não definido.\n\n#### 🛡️ ESU SQL (detalhe)\n- ✅ **Habilitado** = `enableExtendedSecurityUpdates = true` (recebe ESU do SQL Server).\n- ❌ **Não habilitado** = host elegível (Paid/PAYG) sem ESU SQL ativado.\n- 🚫 **N/A** = exige LicenseType **Paid/PAYG**.\n\n#### ⚠️ Ações\n- Offline ou Extensão ≠ OK → investigar.\n- `LicenseOnly` → avaliar Paid/PAYG (ESU SQL e HA/DR exigem).\n- Definir `LicenseType` via runbook `AzArcSQLModifyLicenseTypeforSA`.\n\n#### 📚 Referências oficiais\n- **Licença & billing SQL**: learn.microsoft.com/sql/sql-server/azure-arc/manage-license-billing\n- **Custo do Arc** (control plane gratuito): learn.microsoft.com/azure/cloud-adoption-framework/scenarios/hybrid/arc-enabled-servers/eslz-cost-governance"
            },
            "customWidth": "30",
            "name": "legends_sidebar"
          }
        ]
      },
      "conditionalVisibility": {
        "parameterName": "SelectedTab",
        "comparison": "isEqualTo",
        "value": "Inventario"
      },
      "name": "inventory_group"
    }
  ],
  "defaultResourceIds": [
    "/subscriptions"
  ],
  "$schema": "https://github.com/Microsoft/Application-Insights-Workbooks/blob/master/schema/workbook.json"
}
