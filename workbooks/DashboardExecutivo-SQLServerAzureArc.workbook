            "customWidth": "20",
            "name": "trueup_estimated_total"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type == \"microsoft.hybridcompute/machines/extensions\"\n| where properties.publisher =~ \"Microsoft.AzureData\"\n| where tostring(properties.type) in (\"WindowsAgent.SqlServer\", \"LinuxAgent.SqlServer\")\n| extend hostId = tolower(substring(id, 0, indexof(id, \"/extensions\")))\n| extend licenseTypeRaw = tostring(properties.settings.LicenseType)\n| extend esuRaw = tostring(properties.settings.enableExtendedSecurityUpdates)\n| extend pcoreRaw = tostring(properties.settings.UsePhysicalCoreLicense.IsApplied)\n| extend extState = tostring(properties.provisioningState)\n| where resourceGroup in~ ({ResourceGroup})\n| project hostId, licenseTypeRaw, esuRaw, pcoreRaw, extState\n| join kind=inner (\n    resources\n    | where type == \"microsoft.hybridcompute/machines\"\n    | extend hostId = tolower(id)\n    | extend logicalCores = toint(properties.detectedProperties.logicalCoreCount)\n    | extend physicalCores = toint(properties.detectedProperties.coreCount)\n    | project hostId, machineName = name, logicalCores, physicalCores\n) on hostId\n| join kind=leftouter (\n    resources\n    | where type == \"microsoft.azurearcdata/sqlserverinstances\"\n    | extend hostId = tolower(tostring(properties.containerResourceId))\n    | extend edition = tostring(properties.edition)\n    | extend instLicType = tostring(properties.licenseType)\n    | extend sqlVersion = tostring(properties.version)\n    | extend SQLVersionMajor = case(sqlVersion has \"SQL Server 2014\" or sqlVersion startswith \"12.\", \"SQL Server 2014\", sqlVersion has \"SQL Server 2016\" or sqlVersion startswith \"13.\", \"SQL Server 2016\", sqlVersion has \"SQL Server 2017\" or sqlVersion startswith \"14.\", \"SQL Server 2017\", sqlVersion has \"SQL Server 2019\" or sqlVersion startswith \"15.\", \"SQL Server 2019\", sqlVersion has \"SQL Server 2022\" or sqlVersion startswith \"16.\", \"SQL Server 2022\", sqlVersion has \"SQL Server 2025\" or sqlVersion startswith \"17.\", \"SQL Server 2025\", \"Não identificado\")\n    | extend isSQLServerESUVersion = SQLVersionMajor in (\"SQL Server 2014\", \"SQL Server 2016\")\n    | extend editionRank = case(edition has \"Enterprise\", 6, edition has \"Standard\", 5, edition has \"Web\", 4, edition has \"Express\", 3, edition has \"Developer\", 2, edition has \"Evaluation\", 1, 0)\n    | summarize topRank = max(editionRank), ativos = countif(instLicType !~ \"HADR\"), qtdSQLServerESU = countif(isSQLServerESUVersion), versoesSQL = make_set(SQLVersionMajor, 20) by hostId\n) on hostId\n| extend topEdition = case(topRank == 6, \"Enterprise\", topRank == 5, \"Standard\", topRank == 4, \"Web\", topRank == 3, \"Express\", topRank == 2, \"Developer\", topRank == 1, \"Evaluation\", \"Sem instância\")\n| extend ed3 = case(topEdition == \"Enterprise\", \"Ent\", topEdition == \"Standard\", \"Std\", topEdition == \"Web\", \"Web\", topEdition == \"Express\", \"Exp\", topEdition)\n| extend isFreeEdition = topEdition in (\"Developer\", \"Evaluation\", \"Express\")\n| extend isPassivo = (topRank > 0 and ativos == 0)\n| extend hasSQLServerESUVersion = qtdSQLServerESU > 0\n| extend coresDetectados = coalesce(logicalCores, physicalCores, 0)\n| extend coresHost = iff(coresDetectados < 4, 4, coresDetectados)\n| extend coresLicencaEstimados = case(topEdition == \"Sem instância\", 0, isFreeEdition, 0, isPassivo and licenseTypeRaw in (\"Paid\", \"PAYG\"), 0, isempty(licenseTypeRaw), 0, coresHost)\n| extend coresPAYG = iff(coresLicencaEstimados > 0 and licenseTypeRaw == \"PAYG\", coresHost, 0)\n| extend coresPaid = iff(coresLicencaEstimados > 0 and licenseTypeRaw == \"Paid\", coresHost, 0)\n| extend coresLicenseOnlyComLicenciamento = iff(coresLicencaEstimados > 0 and licenseTypeRaw == \"LicenseOnly\", coresHost, 0)\n| extend coresRZero = case(isFreeEdition, coresHost, isPassivo and licenseTypeRaw in (\"Paid\", \"PAYG\"), coresHost, 0)\n| summarize HostsLicenseOnlyComLicenciamento = dcountif(hostId, coresLicenseOnlyComLicenciamento > 0)",
              "size": 4,
              "title": "⚠️ Hosts LicenseOnly com cores de licenciamento",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "tiles",
              "tileSettings": {
                "leftContent": {
                  "columnMatch": "HostsLicenseOnlyComLicenciamento",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "orange"
                  }
                },
                "showBorder": true,
                "size": "small"
              }
            },
            "customWidth": "20",
            "name": "trueup_licenseonly"
          }
        ]
      },
      "name": "trueup_kpis",
      "conditionalVisibility": {
        "parameterName": "SelectedTab",
        "comparison": "isEqualTo",
        "value": "Licenciamento"
      }
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type == \"microsoft.hybridcompute/machines/extensions\"\n| where properties.publisher =~ \"Microsoft.AzureData\"\n| where tostring(properties.type) in (\"WindowsAgent.SqlServer\", \"LinuxAgent.SqlServer\")\n| extend hostId = tolower(substring(id, 0, indexof(id, \"/extensions\")))\n| extend licenseTypeRaw = tostring(properties.settings.LicenseType)\n| extend esuRaw = tostring(properties.settings.enableExtendedSecurityUpdates)\n| extend pcoreRaw = tostring(properties.settings.UsePhysicalCoreLicense.IsApplied)\n| extend extState = tostring(properties.provisioningState)\n| where resourceGroup in~ ({ResourceGroup})\n| project hostId, licenseTypeRaw, esuRaw, pcoreRaw, extState\n| join kind=inner (\n    resources\n    | where type == \"microsoft.hybridcompute/machines\"\n    | extend hostId = tolower(id)\n    | extend logicalCores = toint(properties.detectedProperties.logicalCoreCount)\n    | extend physicalCores = toint(properties.detectedProperties.coreCount)\n    | project hostId, machineName = name, logicalCores, physicalCores\n) on hostId\n| join kind=leftouter (\n    resources\n    | where type == \"microsoft.azurearcdata/sqlserverinstances\"\n    | extend hostId = tolower(tostring(properties.containerResourceId))\n    | extend edition = tostring(properties.edition)\n    | extend instLicType = tostring(properties.licenseType)\n    | extend sqlVersion = tostring(properties.version)\n    | extend SQLVersionMajor = case(sqlVersion has \"SQL Server 2014\" or sqlVersion startswith \"12.\", \"SQL Server 2014\", sqlVersion has \"SQL Server 2016\" or sqlVersion startswith \"13.\", \"SQL Server 2016\", sqlVersion has \"SQL Server 2017\" or sqlVersion startswith \"14.\", \"SQL Server 2017\", sqlVersion has \"SQL Server 2019\" or sqlVersion startswith \"15.\", \"SQL Server 2019\", sqlVersion has \"SQL Server 2022\" or sqlVersion startswith \"16.\", \"SQL Server 2022\", sqlVersion has \"SQL Server 2025\" or sqlVersion startswith \"17.\", \"SQL Server 2025\", \"Não identificado\")\n    | extend isSQLServerESUVersion = SQLVersionMajor in (\"SQL Server 2014\", \"SQL Server 2016\")\n    | extend editionRank = case(edition has \"Enterprise\", 6, edition has \"Standard\", 5, edition has \"Web\", 4, edition has \"Express\", 3, edition has \"Developer\", 2, edition has \"Evaluation\", 1, 0)\n    | summarize topRank = max(editionRank), ativos = countif(instLicType !~ \"HADR\"), qtdSQLServerESU = countif(isSQLServerESUVersion), versoesSQL = make_set(SQLVersionMajor, 20) by hostId\n) on hostId\n| extend topEdition = case(topRank == 6, \"Enterprise\", topRank == 5, \"Standard\", topRank == 4, \"Web\", topRank == 3, \"Express\", topRank == 2, \"Developer\", topRank == 1, \"Evaluation\", \"Sem instância\")\n| extend ed3 = case(topEdition == \"Enterprise\", \"Ent\", topEdition == \"Standard\", \"Std\", topEdition == \"Web\", \"Web\", topEdition == \"Express\", \"Exp\", topEdition)\n| extend isFreeEdition = topEdition in (\"Developer\", \"Evaluation\", \"Express\")\n| extend isPassivo = (topRank > 0 and ativos == 0)\n| extend hasSQLServerESUVersion = qtdSQLServerESU > 0\n| extend coresDetectados = coalesce(logicalCores, physicalCores, 0)\n| extend coresHost = iff(coresDetectados < 4, 4, coresDetectados)\n| extend coresLicencaEstimados = case(topEdition == \"Sem instância\", 0, isFreeEdition, 0, isPassivo and licenseTypeRaw in (\"Paid\", \"PAYG\"), 0, isempty(licenseTypeRaw), 0, coresHost)\n| extend coresPAYG = iff(coresLicencaEstimados > 0 and licenseTypeRaw == \"PAYG\", coresHost, 0)\n| extend coresPaid = iff(coresLicencaEstimados > 0 and licenseTypeRaw == \"Paid\", coresHost, 0)\n| extend coresLicenseOnlyComLicenciamento = iff(coresLicencaEstimados > 0 and licenseTypeRaw == \"LicenseOnly\", coresHost, 0)\n| extend coresRZero = case(isFreeEdition, coresHost, isPassivo and licenseTypeRaw in (\"Paid\", \"PAYG\"), coresHost, 0)\n| extend meterSkuProjetado = case(topEdition == \"Sem instância\", \"Aguardando inventário SQL Server\", topEdition in (\"Developer\", \"Evaluation\"), strcat(topEdition, \" edition - R$ 0\"), topEdition == \"Express\", \"Express edition - R$ 0\", isPassivo and licenseTypeRaw in (\"Paid\", \"PAYG\"), strcat(ed3, \" edition - DR replica - R$ 0\"), isempty(licenseTypeRaw), \"Configuração pendente\", pcoreRaw =~ \"true\", strcat(ed3, \" edition - Virtual license\"), licenseTypeRaw == \"PAYG\", strcat(ed3, \" edition - PAYG\"), licenseTypeRaw == \"Paid\", strcat(ed3, \" edition - Paid\"), licenseTypeRaw == \"LicenseOnly\", strcat(ed3, \" edition - License only\"), \"-\")\n| extend estadoSQL = case(topEdition == \"Sem instância\", \"Sem instância\", isFreeEdition, \"Edição gratuita\", isPassivo and licenseTypeRaw in (\"Paid\", \"PAYG\"), \"Passivo HA/DR isento\", isPassivo, \"Passivo HA/DR sem benefício\", \"Ativo\")\n| extend statusESUSQLServer = case(hasSQLServerESUVersion and esuRaw =~ \"true\", \"SQL Server ESU habilitado\", hasSQLServerESUVersion, \"SQL Server ESU não habilitado\", \"Fora do escopo SQL Server 2014/2016\")\n| extend extensaoSQL = case(extState =~ \"Succeeded\", \"OK\", extState =~ \"Failed\", \"Falha\", isempty(extState), \"Sem estado\", extState)\n| extend faturaAzure = case(topEdition == \"Sem instância\", \"-\", isempty(licenseTypeRaw), \"Pendente\", coresLicencaEstimados > 0 and licenseTypeRaw == \"PAYG\", \"PAYG - Azure cobra\", coresLicencaEstimados > 0 and licenseTypeRaw == \"Paid\", \"Paid - R$ 0 no Azure\", coresLicencaEstimados > 0 and licenseTypeRaw == \"LicenseOnly\", \"LicenseOnly - R$ 0 no Azure\", \"R$ 0\")\n| extend ExisteSQL2014_2016 = iff(hasSQLServerESUVersion, \"Sim\", \"Não\")\n| project Host = machineName, EdicaoSQL = topEdition, VersoesSQL = tostring(versoesSQL), ExisteSQL2014_2016, ExtensaoSQL = extensaoSQL, LicenseType = iff(isempty(licenseTypeRaw), \"Pendente\", licenseTypeRaw), EstadoSQL = estadoSQL, FaturaAzure = faturaAzure, MeterProjetado = meterSkuProjetado, CoresLicenciamentoEstimado = coresLicencaEstimados, CoresHost = coresHost, SQLServerESU = statusESUSQLServer, PCore = iff(pcoreRaw =~ \"true\", \"p-core\", \"v-core\")\n| order by CoresLicenciamentoEstimado desc, Host asc",
              "size": 0,
              "title": "🧾 Posição Técnica SQL Server por Host/OSE",
              "noDataMessage": "Nenhum host SQL Server enabled by Azure Arc com extensão SQL Server no escopo selecionado.",
              "noDataMessageStyle": 3,
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "table",
              "gridSettings": {
                "filter": true,
                "formatters": [
                  {
                    "columnMatch": "CoresLicenciamentoEstimado",
                    "formatter": 8,
                    "formatOptions": {
                      "palette": "red"
                    }
                  },
                  {
                    "columnMatch": "CoresHost",
                    "formatter": 8,
                    "formatOptions": {
                      "palette": "blue"
                    }
                  }
                ]
              }
            },
            "customWidth": "70",
            "name": "trueup_table"
          },
          {
            "type": 1,
            "content": {
              "json": "### Como ler a tabela\n\n**Host/OSE** é o servidor físico ou VM que hospeda uma ou mais instâncias SQL Server. Esta visão é consolidada por host, não por instância individual.\n\n| Campo | Leitura |\n| --- | --- |\n| **LicenseType** | valor reportado pela extensão SQL Server: `Paid`, `PAYG`, `LicenseOnly` ou pendente |\n| **CoresLicenciamentoEstimado** | estimativa calculada pelo workbook para apoiar análise técnica de licenciamento SQL Server |\n| **CoresHost** | cores reportados pelo host via Azure Arc, usando `logicalCoreCount` ou `coreCount`, com mínimo de 4 aplicado na query |\n| **MeterProjetado** | medidor projetado pelo workbook com base em edição, LicenseType, p-core e estado HA/DR |\n| **SQLServerESU** | estado da configuração de Extended Security Updates do SQL Server reportada pela extensão SQL Server |\n| **VersoesSQL** | versões principais identificadas nas instâncias SQL Server do host |\n\n**Limitação intencional:** este workbook não confirma entitlement contratual. `LicenseType = Paid` deve ser reconciliado com Product Terms, EA/Volume Licensing, contratos vigentes, LSP ou time de licenciamento."
            },
            "name": "trueup_legend",
            "customWidth": "30"
          }
        ]
      },
      "name": "trueup_detail",
      "conditionalVisibility": {
        "parameterName": "SelectedTab",
        "comparison": "isEqualTo",
        "value": "Licenciamento"
      }
    },
    {
      "type": 1,
      "content": {
        "json": "---\n## 📊 Capacidade Técnica das Instâncias SQL Server\n**Visão técnica de `properties.vCore` por instância SQL Server. Não representa fatura, AHB, PAYG, true-up ou ACR.**"
      },
      "name": "distribution_header",
      "conditionalVisibility": {
        "parameterName": "SelectedTab",
        "comparison": "isEqualTo",
        "value": "Inventario"
      }
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type == \"microsoft.azurearcdata/sqlserverinstances\"\n| where resourceGroup in~ ({ResourceGroup})\n| extend sqlEdition = tostring(properties.edition)\n| extend sqlVcores = toint(properties.vCore)\n| where isnotempty(sqlEdition)\n| summarize VCoreInstancias = sum(sqlVcores) by sqlEdition\n| order by VCoreInstancias desc",
              "size": 4,
              "title": "💻 vCores por edição SQL Server (instâncias)",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "tiles",
              "tileSettings": {
                "titleContent": {
                  "columnMatch": "sqlEdition",
                  "formatter": 1
                },
                "leftContent": {
                  "columnMatch": "VCoreInstancias",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "blue"
                  }
                },
                "showBorder": true,
                "size": "small"
              }
            },
            "customWidth": "50",
            "name": "vcores_by_edition"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type == \"microsoft.hybridcompute/machines/extensions\"\n| where properties.publisher =~ \"Microsoft.AzureData\"\n| where tostring(properties.type) in (\"WindowsAgent.SqlServer\", \"LinuxAgent.SqlServer\")\n| extend hostId = tolower(substring(id, 0, indexof(id, \"/extensions\")))\n| extend licenseTypeRaw = tostring(properties.settings.LicenseType)\n| where resourceGroup in~ ({ResourceGroup})\n| join kind=leftouter (\n    resources\n    | where type == \"microsoft.azurearcdata/sqlserverinstances\"\n    | extend hostId = tolower(tostring(properties.containerResourceId))\n    | extend sqlVcores = toint(properties.vCore)\n    | project hostId, sqlVcores\n) on hostId\n| extend LicenseType = case(licenseTypeRaw == \"PAYG\", \"PAYG\", licenseTypeRaw == \"Paid\", \"Paid\", licenseTypeRaw == \"LicenseOnly\", \"LicenseOnly\", isempty(licenseTypeRaw), \"Pendente\", licenseTypeRaw)\n| summarize VCoreInstancias = sum(sqlVcores) by LicenseType\n| order by VCoreInstancias desc",
              "size": 4,
              "title": "💳 vCores por LicenseType (instâncias)",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "tiles",
              "tileSettings": {
                "titleContent": {
                  "columnMatch": "LicenseType",
                  "formatter": 1
                },
                "leftContent": {
                  "columnMatch": "VCoreInstancias",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "yellow"
                  }
                },
                "showBorder": true,
                "size": "small"
              }
            },
            "customWidth": "50",
            "name": "vcores_by_license"
          }
        ]
      },
      "name": "capacity_group",
      "conditionalVisibility": {
        "parameterName": "SelectedTab",
        "comparison": "isEqualTo",
        "value": "Inventario"
      }
    },
    {
      "type": 1,
      "content": {
        "json": "---\n## 📋 Inventário Técnico de Instâncias SQL Server\n**Registro por instância para auditoria técnica de versão, edição, modelo SQL Server, LicenseType e SQL Server ESU.**"
      },
      "name": "inventory_header",
      "conditionalVisibility": {
        "parameterName": "SelectedTab",
        "comparison": "isEqualTo",
        "value": "Inventario"
      }
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type == \"microsoft.hybridcompute/machines\"\n| extend arcStatus = case(tolower(properties.status) == 'connected', 'Connected', tolower(properties.status) == 'disconnected', 'Offline', tolower(properties.status) == 'error', 'Error', tolower(properties.status) == 'expired', 'Expired', 'Unknown')\n| extend joinId = tolower(id)\n| join kind = leftouter (\n    resources\n    | where type == \"microsoft.azurearcdata/sqlserverinstances\"\n    | extend arcMachineId = tolower(tostring(properties.containerResourceId))\n    | extend sqlVersion = tostring(properties.version)\n    | extend SQLVersionMajor = case(sqlVersion has \"SQL Server 2014\" or sqlVersion startswith \"12.\", \"SQL Server 2014\", sqlVersion has \"SQL Server 2016\" or sqlVersion startswith \"13.\", \"SQL Server 2016\", sqlVersion has \"SQL Server 2017\" or sqlVersion startswith \"14.\", \"SQL Server 2017\", sqlVersion has \"SQL Server 2019\" or sqlVersion startswith \"15.\", \"SQL Server 2019\", sqlVersion has \"SQL Server 2022\" or sqlVersion startswith \"16.\", \"SQL Server 2022\", sqlVersion has \"SQL Server 2025\" or sqlVersion startswith \"17.\", \"SQL Server 2025\", \"Não identificado\")\n    | extend sqlVcores = toint(properties.vCore)\n    | extend sqlEdition = tostring(properties.edition)\n    | extend sqlInstanceName = name\n    | extend sqlModel = tostring(properties.licenseType)\n    | project arcMachineId, sqlInstanceName, sqlVersion, SQLVersionMajor, sqlEdition, sqlVcores, sqlModel\n) on $left.joinId == $right.arcMachineId\n| join kind = leftouter (\n    resources\n    | where type == \"microsoft.hybridcompute/machines/extensions\"\n    | where properties.publisher =~ \"Microsoft.AzureData\"\n    | where tostring(properties.type) in (\"WindowsAgent.SqlServer\", \"LinuxAgent.SqlServer\")\n    | extend extMachineId = tolower(substring(id, 0, indexof(id, \"/extensions\")))\n    | extend licenseTypeRaw = tostring(properties.settings.LicenseType)\n    | extend esuRaw = tostring(properties.settings.enableExtendedSecurityUpdates)\n    | extend pcoreRaw = tostring(properties.settings.UsePhysicalCoreLicense.IsApplied)\n    | extend extStateRaw = tostring(properties.provisioningState)\n    | project extMachineId, licenseTypeRaw, esuRaw, pcoreRaw, extStateRaw\n) on $left.joinId == $right.extMachineId\n| where isnotempty(sqlVersion)\n| where resourceGroup in~ ({ResourceGroup})\n| extend LicenseTypeSQL = case(licenseTypeRaw == \"Paid\", \"Paid\", licenseTypeRaw == \"PAYG\", \"PAYG\", licenseTypeRaw == \"LicenseOnly\", \"LicenseOnly\", \"Pendente\")\n| extend SQLServerESU = case(SQLVersionMajor in (\"SQL Server 2014\", \"SQL Server 2016\") and esuRaw =~ \"true\", \"SQL Server ESU habilitado\", SQLVersionMajor in (\"SQL Server 2014\", \"SQL Server 2016\"), \"SQL Server ESU não habilitado\", \"Fora do escopo SQL Server 2014/2016\")\n| extend PCore = iff(pcoreRaw =~ \"true\", \"p-core\", \"v-core\")\n| extend ExtensaoSQL = case(extStateRaw =~ \"Succeeded\", \"OK\", extStateRaw =~ \"Failed\", \"Falha\", isempty(extStateRaw), \"Sem extensão\", extStateRaw)\n| extend ModeloSQL = case(sqlModel =~ \"HADR\", \"HA/DR passivo\", sqlModel =~ \"ServerCAL\", \"Server+CAL\", sqlModel =~ \"PerCore\", \"Per-core\", sqlModel =~ \"Free\", \"Free/Eval/Express\", isempty(sqlModel), \"-\", sqlModel)\n| project Host = name, ArcStatus = arcStatus, ExtensaoSQL, InstanciaSQL = sqlInstanceName, VersaoSQL = sqlVersion, SQLVersionMajor, EdicaoSQL = sqlEdition, ModeloSQL, LicenseTypeSQL, SQLServerESU, PCore, vCoreInstancia = sqlVcores\n| order by Host asc",
              "size": 0,
              "title": "📋 Registro de Instâncias SQL Server enabled by Azure Arc",
              "noDataMessage": "Nenhuma instância SQL Server enabled by Azure Arc no escopo selecionado.",
              "noDataMessageStyle": 3,
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "table",
              "gridSettings": {
                "filter": true,
                "sortBy": [
                  {
                    "itemKey": "Host",
                    "sortOrder": 1
                  }
                ],
                "formatters": [
                  {
                    "columnMatch": "vCoreInstancia",
                    "formatter": 8,
                    "formatOptions": {
                      "palette": "blue"
                    }
                  }
                ]
              }
            },
            "customWidth": "70",
            "name": "inventory_table"
          },
          {
            "type": 1,
            "content": {
              "json": "### Guia de interpretação\n\n| Coluna | Significado |\n| --- | --- |\n| **Host** | servidor Arc que hospeda a instância SQL Server |\n| **ArcStatus** | estado do Arc-enabled server |\n| **ExtensaoSQL** | estado da extensão SQL Server (`Microsoft.AzureData`) |\n| **SQLVersionMajor** | classificação da versão principal identificada pela string de versão reportada |\n| **LicenseTypeSQL** | `Paid`, `PAYG`, `LicenseOnly` ou pendente |\n| **SQLServerESU** | status de SQL Server ESU para SQL Server 2014/2016; demais versões aparecem fora do escopo |\n| **vCoreInstancia** | capacidade técnica da instância, não base isolada para true-up |\n\n**Ação prática:** validar `ExtensaoSQL != OK`, `LicenseTypeSQL = Pendente`, `LicenseOnly` em hosts com edições Standard/Enterprise e qualquer instância `SQLVersionMajor` igual a SQL Server 2014 ou SQL Server 2016 sem SQL Server ESU habilitado."
            },
            "name": "inventory_legend",
            "customWidth": "30"
          }
        ]
      },
      "name": "inventory_group",
      "conditionalVisibility": {
        "parameterName": "SelectedTab",
        "comparison": "isEqualTo",
        "value": "Inventario"
      }
    },
    {
      "type": 1,
      "content": {
        "json": "## 📚 Referências oficiais e escopo\n\n### Documentação pública Microsoft\n- **Manage licensing and billing of SQL Server enabled by Azure Arc**: referência para métodos de licenciamento baseados em core, LicenseType, billing, PAYG, Paid, License only, v-core, p-core e virtualização ilimitada.\n- **Configure SQL Server enabled by Azure Arc**: referência para configuração de propriedades do SQL Server enabled by Azure Arc após instalação da Azure Extension for SQL Server.\n- **SQL Server Extended Security Updates FAQ**: referência para datas de ESU. O FAQ lista SQL Server 2016 com ESU Start Date em 14 de julho de 2026, Year 1 até 13 de julho de 2027, Year 2 até 18 de julho de 2028 e Year 3 até 17 de julho de 2029. O FAQ também informa que SQL Server ESU inclui somente atualizações de segurança Critical e não inclui novos recursos, hotfixes não relacionados a segurança ou solicitações de mudança de design.\n- **SQL Server Extended Security Updates enabled by Azure Arc**: referência para assinatura e gerenciamento de SQL Server ESU via Azure Arc para SQL Server 2014 e SQL Server 2016.\n- **Azure Workbooks data sources**: referência para uso de Azure Resource Graph como fonte de dados em workbooks.\n\n### Escopo explícito deste workbook\nEste workbook cobre exclusivamente **SQL Server enabled by Azure Arc**. Não cobre Windows Server ESU, Windows Server licensing, Windows Server Azure Hybrid Benefit ou inventário de licenciamento de sistema operacional."
      },
      "name": "references",
      "conditionalVisibility": {
        "parameterName": "SelectedTab",
        "comparison": "isEqualTo",
        "value": "Referencias"
      }
    },
    {
      "type": 1,
      "content": {
        "json": "### Change Log\n\n| Version | Date | Description | Author |\n| --- | --- | --- | --- |\n| v1.9.0 | Agosto 2026 | Revisão fim a fim de textos e queries conforme documentação pública Microsoft. Termos ajustados para evitar afirmações não verificáveis: **Cores de licenciamento SQL (estimado)** no lugar de cores licenciáveis, **LicenseType = Paid** no lugar de AHB/SA como conclusão contratual, e **LicenseOnly com cores de licenciamento** no lugar de risco genérico. Adicionados KPIs específicos para **SQL Server 2014/2016**, incluindo hosts com e sem **SQL Server ESU** habilitado. Adicionada nota de SQL Server 2016 ESU com datas oficiais do FAQ e escopo de updates Critical. Inventário passa a exibir `SQLVersionMajor` e status de SQL Server ESU somente para SQL Server 2014/2016. | Fabio Rodrigues Vieira Costa - CSA Azure Infra |"
      },
      "name": "changelog",
      "conditionalVisibility": {
        "parameterName": "SelectedTab",
        "comparison": "isEqualTo",
        "value": "Changelog"
      }
    }
  ],
  "defaultResourceIds": [
    "/subscriptions"
  ],
  "$schema": "https://github.com/Microsoft/Application-Insights-Workbooks/blob/master/schema/workbook.json",
  "layout": {
    "type": "flow"
  },
  "fallbackResourceIds": [
    "Azure Monitor"
  ]
}
