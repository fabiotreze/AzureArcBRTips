    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type == \"microsoft.hybridcompute/machines/extensions\"\n| where properties.publisher =~ \"Microsoft.AzureData\"\n| where tostring(properties.type) in (\"WindowsAgent.SqlServer\", \"LinuxAgent.SqlServer\")\n| extend hostId = tolower(substring(id, 0, indexof(id, \"/extensions\")))\n| extend licenseTypeRaw = tostring(properties.settings.LicenseType)\n| extend esuRaw = tostring(properties.settings.enableExtendedSecurityUpdates)\n| extend extState = tostring(properties.provisioningState)\n| where resourceGroup in~ ({ResourceGroup})\n| project hostId, licenseTypeRaw, esuRaw, extState\n| join kind=inner (\n    resources\n    | where type == \"microsoft.hybridcompute/machines\"\n    | extend hostId = tolower(id)\n    | extend logicalCores = toint(properties.detectedProperties.logicalCoreCount)\n    | extend physicalCores = toint(properties.detectedProperties.coreCount)\n    | project hostId, machineName = name, logicalCores, physicalCores, arcStatus = tostring(properties.status)\n) on hostId\n| join kind=leftouter (\n    resources\n    | where type == \"microsoft.azurearcdata/sqlserverinstances\"\n    | where resourceGroup in~ ({ResourceGroup})\n    | extend hostId = tolower(tostring(properties.containerResourceId))\n    | extend edition = tostring(properties.edition)\n    | extend instLicType = tostring(properties.licenseType)\n    | extend sqlVersion = tostring(properties.version)\n    | extend sqlVcores = toint(properties.vCore)\n    | extend SQLVersionMajor = case(sqlVersion has \"SQL Server 2014\" or sqlVersion startswith \"12.\", \"SQL Server 2014\", sqlVersion has \"SQL Server 2016\" or sqlVersion startswith \"13.\", \"SQL Server 2016\", sqlVersion has \"SQL Server 2017\" or sqlVersion startswith \"14.\", \"SQL Server 2017\", sqlVersion has \"SQL Server 2019\" or sqlVersion startswith \"15.\", \"SQL Server 2019\", sqlVersion has \"SQL Server 2022\" or sqlVersion startswith \"16.\", \"SQL Server 2022\", sqlVersion has \"SQL Server 2025\" or sqlVersion startswith \"17.\", \"SQL Server 2025\", \"Não identificado\")\n    | extend isSQLServerESUVersion = SQLVersionMajor in (\"SQL Server 2014\", \"SQL Server 2016\")\n    | extend editionRank = case(edition has \"Enterprise\", 6, edition has \"Standard\", 5, edition has \"Web\", 4, edition has \"Express\", 3, edition has \"Developer\", 2, edition has \"Evaluation\", 1, 0)\n    | summarize topRank = max(editionRank), ativos = countif(instLicType !~ \"HADR\"), qtdSQLServerESU = countif(isSQLServerESUVersion), versoesSQL = make_set(SQLVersionMajor, 20), instancias=count(), vCoreInstanciaTotal=sum(sqlVcores) by hostId\n) on hostId\n| extend topEdition = case(topRank == 6, \"Enterprise\", topRank == 5, \"Standard\", topRank == 4, \"Web\", topRank == 3, \"Express\", topRank == 2, \"Developer\", topRank == 1, \"Evaluation\", \"Sem instância\")\n| extend ed3 = case(topEdition == \"Enterprise\", \"Ent\", topEdition == \"Standard\", \"Std\", topEdition == \"Web\", \"Web\", topEdition == \"Express\", \"Exp\", topEdition)\n| extend isFreeEdition = topEdition in (\"Developer\", \"Evaluation\", \"Express\")\n| extend isPassivo = (topRank > 0 and ativos == 0)\n| extend hasSQLServerESUVersion = qtdSQLServerESU > 0\n| extend coresDetectados = coalesce(logicalCores, physicalCores, 0)\n| extend coresHost = iff(coresDetectados < 4, 4, coresDetectados)\n| extend CoresConsideradosAnalise = case(topEdition == \"Sem instância\", 0, isFreeEdition, 0, isPassivo and licenseTypeRaw in (\"Paid\", \"PAYG\"), 0, isempty(licenseTypeRaw), 0, coresHost)\n| extend coresPAYG = iff(CoresConsideradosAnalise > 0 and licenseTypeRaw == \"PAYG\", coresHost, 0)\n| extend coresPaid = iff(CoresConsideradosAnalise > 0 and licenseTypeRaw == \"Paid\", coresHost, 0)\n| extend coresLicenseOnlyComAnalise = iff(CoresConsideradosAnalise > 0 and licenseTypeRaw == \"LicenseOnly\", coresHost, 0)\n| extend coresNaoConsiderados = case(isFreeEdition, coresHost, isPassivo and licenseTypeRaw in (\"Paid\", \"PAYG\"), coresHost, 0)\n| summarize Hosts=dcount(hostId), Instancias=sum(instancias), vCoreInstancia=sum(vCoreInstanciaTotal), CoresConsideradosAnalise=sum(CoresConsideradosAnalise) by EdicaoSQL=topEdition\n| order by CoresConsideradosAnalise desc, Hosts desc",
              "size": 0,
              "title": "📊 Matrix por edição SQL Server",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "table",
              "gridSettings": {
                "filter": true
              }
            },
            "name": "matrix_by_edition",
            "customWidth": "33"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type == \"microsoft.hybridcompute/machines/extensions\"\n| where properties.publisher =~ \"Microsoft.AzureData\"\n| where tostring(properties.type) in (\"WindowsAgent.SqlServer\", \"LinuxAgent.SqlServer\")\n| extend hostId = tolower(substring(id, 0, indexof(id, \"/extensions\")))\n| extend licenseTypeRaw = tostring(properties.settings.LicenseType)\n| extend esuRaw = tostring(properties.settings.enableExtendedSecurityUpdates)\n| extend extState = tostring(properties.provisioningState)\n| where resourceGroup in~ ({ResourceGroup})\n| project hostId, licenseTypeRaw, esuRaw, extState\n| join kind=inner (\n    resources\n    | where type == \"microsoft.hybridcompute/machines\"\n    | extend hostId = tolower(id)\n    | extend logicalCores = toint(properties.detectedProperties.logicalCoreCount)\n    | extend physicalCores = toint(properties.detectedProperties.coreCount)\n    | project hostId, machineName = name, logicalCores, physicalCores, arcStatus = tostring(properties.status)\n) on hostId\n| join kind=leftouter (\n    resources\n    | where type == \"microsoft.azurearcdata/sqlserverinstances\"\n    | where resourceGroup in~ ({ResourceGroup})\n    | extend hostId = tolower(tostring(properties.containerResourceId))\n    | extend edition = tostring(properties.edition)\n    | extend instLicType = tostring(properties.licenseType)\n    | extend sqlVersion = tostring(properties.version)\n    | extend sqlVcores = toint(properties.vCore)\n    | extend SQLVersionMajor = case(sqlVersion has \"SQL Server 2014\" or sqlVersion startswith \"12.\", \"SQL Server 2014\", sqlVersion has \"SQL Server 2016\" or sqlVersion startswith \"13.\", \"SQL Server 2016\", sqlVersion has \"SQL Server 2017\" or sqlVersion startswith \"14.\", \"SQL Server 2017\", sqlVersion has \"SQL Server 2019\" or sqlVersion startswith \"15.\", \"SQL Server 2019\", sqlVersion has \"SQL Server 2022\" or sqlVersion startswith \"16.\", \"SQL Server 2022\", sqlVersion has \"SQL Server 2025\" or sqlVersion startswith \"17.\", \"SQL Server 2025\", \"Não identificado\")\n    | extend isSQLServerESUVersion = SQLVersionMajor in (\"SQL Server 2014\", \"SQL Server 2016\")\n    | extend editionRank = case(edition has \"Enterprise\", 6, edition has \"Standard\", 5, edition has \"Web\", 4, edition has \"Express\", 3, edition has \"Developer\", 2, edition has \"Evaluation\", 1, 0)\n    | summarize topRank = max(editionRank), ativos = countif(instLicType !~ \"HADR\"), qtdSQLServerESU = countif(isSQLServerESUVersion), versoesSQL = make_set(SQLVersionMajor, 20), instancias=count(), vCoreInstanciaTotal=sum(sqlVcores) by hostId\n) on hostId\n| extend topEdition = case(topRank == 6, \"Enterprise\", topRank == 5, \"Standard\", topRank == 4, \"Web\", topRank == 3, \"Express\", topRank == 2, \"Developer\", topRank == 1, \"Evaluation\", \"Sem instância\")\n| extend ed3 = case(topEdition == \"Enterprise\", \"Ent\", topEdition == \"Standard\", \"Std\", topEdition == \"Web\", \"Web\", topEdition == \"Express\", \"Exp\", topEdition)\n| extend isFreeEdition = topEdition in (\"Developer\", \"Evaluation\", \"Express\")\n| extend isPassivo = (topRank > 0 and ativos == 0)\n| extend hasSQLServerESUVersion = qtdSQLServerESU > 0\n| extend coresDetectados = coalesce(logicalCores, physicalCores, 0)\n| extend coresHost = iff(coresDetectados < 4, 4, coresDetectados)\n| extend CoresConsideradosAnalise = case(topEdition == \"Sem instância\", 0, isFreeEdition, 0, isPassivo and licenseTypeRaw in (\"Paid\", \"PAYG\"), 0, isempty(licenseTypeRaw), 0, coresHost)\n| extend coresPAYG = iff(CoresConsideradosAnalise > 0 and licenseTypeRaw == \"PAYG\", coresHost, 0)\n| extend coresPaid = iff(CoresConsideradosAnalise > 0 and licenseTypeRaw == \"Paid\", coresHost, 0)\n| extend coresLicenseOnlyComAnalise = iff(CoresConsideradosAnalise > 0 and licenseTypeRaw == \"LicenseOnly\", coresHost, 0)\n| extend coresNaoConsiderados = case(isFreeEdition, coresHost, isPassivo and licenseTypeRaw in (\"Paid\", \"PAYG\"), coresHost, 0)\n| extend LicenseType = iff(isempty(licenseTypeRaw), \"Pendente\", licenseTypeRaw)\n| summarize Hosts=dcount(hostId), Instancias=sum(instancias), Edicoes=make_set(topEdition, 20), vCoreInstancia=sum(vCoreInstanciaTotal), CoresConsideradosAnalise=sum(CoresConsideradosAnalise) by LicenseType\n| order by Hosts desc",
              "size": 0,
              "title": "📊 Matrix por LicenseType",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "table",
              "gridSettings": {
                "filter": true
              }
            },
            "name": "matrix_by_license",
            "customWidth": "33"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type == \"microsoft.azurearcdata/sqlserverinstances\"\n| where resourceGroup in~ ({ResourceGroup})\n| extend hostId = tolower(tostring(properties.containerResourceId))\n| extend sqlVersion = tostring(properties.version)\n| extend SQLVersionMajor = case(sqlVersion has \"SQL Server 2014\" or sqlVersion startswith \"12.\", \"SQL Server 2014\", sqlVersion has \"SQL Server 2016\" or sqlVersion startswith \"13.\", \"SQL Server 2016\", sqlVersion has \"SQL Server 2017\" or sqlVersion startswith \"14.\", \"SQL Server 2017\", sqlVersion has \"SQL Server 2019\" or sqlVersion startswith \"15.\", \"SQL Server 2019\", sqlVersion has \"SQL Server 2022\" or sqlVersion startswith \"16.\", \"SQL Server 2022\", sqlVersion has \"SQL Server 2025\" or sqlVersion startswith \"17.\", \"SQL Server 2025\", \"Não identificado\")\n| summarize Instancias=count(), Hosts=dcount(hostId) by SQLVersionMajor\n| join kind=leftouter (\n    resources\n    | where type == \"microsoft.azurearcdata/sqlserverinstances\"\n    | where resourceGroup in~ ({ResourceGroup})\n    | extend hostId = tolower(tostring(properties.containerResourceId))\n    | extend sqlVersion = tostring(properties.version)\n    | extend SQLVersionMajor = case(sqlVersion has \"SQL Server 2014\" or sqlVersion startswith \"12.\", \"SQL Server 2014\", sqlVersion has \"SQL Server 2016\" or sqlVersion startswith \"13.\", \"SQL Server 2016\", \"Other\")\n    | where SQLVersionMajor in (\"SQL Server 2014\", \"SQL Server 2016\")\n    | summarize by SQLVersionMajor, hostId\n    | join kind=leftouter (\n        resources\n        | where type == \"microsoft.hybridcompute/machines/extensions\"\n        | where properties.publisher =~ \"Microsoft.AzureData\"\n        | where tostring(properties.type) in (\"WindowsAgent.SqlServer\", \"LinuxAgent.SqlServer\")\n        | extend hostId = tolower(substring(id, 0, indexof(id, \"/extensions\")))\n        | extend esuRaw = tostring(properties.settings.enableExtendedSecurityUpdates)\n        | project hostId, esuRaw\n    ) on hostId\n    | summarize HostsESUHabilitado=dcountif(hostId, esuRaw =~ \"true\"), HostsESUNaoHabilitado=dcountif(hostId, esuRaw !~ \"true\" or isempty(esuRaw)) by SQLVersionMajor\n) on SQLVersionMajor\n| extend AplicabilidadeESU = iff(SQLVersionMajor in (\"SQL Server 2014\", \"SQL Server 2016\"), \"Aplicável\", \"Não aplicável\")\n| project SQLVersionMajor, Instancias, Hosts, AplicabilidadeESU, HostsESUHabilitado=coalesce(HostsESUHabilitado,0), HostsESUNaoHabilitado=coalesce(HostsESUNaoHabilitado,0)\n| order by SQLVersionMajor asc",
              "size": 0,
              "title": "🛡️ SQL Server ESU readiness",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "table",
              "gridSettings": {
                "filter": true
              }
            },
            "name": "esu_readiness",
            "customWidth": "34"
          }
        ]
      },
      "name": "analysis_matrices",
      "conditionalVisibility": {
        "parameterName": "SelectedTab",
        "comparison": "isEqualTo",
        "value": "Licenciamento"
      }
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type =~ \"microsoft.hybridcompute/machines/extensions\"\n| where tostring(properties.publisher) =~ \"Microsoft.AzureData\"\n| where tostring(properties.type) in (\"WindowsAgent.SqlServer\",\"LinuxAgent.SqlServer\")\n| where resourceGroup in~ ({ResourceGroup})\n| extend HostId = tolower(substring(id, 0, indexof(id, \"/extensions\")))\n| extend Host = tostring(split(id, \"/\")[8])\n| extend LicenseType = tostring(properties.settings.LicenseType)\n| extend SQLServerESU = case(tostring(properties.settings.enableExtendedSecurityUpdates) =~ \"true\", \"Enabled\", tostring(properties.settings.enableExtendedSecurityUpdates) =~ \"false\", \"Not enabled\", \"Not reported\")\n| extend ExtensionState = tostring(properties.provisioningState)\n| project HostId, Host, LicenseType, SQLServerESU, ExtensionState, ResourceGroup = tostring(resourceGroup), SubscriptionId = tostring(subscriptionId)\n| join kind=leftouter (\n    resources\n    | where type =~ \"microsoft.hybridcompute/machines\"\n    | where resourceGroup in~ ({ResourceGroup})\n    | extend HostId = tolower(id)\n    | extend ArcStatus = tostring(properties.status)\n    | extend LogicalCoreCount = toint(properties.detectedProperties.logicalCoreCount)\n    | extend PhysicalCoreCount = toint(properties.detectedProperties.coreCount)\n    | extend CoresDetectados = coalesce(LogicalCoreCount, PhysicalCoreCount, 0)\n    | extend CoresHost = iff(CoresDetectados < 4, 4, CoresDetectados)\n    | project HostId, ArcStatus, LogicalCoreCount, PhysicalCoreCount, CoresHost\n) on HostId\n| join kind=leftouter (\n    resources\n    | where type =~ \"microsoft.azurearcdata/sqlserverinstances\"\n    | where resourceGroup in~ ({ResourceGroup})\n    | extend HostId = tolower(tostring(properties.containerResourceId))\n    | extend EdicaoSQL = tostring(properties.edition)\n    | extend InstanceLicenseType = tostring(properties.licenseType)\n    | extend SQLVersion = tostring(properties.version)\n    | extend SQLVersionMajor = case(SQLVersion has \"SQL Server 2014\" or SQLVersion startswith \"12.\", \"SQL Server 2014\", SQLVersion has \"SQL Server 2016\" or SQLVersion startswith \"13.\", \"SQL Server 2016\", SQLVersion has \"SQL Server 2017\" or SQLVersion startswith \"14.\", \"SQL Server 2017\", SQLVersion has \"SQL Server 2019\" or SQLVersion startswith \"15.\", \"SQL Server 2019\", SQLVersion has \"SQL Server 2022\" or SQLVersion startswith \"16.\", \"SQL Server 2022\", SQLVersion has \"SQL Server 2025\" or SQLVersion startswith \"17.\", \"SQL Server 2025\", \"Não identificado\")\n    | extend VCoreInstancia = toint(properties.vCore)\n    | extend EditionRank = case(EdicaoSQL has \"Enterprise\", 6, EdicaoSQL has \"Standard\", 5, EdicaoSQL has \"Web\", 4, EdicaoSQL has \"Express\", 3, EdicaoSQL has \"Developer\", 2, EdicaoSQL has \"Evaluation\", 1, 0)\n    | summarize InstanciasSQL = count(), InstanciasAtivas = countif(InstanceLicenseType !~ \"HADR\"), EditionRank = max(EditionRank), EdicoesRaw = make_set(EdicaoSQL, 20), VersoesRaw = make_set(SQLVersionMajor, 20), InstanceLicenseTypesRaw = make_set(InstanceLicenseType, 20), vCoreInstanciaTotal = sum(VCoreInstancia) by HostId\n) on HostId\n| extend EdicaoMaisAlta = case(EditionRank == 6, \"Enterprise\", EditionRank == 5, \"Standard\", EditionRank == 4, \"Web\", EditionRank == 3, \"Express\", EditionRank == 2, \"Developer\", EditionRank == 1, \"Evaluation\", \"Não identificado\")\n| extend EdicoesSQL = tostring(EdicoesRaw), VersoesSQL = tostring(VersoesRaw), LicenseTypesInstancia = tostring(InstanceLicenseTypesRaw)\n| extend IsFreeEdition = EdicaoMaisAlta in (\"Developer\",\"Evaluation\",\"Express\")\n| extend IsPassivoHADR = coalesce(InstanciasSQL, 0) > 0 and coalesce(InstanciasAtivas, 0) == 0\n| extend CoresConsideradosAnalise = case(coalesce(InstanciasSQL, 0) == 0, 0, IsFreeEdition, 0, IsPassivoHADR and LicenseType in (\"Paid\",\"PAYG\"), 0, isempty(LicenseType), 0, CoresHost)\n| extend ClassificacaoWorkbook = case(isempty(LicenseType), \"LicenseType pendente\", IsFreeEdition, \"Edição gratuita / avaliação\", IsPassivoHADR, \"Somente HA/DR reportado\", LicenseType == \"PAYG\", \"Configuração PAYG\", LicenseType == \"Paid\", \"Configuração Paid\", LicenseType == \"LicenseOnly\", \"Configuração LicenseOnly\", \"Configuração reportada\")\n| extend InterpretacaoConfiguracao = case(isempty(LicenseType), \"Revisar configuração da extensão SQL Server\", IsFreeEdition, \"Cores não considerados na análise\", IsPassivoHADR, \"Cores não considerados na análise HA/DR\", CoresConsideradosAnalise > 0, \"Cores considerados na análise técnica\", \"Sem cores considerados\")\n| project Host, ArcStatus, ExtensionState, LicenseType, SQLServerESU, EdicaoMaisAlta, EdicoesSQL, VersoesSQL, LicenseTypesInstancia, InstanciasSQL, vCoreInstanciaTotal, LogicalCoreCount, PhysicalCoreCount, CoresHost, CoresConsideradosAnalise, ClassificacaoWorkbook, InterpretacaoConfiguracao, ResourceGroup, SubscriptionId\n| order by Host asc",
              "size": 0,
              "title": "🧾 Análise Técnica SQL Server por Host/OSE",
              "noDataMessage": "Nenhum host SQL Server enabled by Azure Arc com extensão SQL Server no escopo selecionado.",
              "noDataMessageStyle": 3,
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "table",
              "gridSettings": {
                "filter": true,
                "formatters": [
                  {
                    "columnMatch": "CoresConsideradosAnalise",
                    "formatter": 8,
                    "formatOptions": {
                      "palette": "red"
                    }
                  },
                  {
                    "columnMatch": "CoresHost",
                    "formatter": 8,
                    "formatOptions": {
                      "palette": "blue"
                    }
                  }
                ]
              }
            },
            "customWidth": "70",
            "name": "trueup_table"
          },
          {
            "type": 1,
            "content": {
              "json": "### Como ler a tabela\n\n**Host/OSE** é o servidor físico ou máquina virtual que hospeda uma ou mais instâncias SQL Server. Esta visão é consolidada por host, não por instância individual.\n\n| Campo | Leitura |\n| --- | --- |\n| **LicenseType** | valor reportado pela Azure Extension for SQL Server: `Paid`, `PAYG`, `LicenseOnly` ou pendente. Representa configuração técnica observada, não uma validação final de licenciamento contratual. |\n| **CoresConsideradosAnalise** | estimativa técnica calculada pelo workbook para apoiar análise de configuração SQL Server por host/OSE. Não substitui Product Terms, contrato, billing real ou avaliação SAM oficial. |\n| **CoresHost** | cores reportados pelo host via Azure Arc, usando `logicalCoreCount` ou `coreCount`, com mínimo de 4 aplicado no cálculo auxiliar. |\n| **ClassificacaoWorkbook** | classificação auxiliar calculada pelo workbook com base em edição, LicenseType e estado HA/DR reportado. É um rótulo de análise técnica, não uma conclusão legal/comercial. |\n| **InterpretacaoConfiguracao** | leitura auxiliar da configuração reportada, não uma linha de fatura nem uma confirmação de conformidade. |\n| **SQLServerESU** | estado da configuração de Extended Security Updates do SQL Server quando a versão é SQL Server 2014 ou SQL Server 2016. |\n| **VersoesSQL** | versões principais identificadas nas instâncias SQL Server do host. |\n\n**Nota:** a configuração `UsePhysicalCoreLicense` é documentada para cenários específicos, mas não foi mantida como coluna/KPI principal porque pode aparecer vazia em consultas de Azure Resource Graph em alguns ambientes. A query de validação está na aba **Referências**. O workbook é um inventário técnico e suporte de análise, e não um atestado de licenciamento final."
            },
            "name": "trueup_legend",
            "customWidth": "30"
          }
        ]
      },
      "name": "trueup_detail",
      "conditionalVisibility": {
        "parameterName": "SelectedTab",
        "comparison": "isEqualTo",
        "value": "Licenciamento"
      }
    },
    {
      "type": 1,
      "content": {
        "json": "---\n## 📊 Capacidade Técnica das Instâncias SQL Server\n**Visão técnica de `properties.vCore` por instância SQL Server. Não representa fatura, AHB, PAYG, true-up ou ACR.**"
      },
      "name": "distribution_header",
      "conditionalVisibility": {
        "parameterName": "SelectedTab",
        "comparison": "isEqualTo",
        "value": "Inventario"
      }
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type == \"microsoft.azurearcdata/sqlserverinstances\"\n| where resourceGroup in~ ({ResourceGroup})\n| extend sqlEdition = tostring(properties.edition)\n| extend sqlVcores = toint(properties.vCore)\n| where isnotempty(sqlEdition)\n| summarize VCoreInstancias = sum(sqlVcores) by sqlEdition\n| order by VCoreInstancias desc",
              "size": 4,
              "title": "💻 vCores por edição SQL Server (instâncias)",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "tiles",
              "tileSettings": {
                "titleContent": {
                  "columnMatch": "sqlEdition",
                  "formatter": 1
                },
                "leftContent": {
                  "columnMatch": "VCoreInstancias",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "blue"
                  }
                },
                "showBorder": true,
                "size": "small"
              }
            },
            "customWidth": "50",
            "name": "vcores_by_edition"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type == \"microsoft.hybridcompute/machines/extensions\"\n| where properties.publisher =~ \"Microsoft.AzureData\"\n| where tostring(properties.type) in (\"WindowsAgent.SqlServer\", \"LinuxAgent.SqlServer\")\n| extend hostId = tolower(substring(id, 0, indexof(id, \"/extensions\")))\n| extend licenseTypeRaw = tostring(properties.settings.LicenseType)\n| where resourceGroup in~ ({ResourceGroup})\n| join kind=leftouter (\n    resources\n    | where type == \"microsoft.azurearcdata/sqlserverinstances\"\n    | where resourceGroup in~ ({ResourceGroup})\n    | extend hostId = tolower(tostring(properties.containerResourceId))\n    | extend sqlVcores = toint(properties.vCore)\n    | project hostId, sqlVcores\n) on hostId\n| extend LicenseType = case(licenseTypeRaw == \"PAYG\", \"PAYG\", licenseTypeRaw == \"Paid\", \"Paid\", licenseTypeRaw == \"LicenseOnly\", \"LicenseOnly\", isempty(licenseTypeRaw), \"Pendente\", licenseTypeRaw)\n| summarize VCoreInstancias = sum(sqlVcores) by LicenseType\n| order by VCoreInstancias desc",
              "size": 4,
              "title": "💳 vCores por LicenseType (instâncias)",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "tiles",
              "tileSettings": {
                "titleContent": {
                  "columnMatch": "LicenseType",
                  "formatter": 1
                },
                "leftContent": {
                  "columnMatch": "VCoreInstancias",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "yellow"
                  }
                },
                "showBorder": true,
                "size": "small"
              }
            },
            "customWidth": "50",
            "name": "vcores_by_license"
          }
        ]
      },
      "name": "capacity_group",
      "conditionalVisibility": {
        "parameterName": "SelectedTab",
        "comparison": "isEqualTo",
        "value": "Inventario"
      }
    },
    {
      "type": 1,
      "content": {
        "json": "---\n## 📋 Inventário Técnico de Instâncias SQL Server\n**Registro por instância para auditoria técnica de versão, edição, modelo SQL Server, LicenseType e SQL Server ESU.**"
      },
      "name": "inventory_header",
      "conditionalVisibility": {
        "parameterName": "SelectedTab",
        "comparison": "isEqualTo",
        "value": "Inventario"
      }
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type == \"microsoft.hybridcompute/machines\"\n| extend arcStatus = case(tolower(properties.status) == \"connected\", \"Connected\", tolower(properties.status) == \"disconnected\", \"Offline\", tolower(properties.status) == \"error\", \"Error\", tolower(properties.status) == \"expired\", \"Expired\", \"Unknown\")\n| extend joinId = tolower(id)\n| join kind = leftouter (\n    resources\n    | where type == \"microsoft.azurearcdata/sqlserverinstances\"\n    | extend arcMachineId = tolower(tostring(properties.containerResourceId))\n    | extend sqlVersion = tostring(properties.version)\n    | extend SQLVersionMajor = case(sqlVersion has \"SQL Server 2014\" or sqlVersion startswith \"12.\", \"SQL Server 2014\", sqlVersion has \"SQL Server 2016\" or sqlVersion startswith \"13.\", \"SQL Server 2016\", sqlVersion has \"SQL Server 2017\" or sqlVersion startswith \"14.\", \"SQL Server 2017\", sqlVersion has \"SQL Server 2019\" or sqlVersion startswith \"15.\", \"SQL Server 2019\", sqlVersion has \"SQL Server 2022\" or sqlVersion startswith \"16.\", \"SQL Server 2022\", sqlVersion has \"SQL Server 2025\" or sqlVersion startswith \"17.\", \"SQL Server 2025\", \"Não identificado\")\n    | extend sqlVcores = toint(properties.vCore)\n    | extend sqlEdition = tostring(properties.edition)\n    | extend sqlInstanceName = name\n    | extend sqlModel = tostring(properties.licenseType)\n    | project arcMachineId, sqlInstanceName, sqlVersion, SQLVersionMajor, sqlEdition, sqlVcores, sqlModel\n) on $left.joinId == $right.arcMachineId\n| join kind = leftouter (\n    resources\n    | where type == \"microsoft.hybridcompute/machines/extensions\"\n    | where properties.publisher =~ \"Microsoft.AzureData\"\n    | where tostring(properties.type) in (\"WindowsAgent.SqlServer\", \"LinuxAgent.SqlServer\")\n    | extend extMachineId = tolower(substring(id, 0, indexof(id, \"/extensions\")))\n    | extend licenseTypeRaw = tostring(properties.settings.LicenseType)\n    | extend esuRaw = tostring(properties.settings.enableExtendedSecurityUpdates)\n        | extend extStateRaw = tostring(properties.provisioningState)\n    | project extMachineId, licenseTypeRaw, esuRaw, extStateRaw\n) on $left.joinId == $right.extMachineId\n| where isnotempty(sqlVersion)\n| where resourceGroup in~ ({ResourceGroup})\n| extend LicenseTypeSQL = case(licenseTypeRaw == \"Paid\", \"Paid\", licenseTypeRaw == \"PAYG\", \"PAYG\", licenseTypeRaw == \"LicenseOnly\", \"LicenseOnly\", \"Pendente\")\n| extend SQLServerESU = case(SQLVersionMajor in (\"SQL Server 2014\", \"SQL Server 2016\") and esuRaw =~ \"true\", \"SQL Server ESU habilitado\", SQLVersionMajor in (\"SQL Server 2014\", \"SQL Server 2016\"), \"SQL Server ESU não habilitado\", \"Não aplicável\")\n| extend ExtensaoSQL = case(extStateRaw =~ \"Succeeded\", \"OK\", extStateRaw =~ \"Failed\", \"Falha\", isempty(extStateRaw), \"Sem extensão\", extStateRaw)\n| extend ModeloSQL = case(sqlModel =~ \"HADR\", \"HA/DR passivo\", sqlModel =~ \"ServerCAL\", \"Server+CAL\", sqlModel =~ \"PerCore\", \"Per-core\", sqlModel =~ \"Free\", \"Free/Eval/Express\", isempty(sqlModel), \"-\", sqlModel)\n| project Host = name, ArcStatus = arcStatus, ExtensaoSQL, InstanciaSQL = sqlInstanceName, VersaoSQL = sqlVersion, SQLVersionMajor, EdicaoSQL = sqlEdition, ModeloSQL, LicenseTypeSQL, SQLServerESU, vCoreInstancia = sqlVcores\n| order by Host asc",
              "size": 0,
              "title": "📋 Registro de Instâncias SQL Server enabled by Azure Arc",
              "noDataMessage": "Nenhuma instância SQL Server enabled by Azure Arc no escopo selecionado.",
              "noDataMessageStyle": 3,
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "table",
              "gridSettings": {
                "filter": true,
                "sortBy": [
                  {
                    "itemKey": "Host",
                    "sortOrder": 1
                  }
                ],
                "formatters": [
                  {
                    "columnMatch": "vCoreInstancia",
                    "formatter": 8,
                    "formatOptions": {
                      "palette": "blue"
                    }
                  }
                ]
              }
            },
            "customWidth": "70",
            "name": "inventory_table"
          },
          {
            "type": 1,
            "content": {
              "json": "### Guia de interpretação\n\n| Coluna | Significado |\n| --- | --- |\n| **Host** | servidor Arc que hospeda a instância SQL Server |\n| **ArcStatus** | estado do Arc-enabled server |\n| **ExtensaoSQL** | estado da extensão SQL Server (`Microsoft.AzureData`) |\n| **SQLVersionMajor** | classificação da versão principal identificada pela string de versão reportada |\n| **LicenseTypeSQL** | `Paid`, `PAYG`, `LicenseOnly` ou pendente. Valor técnico reportado pela extensão; não substitui decisão de licenciamento contratual. |\n| **SQLServerESU** | status de SQL Server ESU para SQL Server 2014/2016; demais versões aparecem fora do escopo |\n| **vCoreInstancia** | capacidade técnica da instância, útil para inventário e análise auxiliar, mas não base isolada para true-up, billing ou conformidade final |\n\n**Ação prática:** validar `ExtensaoSQL != OK`, `LicenseTypeSQL = Pendente`, `LicenseOnly` em hosts com edições Standard/Enterprise e qualquer instância `SQLVersionMajor` igual a SQL Server 2014 ou SQL Server 2016 sem SQL Server ESU habilitado. Esses sinais são úteis para triagem técnica, mas não definem direito contratual ou conclusão final de licenciamento."
            },
            "name": "inventory_legend",
            "customWidth": "30"
          }
        ]
      },
      "name": "inventory_group",
      "conditionalVisibility": {
        "parameterName": "SelectedTab",
        "comparison": "isEqualTo",
        "value": "Inventario"
      }
    },
    {
      "type": 1,
      "content": {
        "json": "## 📡 Saúde operacional como confiança dos dados\n\nEsta aba não substitui o dashboard operacional oficial de SQL Server enabled by Azure Arc. O objetivo aqui é indicar se os dados de inventário, LicenseType, ESU, edição, versão e cores têm boa confiabilidade para análise técnica.\n\n**Interpretação recomendada:** cobertura alta da SQL extension e maior número de extensões saudáveis aumentam a confiança do workbook. Extensões com atenção, máquinas desconectadas, certificados expirados, uploadStatus diferente de OK ou upload antigo reduzem a confiança dos dados, mas não alteram por si só o direito contratual de licenciamento."
      },
      "name": "operational_health_intro",
      "conditionalVisibility": {
        "parameterName": "SelectedTab",
        "comparison": "isEqualTo",
        "value": "SaudeOperacional"
      }
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type =~ \"microsoft.azurearcdata/sqlserverinstances\"\n| where resourceGroup in~ ({ResourceGroup})\n| extend HostId = tolower(tostring(properties.containerResourceId))\n| summarize SQLDiscoveredHosts = dcount(HostId)\n| extend JoinKey = 1\n| join kind=inner (\n    resources\n    | where type =~ \"microsoft.hybridcompute/machines/extensions\"\n    | where resourceGroup in~ ({ResourceGroup})\n    | where tostring(properties.publisher) =~ \"Microsoft.AzureData\"\n    | where tostring(properties.type) in (\"WindowsAgent.SqlServer\",\"LinuxAgent.SqlServer\")\n    | extend HostId = tolower(substring(id, 0, indexof(id, \"/extensions\")))\n    | summarize SQLExtensionHosts = dcount(HostId)\n    | extend JoinKey = 1\n) on JoinKey\n| extend CoveragePct = iff(SQLDiscoveredHosts == 0, 0.0, round(100.0 * todouble(SQLExtensionHosts) / todouble(SQLDiscoveredHosts), 2))\n| extend Metric = \"Cobertura SQL extension (%)\", Value = CoveragePct, Detail = strcat(tostring(SQLExtensionHosts), \" de \", tostring(SQLDiscoveredHosts), \" hosts\")\n| project Metric, Value, Detail",
              "size": 1,
              "title": "Cobertura Azure Arc SQL",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "tiles",
              "tileSettings": {
                "showBorder": false,
                "titleContent": {
                  "columnMatch": "Metric"
                },
                "leftContent": {
                  "columnMatch": "Value",
                  "formatter": 12
                },
                "secondaryContent": {
                  "columnMatch": "Detail"
                }
              }
            },
            "customWidth": "25",
            "name": "op_extension_coverage",
            "conditionalVisibility": {
              "parameterName": "SelectedTab",
              "comparison": "isEqualTo",
              "value": "SaudeOperacional"
            }
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type =~ \"microsoft.hybridcompute/machines/extensions\"\n| where resourceGroup in~ ({ResourceGroup})\n| where tostring(properties.publisher) =~ \"Microsoft.AzureData\"\n| where tostring(properties.type) in (\"WindowsAgent.SqlServer\",\"LinuxAgent.SqlServer\")\n| extend ExtensionResourceID = tostring(id)\n| extend targetMachineName = tolower(tostring(split(id, \"/\")[8]))\n| extend ExtensionProvisioningState = tostring(properties.provisioningState)\n| extend LicenseType = tostring(properties.settings.LicenseType)\n| extend Message = tostring(properties.instanceView.status.message)\n| extend LastReportedExtensionHealth = iff(isempty(Message), \"Unhealthy\", iff(Message contains \"Healthy\", \"Healthy\", \"Unhealthy\"))\n| extend LastExtensionUploadStatus = iff(isempty(Message), \"Unhealthy\", iff(Message contains \"uploadStatus : OK\" or Message contains \"uploadStatus: OK\" or Message contains \"uploadStatus OK\" or Message contains \"uploadStatus:OK\", \"OK\", \"Unhealthy\"))\n| extend LastExtensionUploadTimestamp = coalesce(extract(\"timestampUTC : ([0-9]{4}[/-][0-9]{2}[/-][0-9]{2})\", 1, Message), extract(\"timestampUTC: ([0-9]{4}[/-][0-9]{2}[/-][0-9]{2})\", 1, Message))\n| extend LastExtensionUploadDate = todatetime(strcat(replace_string(LastExtensionUploadTimestamp, \"/\", \"-\"), \"T00:00:00Z\"))\n| extend LastUploadOutsideAcceptableRange = isempty(LastExtensionUploadTimestamp) or LastExtensionUploadDate < startofday(ago(3d))\n| join kind=leftouter (\n    resources\n    | where type =~ \"microsoft.hybridcompute/machines\"\n    | where resourceGroup in~ ({ResourceGroup})\n    | extend LowerMachineName = tolower(tostring(name))\n    | project MachineId = tostring(id), MachineName = tostring(name), LowerMachineName, MachineStatus = tostring(properties.status), MachineProvisioningStatus = tostring(properties.provisioningState), MachineErrors = tostring(properties.errorDetails), subscriptionId, resourceGroup, TenantID = tenantId\n) on $left.targetMachineName == $right.LowerMachineName, subscriptionId, resourceGroup\n| extend IsHealthy = MachineStatus =~ \"Connected\" and LastReportedExtensionHealth =~ \"Healthy\" and LastExtensionUploadStatus =~ \"OK\" and ExtensionProvisioningState =~ \"Succeeded\" and LastUploadOutsideAcceptableRange == false\n| extend HealthState = iff(IsHealthy, \"Healthy\", \"Needs attention\")\n| extend FailureReasons = strcat(\n    iif(MachineStatus !~ \"Connected\", strcat(\"Machine status is \", MachineStatus, \"; \"), \"\"),\n    iif(isnotempty(MachineErrors) and MachineErrors != \"[]\", \"Machine reports errors; \", \"\"),\n    iif(LastReportedExtensionHealth !~ \"Healthy\", \"Extension reported unhealthy; \", \"\"),\n    iif(LastUploadOutsideAcceptableRange, \"Last upload outside acceptable range; \", \"\"),\n    iif(LastExtensionUploadStatus !~ \"OK\", \"Upload status not OK; \", \"\"),\n    iif(ExtensionProvisioningState !~ \"Succeeded\", strcat(\"Extension provisioning state is \", ExtensionProvisioningState, \"; \"), \"\")\n)\n| extend RecommendedAction = case(\n    MachineStatus =~ \"Disconnected\", \"Reconnect the Azure Arc machine and validate agent connectivity.\",\n    MachineStatus =~ \"Expired\", \"Renew or repair the Azure Arc machine certificate and reconnect the machine.\",\n    LastExtensionUploadStatus !~ \"OK\", \"Review SQL extension status message, DPS connectivity and extension logs.\",\n    LastUploadOutsideAcceptableRange, \"Validate whether the extension is still uploading inventory and billing data.\",\n    LastReportedExtensionHealth !~ \"Healthy\", \"Review SQL extension status message and failure reasons.\",\n    ExtensionProvisioningState !~ \"Succeeded\", \"Validate SQL extension provisioning state.\",\n    \"No immediate action from this workbook signal.\"\n)\n| project MachineName, MachineStatus, HealthState, LastReportedExtensionHealth, LastExtensionUploadStatus, LastExtensionUploadTimestamp, LicenseType, ExtensionProvisioningState, RecommendedAction, FailureReasons, SubscriptionID = subscriptionId, ResourceGroup = resourceGroup, ExtensionResourceID, MachineId\n| order by HealthState desc, MachineName asc\n| summarize Value = countif(HealthState == \"Healthy\")\n| extend Metric = \"SQL extensions saudáveis\", Detail = \"Sinal de confiança dos dados reportados\"\n| project Metric, Value, Detail",
              "size": 1,
              "title": "SQL extensions saudáveis",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "tiles",
              "tileSettings": {
                "showBorder": false,
                "titleContent": {
                  "columnMatch": "Metric"
                },
                "leftContent": {
                  "columnMatch": "Value",
                  "formatter": 12
                },
                "secondaryContent": {
                  "columnMatch": "Detail"
                }
              }
            },
            "customWidth": "25",
            "name": "op_healthy_extensions",
            "conditionalVisibility": {
              "parameterName": "SelectedTab",
              "comparison": "isEqualTo",
              "value": "SaudeOperacional"
            }
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type =~ \"microsoft.hybridcompute/machines/extensions\"\n| where resourceGroup in~ ({ResourceGroup})\n| where tostring(properties.publisher) =~ \"Microsoft.AzureData\"\n| where tostring(properties.type) in (\"WindowsAgent.SqlServer\",\"LinuxAgent.SqlServer\")\n| extend ExtensionResourceID = tostring(id)\n| extend targetMachineName = tolower(tostring(split(id, \"/\")[8]))\n| extend ExtensionProvisioningState = tostring(properties.provisioningState)\n| extend LicenseType = tostring(properties.settings.LicenseType)\n| extend Message = tostring(properties.instanceView.status.message)\n| extend LastReportedExtensionHealth = iff(isempty(Message), \"Unhealthy\", iff(Message contains \"Healthy\", \"Healthy\", \"Unhealthy\"))\n| extend LastExtensionUploadStatus = iff(isempty(Message), \"Unhealthy\", iff(Message contains \"uploadStatus : OK\" or Message contains \"uploadStatus: OK\" or Message contains \"uploadStatus OK\" or Message contains \"uploadStatus:OK\", \"OK\", \"Unhealthy\"))\n| extend LastExtensionUploadTimestamp = coalesce(extract(\"timestampUTC : ([0-9]{4}[/-][0-9]{2}[/-][0-9]{2})\", 1, Message), extract(\"timestampUTC: ([0-9]{4}[/-][0-9]{2}[/-][0-9]{2})\", 1, Message))\n| extend LastExtensionUploadDate = todatetime(strcat(replace_string(LastExtensionUploadTimestamp, \"/\", \"-\"), \"T00:00:00Z\"))\n| extend LastUploadOutsideAcceptableRange = isempty(LastExtensionUploadTimestamp) or LastExtensionUploadDate < startofday(ago(3d))\n| join kind=leftouter (\n    resources\n    | where type =~ \"microsoft.hybridcompute/machines\"\n    | where resourceGroup in~ ({ResourceGroup})\n    | extend LowerMachineName = tolower(tostring(name))\n    | project MachineId = tostring(id), MachineName = tostring(name), LowerMachineName, MachineStatus = tostring(properties.status), MachineProvisioningStatus = tostring(properties.provisioningState), MachineErrors = tostring(properties.errorDetails), subscriptionId, resourceGroup, TenantID = tenantId\n) on $left.targetMachineName == $right.LowerMachineName, subscriptionId, resourceGroup\n| extend IsHealthy = MachineStatus =~ \"Connected\" and LastReportedExtensionHealth =~ \"Healthy\" and LastExtensionUploadStatus =~ \"OK\" and ExtensionProvisioningState =~ \"Succeeded\" and LastUploadOutsideAcceptableRange == false\n| extend HealthState = iff(IsHealthy, \"Healthy\", \"Needs attention\")\n| extend FailureReasons = strcat(\n    iif(MachineStatus !~ \"Connected\", strcat(\"Machine status is \", MachineStatus, \"; \"), \"\"),\n    iif(isnotempty(MachineErrors) and MachineErrors != \"[]\", \"Machine reports errors; \", \"\"),\n    iif(LastReportedExtensionHealth !~ \"Healthy\", \"Extension reported unhealthy; \", \"\"),\n    iif(LastUploadOutsideAcceptableRange, \"Last upload outside acceptable range; \", \"\"),\n    iif(LastExtensionUploadStatus !~ \"OK\", \"Upload status not OK; \", \"\"),\n    iif(ExtensionProvisioningState !~ \"Succeeded\", strcat(\"Extension provisioning state is \", ExtensionProvisioningState, \"; \"), \"\")\n)\n| extend RecommendedAction = case(\n    MachineStatus =~ \"Disconnected\", \"Reconnect the Azure Arc machine and validate agent connectivity.\",\n    MachineStatus =~ \"Expired\", \"Renew or repair the Azure Arc machine certificate and reconnect the machine.\",\n    LastExtensionUploadStatus !~ \"OK\", \"Review SQL extension status message, DPS connectivity and extension logs.\",\n    LastUploadOutsideAcceptableRange, \"Validate whether the extension is still uploading inventory and billing data.\",\n    LastReportedExtensionHealth !~ \"Healthy\", \"Review SQL extension status message and failure reasons.\",\n    ExtensionProvisioningState !~ \"Succeeded\", \"Validate SQL extension provisioning state.\",\n    \"No immediate action from this workbook signal.\"\n)\n| project MachineName, MachineStatus, HealthState, LastReportedExtensionHealth, LastExtensionUploadStatus, LastExtensionUploadTimestamp, LicenseType, ExtensionProvisioningState, RecommendedAction, FailureReasons, SubscriptionID = subscriptionId, ResourceGroup = resourceGroup, ExtensionResourceID, MachineId\n| order by HealthState desc, MachineName asc\n| summarize Value = countif(HealthState != \"Healthy\")\n| extend Metric = \"SQL extensions com atenção\", Detail = \"Indica risco de dados incompletos ou desatualizados\"\n| project Metric, Value, Detail",
              "size": 1,
              "title": "SQL extensions com atenção",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
