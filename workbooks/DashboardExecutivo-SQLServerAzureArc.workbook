    {
      "type": 1,
      "content": {
        "json": "## 📊 KPIs Técnicos de SQL Server enabled by Azure Arc\n**Inventário SQL Server e posicionamento técnico de configuração. KPIs por host usam contagem distinta para evitar dupla contagem por múltiplas instâncias.**"
      },
      "name": "metrics_header",
      "conditionalVisibility": {
        "parameterName": "SelectedTab",
        "comparison": "isEqualTo",
        "value": "VisaoGeral"
      }
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type == \"microsoft.hybridcompute/machines\"\n| extend joinId = tolower(id)\n| join kind=inner (\n    resources\n    | where type == \"microsoft.azurearcdata/sqlserverinstances\"\n    | extend arcMachineId = tolower(tostring(properties.containerResourceId))\n    | distinct arcMachineId\n) on $left.joinId == $right.arcMachineId\n| where resourceGroup in~ ({ResourceGroup})\n| summarize HostsSQL = dcount(joinId)",
              "size": 4,
              "title": "🏢 Hosts SQL Server",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "tiles",
              "tileSettings": {
                "leftContent": {
                  "columnMatch": "HostsSQL",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "green"
                  }
                },
                "showBorder": true,
                "size": "small"
              }
            },
            "customWidth": "9",
            "name": "kpi_machines"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type == \"microsoft.azurearcdata/sqlserverinstances\"\n| where resourceGroup in~ ({ResourceGroup})\n| summarize InstanciasSQL = count()",
              "size": 4,
              "title": "⚙️ Instâncias SQL Server",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "tiles",
              "tileSettings": {
                "leftContent": {
                  "columnMatch": "InstanciasSQL",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "orange"
                  }
                },
                "showBorder": true,
                "size": "small"
              }
            },
            "customWidth": "9",
            "name": "kpi_instances"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type == \"microsoft.hybridcompute/machines/extensions\"\n| where properties.publisher =~ \"Microsoft.AzureData\"\n| where tostring(properties.type) in (\"WindowsAgent.SqlServer\", \"LinuxAgent.SqlServer\")\n| extend hostId = tolower(substring(id, 0, indexof(id, \"/extensions\")))\n| extend licenseTypeRaw = tostring(properties.settings.LicenseType)\n| extend esuRaw = tostring(properties.settings.enableExtendedSecurityUpdates)\n| extend pcoreRaw = tostring(properties.settings.UsePhysicalCoreLicense.IsApplied)\n| extend extState = tostring(properties.provisioningState)\n| where resourceGroup in~ ({ResourceGroup})\n| project hostId, licenseTypeRaw, esuRaw, pcoreRaw, extState\n| join kind=inner (\n    resources\n    | where type == \"microsoft.hybridcompute/machines\"\n    | extend hostId = tolower(id)\n    | extend logicalCores = toint(properties.detectedProperties.logicalCoreCount)\n    | extend physicalCores = toint(properties.detectedProperties.coreCount)\n    | project hostId, machineName = name, logicalCores, physicalCores\n) on hostId\n| join kind=leftouter (\n    resources\n    | where type == \"microsoft.azurearcdata/sqlserverinstances\"\n    | extend hostId = tolower(tostring(properties.containerResourceId))\n    | extend edition = tostring(properties.edition)\n    | extend instLicType = tostring(properties.licenseType)\n    | extend sqlVersion = tostring(properties.version)\n    | extend SQLVersionMajor = case(sqlVersion has \"SQL Server 2014\" or sqlVersion startswith \"12.\", \"SQL Server 2014\", sqlVersion has \"SQL Server 2016\" or sqlVersion startswith \"13.\", \"SQL Server 2016\", sqlVersion has \"SQL Server 2017\" or sqlVersion startswith \"14.\", \"SQL Server 2017\", sqlVersion has \"SQL Server 2019\" or sqlVersion startswith \"15.\", \"SQL Server 2019\", sqlVersion has \"SQL Server 2022\" or sqlVersion startswith \"16.\", \"SQL Server 2022\", sqlVersion has \"SQL Server 2025\" or sqlVersion startswith \"17.\", \"SQL Server 2025\", \"Não identificado\")\n    | extend isSQLServerESUVersion = SQLVersionMajor in (\"SQL Server 2014\", \"SQL Server 2016\")\n    | extend editionRank = case(edition has \"Enterprise\", 6, edition has \"Standard\", 5, edition has \"Web\", 4, edition has \"Express\", 3, edition has \"Developer\", 2, edition has \"Evaluation\", 1, 0)\n    | summarize topRank = max(editionRank), ativos = countif(instLicType !~ \"HADR\"), qtdSQLServerESU = countif(isSQLServerESUVersion), versoesSQL = make_set(SQLVersionMajor, 20) by hostId\n) on hostId\n| extend topEdition = case(topRank == 6, \"Enterprise\", topRank == 5, \"Standard\", topRank == 4, \"Web\", topRank == 3, \"Express\", topRank == 2, \"Developer\", topRank == 1, \"Evaluation\", \"Sem instância\")\n| extend ed3 = case(topEdition == \"Enterprise\", \"Ent\", topEdition == \"Standard\", \"Std\", topEdition == \"Web\", \"Web\", topEdition == \"Express\", \"Exp\", topEdition)\n| extend isFreeEdition = topEdition in (\"Developer\", \"Evaluation\", \"Express\")\n| extend isPassivo = (topRank > 0 and ativos == 0)\n| extend hasSQLServerESUVersion = qtdSQLServerESU > 0\n| extend coresDetectados = coalesce(logicalCores, physicalCores, 0)\n| extend coresHost = iff(coresDetectados < 4, 4, coresDetectados)\n| extend coresLicencaEstimados = case(topEdition == \"Sem instância\", 0, isFreeEdition, 0, isPassivo and licenseTypeRaw in (\"Paid\", \"PAYG\"), 0, isempty(licenseTypeRaw), 0, coresHost)\n| extend coresPAYG = iff(coresLicencaEstimados > 0 and licenseTypeRaw == \"PAYG\", coresHost, 0)\n| extend coresPaid = iff(coresLicencaEstimados > 0 and licenseTypeRaw == \"Paid\", coresHost, 0)\n| extend coresLicenseOnlyComLicenciamento = iff(coresLicencaEstimados > 0 and licenseTypeRaw == \"LicenseOnly\", coresHost, 0)\n| extend coresRZero = case(isFreeEdition, coresHost, isPassivo and licenseTypeRaw in (\"Paid\", \"PAYG\"), coresHost, 0)\n| summarize CoresLicenciamentoSQLEstimado = sum(coresLicencaEstimados)",
              "size": 4,
              "title": "📌 Cores de licenciamento SQL (estimado)",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "tiles",
              "tileSettings": {
                "leftContent": {
                  "columnMatch": "CoresLicenciamentoSQLEstimado",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "purple"
                  }
                },
                "showBorder": true,
                "size": "small"
              }
            },
            "customWidth": "9",
            "name": "kpi_estimated_cores"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type == \"microsoft.hybridcompute/machines/extensions\"\n| where properties.publisher =~ \"Microsoft.AzureData\"\n| where tostring(properties.type) in (\"WindowsAgent.SqlServer\", \"LinuxAgent.SqlServer\")\n| extend hostId = tolower(substring(id, 0, indexof(id, \"/extensions\")))\n| where resourceGroup in~ ({ResourceGroup})\n| summarize HostsPaid = dcountif(hostId, tostring(properties.settings.LicenseType) =~ \"Paid\")",
              "size": 4,
              "title": "🗃️ LicenseType = Paid",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "tiles",
              "tileSettings": {
                "leftContent": {
                  "columnMatch": "HostsPaid",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "blue"
                  }
                },
                "showBorder": true,
                "size": "small"
              }
            },
            "customWidth": "9",
            "name": "kpi_paid_hosts"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type == \"microsoft.hybridcompute/machines/extensions\"\n| where properties.publisher =~ \"Microsoft.AzureData\"\n| where tostring(properties.type) in (\"WindowsAgent.SqlServer\", \"LinuxAgent.SqlServer\")\n| extend hostId = tolower(substring(id, 0, indexof(id, \"/extensions\")))\n| where resourceGroup in~ ({ResourceGroup})\n| summarize HostsPAYG = dcountif(hostId, tostring(properties.settings.LicenseType) =~ \"PAYG\")",
              "size": 4,
              "title": "💰 LicenseType = PAYG",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "tiles",
              "tileSettings": {
                "leftContent": {
                  "columnMatch": "HostsPAYG",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "red"
                  }
                },
                "showBorder": true,
                "size": "small"
              }
            },
            "customWidth": "9",
            "name": "kpi_payg_hosts"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type == \"microsoft.hybridcompute/machines/extensions\"\n| where properties.publisher =~ \"Microsoft.AzureData\"\n| where tostring(properties.type) in (\"WindowsAgent.SqlServer\", \"LinuxAgent.SqlServer\")\n| extend hostId = tolower(substring(id, 0, indexof(id, \"/extensions\")))\n| extend licenseTypeRaw = tostring(properties.settings.LicenseType)\n| extend esuRaw = tostring(properties.settings.enableExtendedSecurityUpdates)\n| extend pcoreRaw = tostring(properties.settings.UsePhysicalCoreLicense.IsApplied)\n| extend extState = tostring(properties.provisioningState)\n| where resourceGroup in~ ({ResourceGroup})\n| project hostId, licenseTypeRaw, esuRaw, pcoreRaw, extState\n| join kind=inner (\n    resources\n    | where type == \"microsoft.hybridcompute/machines\"\n    | extend hostId = tolower(id)\n    | extend logicalCores = toint(properties.detectedProperties.logicalCoreCount)\n    | extend physicalCores = toint(properties.detectedProperties.coreCount)\n    | project hostId, machineName = name, logicalCores, physicalCores\n) on hostId\n| join kind=leftouter (\n    resources\n    | where type == \"microsoft.azurearcdata/sqlserverinstances\"\n    | extend hostId = tolower(tostring(properties.containerResourceId))\n    | extend edition = tostring(properties.edition)\n    | extend instLicType = tostring(properties.licenseType)\n    | extend sqlVersion = tostring(properties.version)\n    | extend SQLVersionMajor = case(sqlVersion has \"SQL Server 2014\" or sqlVersion startswith \"12.\", \"SQL Server 2014\", sqlVersion has \"SQL Server 2016\" or sqlVersion startswith \"13.\", \"SQL Server 2016\", sqlVersion has \"SQL Server 2017\" or sqlVersion startswith \"14.\", \"SQL Server 2017\", sqlVersion has \"SQL Server 2019\" or sqlVersion startswith \"15.\", \"SQL Server 2019\", sqlVersion has \"SQL Server 2022\" or sqlVersion startswith \"16.\", \"SQL Server 2022\", sqlVersion has \"SQL Server 2025\" or sqlVersion startswith \"17.\", \"SQL Server 2025\", \"Não identificado\")\n    | extend isSQLServerESUVersion = SQLVersionMajor in (\"SQL Server 2014\", \"SQL Server 2016\")\n    | extend editionRank = case(edition has \"Enterprise\", 6, edition has \"Standard\", 5, edition has \"Web\", 4, edition has \"Express\", 3, edition has \"Developer\", 2, edition has \"Evaluation\", 1, 0)\n    | summarize topRank = max(editionRank), ativos = countif(instLicType !~ \"HADR\"), qtdSQLServerESU = countif(isSQLServerESUVersion), versoesSQL = make_set(SQLVersionMajor, 20) by hostId\n) on hostId\n| extend topEdition = case(topRank == 6, \"Enterprise\", topRank == 5, \"Standard\", topRank == 4, \"Web\", topRank == 3, \"Express\", topRank == 2, \"Developer\", topRank == 1, \"Evaluation\", \"Sem instância\")\n| extend ed3 = case(topEdition == \"Enterprise\", \"Ent\", topEdition == \"Standard\", \"Std\", topEdition == \"Web\", \"Web\", topEdition == \"Express\", \"Exp\", topEdition)\n| extend isFreeEdition = topEdition in (\"Developer\", \"Evaluation\", \"Express\")\n| extend isPassivo = (topRank > 0 and ativos == 0)\n| extend hasSQLServerESUVersion = qtdSQLServerESU > 0\n| extend coresDetectados = coalesce(logicalCores, physicalCores, 0)\n| extend coresHost = iff(coresDetectados < 4, 4, coresDetectados)\n| extend coresLicencaEstimados = case(topEdition == \"Sem instância\", 0, isFreeEdition, 0, isPassivo and licenseTypeRaw in (\"Paid\", \"PAYG\"), 0, isempty(licenseTypeRaw), 0, coresHost)\n| extend coresPAYG = iff(coresLicencaEstimados > 0 and licenseTypeRaw == \"PAYG\", coresHost, 0)\n| extend coresPaid = iff(coresLicencaEstimados > 0 and licenseTypeRaw == \"Paid\", coresHost, 0)\n| extend coresLicenseOnlyComLicenciamento = iff(coresLicencaEstimados > 0 and licenseTypeRaw == \"LicenseOnly\", coresHost, 0)\n| extend coresRZero = case(isFreeEdition, coresHost, isPassivo and licenseTypeRaw in (\"Paid\", \"PAYG\"), coresHost, 0)\n| summarize HostsLicenseOnlyComLicenciamento = dcountif(hostId, coresLicenseOnlyComLicenciamento > 0)",
              "size": 4,
              "title": "⚠️ LicenseOnly com cores de licenciamento",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "tiles",
              "tileSettings": {
                "leftContent": {
                  "columnMatch": "HostsLicenseOnlyComLicenciamento",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "orange"
                  }
                },
                "showBorder": true,
                "size": "small"
              }
            },
            "customWidth": "9",
            "name": "kpi_licenseonly_billable"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type == \"microsoft.hybridcompute/machines\"\n| extend joinId = tolower(id)\n| join kind=inner (\n    resources\n    | where type == \"microsoft.azurearcdata/sqlserverinstances\"\n    | extend arcMachineId = tolower(tostring(properties.containerResourceId))\n    | distinct arcMachineId\n) on $left.joinId == $right.arcMachineId\n| where resourceGroup in~ ({ResourceGroup})\n| join kind=leftouter (\n    resources\n    | where type == \"microsoft.hybridcompute/machines/extensions\"\n    | where properties.publisher =~ \"Microsoft.AzureData\"\n    | where tostring(properties.type) in (\"WindowsAgent.SqlServer\", \"LinuxAgent.SqlServer\")\n    | extend extMachineId = tolower(substring(id, 0, indexof(id, \"/extensions\")))\n    | project extMachineId\n) on $left.joinId == $right.extMachineId\n| summarize CoveragePct = round(100.0 * dcountif(joinId, isnotempty(extMachineId)) / dcount(joinId), 1)",
              "size": 4,
              "title": "🧩 Coverage Extensão SQL",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "tiles",
              "tileSettings": {
                "leftContent": {
                  "columnMatch": "CoveragePct",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "blue"
                  }
                },
                "showBorder": true,
                "size": "small"
              }
            },
            "customWidth": "9",
            "name": "kpi_extension_coverage"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type == \"microsoft.hybridcompute/machines/extensions\"\n| where properties.publisher =~ \"Microsoft.AzureData\"\n| where tostring(properties.type) in (\"WindowsAgent.SqlServer\", \"LinuxAgent.SqlServer\")\n| extend hostId = tolower(substring(id, 0, indexof(id, \"/extensions\")))\n| where resourceGroup in~ ({ResourceGroup})\n| summarize ExtensoesSQLComProblema = dcountif(hostId, tostring(properties.provisioningState) !~ \"Succeeded\")",
              "size": 4,
              "title": "⚠️ Extensões SQL com problema",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "tiles",
              "tileSettings": {
                "leftContent": {
                  "columnMatch": "ExtensoesSQLComProblema",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "red"
                  }
                },
                "showBorder": true,
                "size": "small"
              }
            },
            "customWidth": "9",
            "name": "kpi_extension_issues"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type == \"microsoft.azurearcdata/sqlserverinstances\"\n| where resourceGroup in~ ({ResourceGroup})\n| extend hostId = tolower(tostring(properties.containerResourceId))\n| extend sqlVersion = tostring(properties.version)\n| extend SQLVersionMajor = case(sqlVersion has \"SQL Server 2014\" or sqlVersion startswith \"12.\", \"SQL Server 2014\", sqlVersion has \"SQL Server 2016\" or sqlVersion startswith \"13.\", \"SQL Server 2016\", \"Outro\")\n| where SQLVersionMajor in (\"SQL Server 2014\", \"SQL Server 2016\")\n| summarize InstanciasSQL2014_2016 = count()",
              "size": 4,
              "title": "🕒 Instâncias SQL Server 2014/2016",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "tiles",
              "tileSettings": {
                "leftContent": {
                  "columnMatch": "InstanciasSQL2014_2016",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "orange"
                  }
                },
                "showBorder": true,
                "size": "small"
              }
            },
            "customWidth": "9",
            "name": "kpi_sql_eos_instances"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type == \"microsoft.azurearcdata/sqlserverinstances\"\n| where resourceGroup in~ ({ResourceGroup})\n| extend hostId = tolower(tostring(properties.containerResourceId))\n| extend sqlVersion = tostring(properties.version)\n| extend SQLVersionMajor = case(sqlVersion has \"SQL Server 2014\" or sqlVersion startswith \"12.\", \"SQL Server 2014\", sqlVersion has \"SQL Server 2016\" or sqlVersion startswith \"13.\", \"SQL Server 2016\", \"Outro\")\n| where SQLVersionMajor in (\"SQL Server 2014\", \"SQL Server 2016\")\n| summarize by hostId\n| join kind=leftouter (\n    resources\n| where type == \"microsoft.hybridcompute/machines/extensions\"\n| where properties.publisher =~ \"Microsoft.AzureData\"\n| where tostring(properties.type) in (\"WindowsAgent.SqlServer\", \"LinuxAgent.SqlServer\")\n| extend hostId = tolower(substring(id, 0, indexof(id, \"/extensions\")))\n| where resourceGroup in~ ({ResourceGroup})\n    | extend esuRaw = tostring(properties.settings.enableExtendedSecurityUpdates)\n    | project hostId, esuRaw\n) on hostId\n| summarize HostsSQL2014_2016_ESU_Habilitado = dcountif(hostId, esuRaw =~ \"true\")",
              "size": 4,
              "title": "🛡️ Hosts SQL 2014/2016 com ESU",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "tiles",
              "tileSettings": {
                "leftContent": {
                  "columnMatch": "HostsSQL2014_2016_ESU_Habilitado",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "purple"
                  }
                },
                "showBorder": true,
                "size": "small"
              }
            },
            "customWidth": "9",
            "name": "kpi_sql_eos_esu_enabled"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type == \"microsoft.azurearcdata/sqlserverinstances\"\n| where resourceGroup in~ ({ResourceGroup})\n| extend hostId = tolower(tostring(properties.containerResourceId))\n| extend sqlVersion = tostring(properties.version)\n| extend SQLVersionMajor = case(sqlVersion has \"SQL Server 2014\" or sqlVersion startswith \"12.\", \"SQL Server 2014\", sqlVersion has \"SQL Server 2016\" or sqlVersion startswith \"13.\", \"SQL Server 2016\", \"Outro\")\n| where SQLVersionMajor in (\"SQL Server 2014\", \"SQL Server 2016\")\n| summarize by hostId\n| join kind=leftouter (\n    resources\n| where type == \"microsoft.hybridcompute/machines/extensions\"\n| where properties.publisher =~ \"Microsoft.AzureData\"\n| where tostring(properties.type) in (\"WindowsAgent.SqlServer\", \"LinuxAgent.SqlServer\")\n| extend hostId = tolower(substring(id, 0, indexof(id, \"/extensions\")))\n| where resourceGroup in~ ({ResourceGroup})\n    | extend esuRaw = tostring(properties.settings.enableExtendedSecurityUpdates)\n    | project hostId, esuRaw\n) on hostId\n| summarize HostsSQL2014_2016_ESU_NaoHabilitado = dcountif(hostId, esuRaw !~ \"true\" or isempty(esuRaw))",
              "size": 4,
              "title": "🚨 Hosts SQL 2014/2016 sem ESU",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "tiles",
              "tileSettings": {
                "leftContent": {
                  "columnMatch": "HostsSQL2014_2016_ESU_NaoHabilitado",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "red"
                  }
                },
                "showBorder": true,
                "size": "small"
              }
            },
            "customWidth": "9",
            "name": "kpi_sql_eos_esu_not_enabled"
          }
        ]
      },
      "name": "metrics_group",
      "conditionalVisibility": {
        "parameterName": "SelectedTab",
        "comparison": "isEqualTo",
        "value": "VisaoGeral"
      }
    },
    {
      "type": 1,
      "content": {
        "json": "---\n### Nota de leitura\n- **LicenseType = Paid / PAYG / LicenseOnly** é configuração reportada pela extensão SQL Server no Azure Arc. O workbook não confirma entitlement contratual.\n- **SQL Server ESU** refere-se à configuração `enableExtendedSecurityUpdates` da extensão SQL Server. Não representa ESU de Windows Server.\n- **Cores de licenciamento SQL (estimado)** é cálculo do workbook com base nas propriedades reportadas pelo Azure Arc e nas regras implementadas nas queries. Não representa fatura oficial nem substitui validação de licenciamento.\n- **vCoreInstancia / sqlVcores** representa capacidade técnica reportada por instância SQL Server. Como múltiplas instâncias podem existir no mesmo host, não compare 1:1 com estimativas de licenciamento, ACR ou fatura."
      },
      "name": "concept_note",
      "conditionalVisibility": {
        "parameterName": "SelectedTab",
        "comparison": "isEqualTo",
        "value": "VisaoGeral"
      }
    },
    {
      "type": 1,
      "content": {
        "json": "---\n### SQL Server 2016 e SQL Server ESU\nO FAQ público de SQL Server Extended Security Updates informa que **SQL Server 2016** tem início de ESU em **14 de julho de 2026**, com Year 1 até **13 de julho de 2027**, Year 2 até **18 de julho de 2028** e Year 3 até **17 de julho de 2029**. O mesmo FAQ descreve ESU como opção temporária e informa que SQL Server ESU inclui somente atualizações de segurança **Critical**. Este workbook identifica instâncias SQL Server 2014/2016 e mostra se a configuração de SQL Server ESU está habilitada pela extensão SQL Server no Azure Arc."
      },
      "name": "sql2016_esu_note",
      "conditionalVisibility": {
        "parameterName": "SelectedTab",
        "comparison": "isEqualTo",
        "value": "VisaoGeral"
      }
    },
    {
      "type": 1,
      "content": {
        "json": "---\n## 📈 Distribuição Visual de SQL Server\n**Estado operacional de hosts SQL e distribuição por LicenseType da extensão SQL Server.**"
      },
      "name": "pie_header",
      "conditionalVisibility": {
        "parameterName": "SelectedTab",
        "comparison": "isEqualTo",
        "value": "VisaoGeral"
      }
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type == \"microsoft.hybridcompute/machines\"\n| extend joinId = tolower(id)\n| join kind=inner (\n    resources\n    | where type == \"microsoft.azurearcdata/sqlserverinstances\"\n    | extend arcMachineId = tolower(tostring(properties.containerResourceId))\n    | distinct arcMachineId\n) on $left.joinId == $right.arcMachineId\n| where resourceGroup in~ ({ResourceGroup})\n| extend status = case(tolower(properties.status) == 'connected', 'Connected', tolower(properties.status) == 'disconnected', 'Offline', tolower(properties.status) == 'error', 'Error', tolower(properties.status) == 'expired', 'Expired', 'Unknown')\n| summarize Hosts = dcount(joinId) by status",
              "size": 1,
              "title": "🔍 Status operacional dos hosts SQL",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "piechart",
              "chartSettings": {
                "createOtherGroup": 0,
                "showLegend": true,
                "labelColumn": "status",
                "valueColumn": "Hosts"
              }
            },
            "customWidth": "50",
            "name": "status_pie"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type == \"microsoft.hybridcompute/machines/extensions\"\n| where properties.publisher =~ \"Microsoft.AzureData\"\n| where tostring(properties.type) in (\"WindowsAgent.SqlServer\", \"LinuxAgent.SqlServer\")\n| extend hostId = tolower(substring(id, 0, indexof(id, \"/extensions\")))\n| where resourceGroup in~ ({ResourceGroup})\n| extend licenseTypeRaw = tostring(properties.settings.LicenseType)\n| extend LicenseType = case(licenseTypeRaw == \"PAYG\", \"PAYG\", licenseTypeRaw == \"Paid\", \"Paid\", licenseTypeRaw == \"LicenseOnly\", \"LicenseOnly\", isempty(licenseTypeRaw), \"Pendente\", licenseTypeRaw)\n| summarize Hosts = dcount(hostId) by LicenseType\n| order by Hosts desc",
              "size": 1,
              "title": "📊 Distribuição por LicenseType",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "piechart",
              "chartSettings": {
                "createOtherGroup": 0,
                "showLegend": true,
                "labelColumn": "LicenseType",
                "valueColumn": "Hosts"
              }
            },
            "customWidth": "50",
            "name": "license_pie"
          }
        ]
      },
      "name": "pie_group",
      "conditionalVisibility": {
        "parameterName": "SelectedTab",
        "comparison": "isEqualTo",
        "value": "VisaoGeral"
      }
    },
    {
      "type": 1,
      "content": {
        "json": "---\n## 🧾 Posição Técnica de Licenciamento de SQL Server enabled by Azure Arc\n**Visão por host/OSE para apoiar reconciliação técnica, true-up e análise com Licensing Specialist/SAM.**\n\n> A lógica do workbook consolida por host, usa a edição SQL Server mais alta identificada no host, aplica mínimo de 4 cores e trata edições gratuitas ou passivos HA/DR conforme o LicenseType reportado. A fatura real e a posição oficial de licenciamento devem ser validadas em Cost Management e nas fontes oficiais de licenciamento."
      },
      "name": "trueup_header",
      "conditionalVisibility": {
        "parameterName": "SelectedTab",
        "comparison": "isEqualTo",
        "value": "Licenciamento"
      }
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type == \"microsoft.hybridcompute/machines/extensions\"\n| where properties.publisher =~ \"Microsoft.AzureData\"\n| where tostring(properties.type) in (\"WindowsAgent.SqlServer\", \"LinuxAgent.SqlServer\")\n| extend hostId = tolower(substring(id, 0, indexof(id, \"/extensions\")))\n| extend licenseTypeRaw = tostring(properties.settings.LicenseType)\n| extend esuRaw = tostring(properties.settings.enableExtendedSecurityUpdates)\n| extend pcoreRaw = tostring(properties.settings.UsePhysicalCoreLicense.IsApplied)\n| extend extState = tostring(properties.provisioningState)\n| where resourceGroup in~ ({ResourceGroup})\n| project hostId, licenseTypeRaw, esuRaw, pcoreRaw, extState\n| join kind=inner (\n    resources\n    | where type == \"microsoft.hybridcompute/machines\"\n    | extend hostId = tolower(id)\n    | extend logicalCores = toint(properties.detectedProperties.logicalCoreCount)\n    | extend physicalCores = toint(properties.detectedProperties.coreCount)\n    | project hostId, machineName = name, logicalCores, physicalCores\n) on hostId\n| join kind=leftouter (\n    resources\n    | where type == \"microsoft.azurearcdata/sqlserverinstances\"\n    | extend hostId = tolower(tostring(properties.containerResourceId))\n    | extend edition = tostring(properties.edition)\n    | extend instLicType = tostring(properties.licenseType)\n    | extend sqlVersion = tostring(properties.version)\n    | extend SQLVersionMajor = case(sqlVersion has \"SQL Server 2014\" or sqlVersion startswith \"12.\", \"SQL Server 2014\", sqlVersion has \"SQL Server 2016\" or sqlVersion startswith \"13.\", \"SQL Server 2016\", sqlVersion has \"SQL Server 2017\" or sqlVersion startswith \"14.\", \"SQL Server 2017\", sqlVersion has \"SQL Server 2019\" or sqlVersion startswith \"15.\", \"SQL Server 2019\", sqlVersion has \"SQL Server 2022\" or sqlVersion startswith \"16.\", \"SQL Server 2022\", sqlVersion has \"SQL Server 2025\" or sqlVersion startswith \"17.\", \"SQL Server 2025\", \"Não identificado\")\n    | extend isSQLServerESUVersion = SQLVersionMajor in (\"SQL Server 2014\", \"SQL Server 2016\")\n    | extend editionRank = case(edition has \"Enterprise\", 6, edition has \"Standard\", 5, edition has \"Web\", 4, edition has \"Express\", 3, edition has \"Developer\", 2, edition has \"Evaluation\", 1, 0)\n    | summarize topRank = max(editionRank), ativos = countif(instLicType !~ \"HADR\"), qtdSQLServerESU = countif(isSQLServerESUVersion), versoesSQL = make_set(SQLVersionMajor, 20) by hostId\n) on hostId\n| extend topEdition = case(topRank == 6, \"Enterprise\", topRank == 5, \"Standard\", topRank == 4, \"Web\", topRank == 3, \"Express\", topRank == 2, \"Developer\", topRank == 1, \"Evaluation\", \"Sem instância\")\n| extend ed3 = case(topEdition == \"Enterprise\", \"Ent\", topEdition == \"Standard\", \"Std\", topEdition == \"Web\", \"Web\", topEdition == \"Express\", \"Exp\", topEdition)\n| extend isFreeEdition = topEdition in (\"Developer\", \"Evaluation\", \"Express\")\n| extend isPassivo = (topRank > 0 and ativos == 0)\n| extend hasSQLServerESUVersion = qtdSQLServerESU > 0\n| extend coresDetectados = coalesce(logicalCores, physicalCores, 0)\n| extend coresHost = iff(coresDetectados < 4, 4, coresDetectados)\n| extend coresLicencaEstimados = case(topEdition == \"Sem instância\", 0, isFreeEdition, 0, isPassivo and licenseTypeRaw in (\"Paid\", \"PAYG\"), 0, isempty(licenseTypeRaw), 0, coresHost)\n| extend coresPAYG = iff(coresLicencaEstimados > 0 and licenseTypeRaw == \"PAYG\", coresHost, 0)\n| extend coresPaid = iff(coresLicencaEstimados > 0 and licenseTypeRaw == \"Paid\", coresHost, 0)\n| extend coresLicenseOnlyComLicenciamento = iff(coresLicencaEstimados > 0 and licenseTypeRaw == \"LicenseOnly\", coresHost, 0)\n| extend coresRZero = case(isFreeEdition, coresHost, isPassivo and licenseTypeRaw in (\"Paid\", \"PAYG\"), coresHost, 0)\n| summarize CoresPAYG = sum(coresPAYG)",
              "size": 4,
              "title": "💰 Cores PAYG",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "tiles",
              "tileSettings": {
                "leftContent": {
                  "columnMatch": "CoresPAYG",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "red"
                  }
                },
                "showBorder": true,
                "size": "small"
              }
            },
            "customWidth": "20",
            "name": "trueup_payg"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type == \"microsoft.hybridcompute/machines/extensions\"\n| where properties.publisher =~ \"Microsoft.AzureData\"\n| where tostring(properties.type) in (\"WindowsAgent.SqlServer\", \"LinuxAgent.SqlServer\")\n| extend hostId = tolower(substring(id, 0, indexof(id, \"/extensions\")))\n| extend licenseTypeRaw = tostring(properties.settings.LicenseType)\n| extend esuRaw = tostring(properties.settings.enableExtendedSecurityUpdates)\n| extend pcoreRaw = tostring(properties.settings.UsePhysicalCoreLicense.IsApplied)\n| extend extState = tostring(properties.provisioningState)\n| where resourceGroup in~ ({ResourceGroup})\n| project hostId, licenseTypeRaw, esuRaw, pcoreRaw, extState\n| join kind=inner (\n    resources\n    | where type == \"microsoft.hybridcompute/machines\"\n    | extend hostId = tolower(id)\n    | extend logicalCores = toint(properties.detectedProperties.logicalCoreCount)\n    | extend physicalCores = toint(properties.detectedProperties.coreCount)\n    | project hostId, machineName = name, logicalCores, physicalCores\n) on hostId\n| join kind=leftouter (\n    resources\n    | where type == \"microsoft.azurearcdata/sqlserverinstances\"\n    | extend hostId = tolower(tostring(properties.containerResourceId))\n    | extend edition = tostring(properties.edition)\n    | extend instLicType = tostring(properties.licenseType)\n    | extend sqlVersion = tostring(properties.version)\n    | extend SQLVersionMajor = case(sqlVersion has \"SQL Server 2014\" or sqlVersion startswith \"12.\", \"SQL Server 2014\", sqlVersion has \"SQL Server 2016\" or sqlVersion startswith \"13.\", \"SQL Server 2016\", sqlVersion has \"SQL Server 2017\" or sqlVersion startswith \"14.\", \"SQL Server 2017\", sqlVersion has \"SQL Server 2019\" or sqlVersion startswith \"15.\", \"SQL Server 2019\", sqlVersion has \"SQL Server 2022\" or sqlVersion startswith \"16.\", \"SQL Server 2022\", sqlVersion has \"SQL Server 2025\" or sqlVersion startswith \"17.\", \"SQL Server 2025\", \"Não identificado\")\n    | extend isSQLServerESUVersion = SQLVersionMajor in (\"SQL Server 2014\", \"SQL Server 2016\")\n    | extend editionRank = case(edition has \"Enterprise\", 6, edition has \"Standard\", 5, edition has \"Web\", 4, edition has \"Express\", 3, edition has \"Developer\", 2, edition has \"Evaluation\", 1, 0)\n    | summarize topRank = max(editionRank), ativos = countif(instLicType !~ \"HADR\"), qtdSQLServerESU = countif(isSQLServerESUVersion), versoesSQL = make_set(SQLVersionMajor, 20) by hostId\n) on hostId\n| extend topEdition = case(topRank == 6, \"Enterprise\", topRank == 5, \"Standard\", topRank == 4, \"Web\", topRank == 3, \"Express\", topRank == 2, \"Developer\", topRank == 1, \"Evaluation\", \"Sem instância\")\n| extend ed3 = case(topEdition == \"Enterprise\", \"Ent\", topEdition == \"Standard\", \"Std\", topEdition == \"Web\", \"Web\", topEdition == \"Express\", \"Exp\", topEdition)\n| extend isFreeEdition = topEdition in (\"Developer\", \"Evaluation\", \"Express\")\n| extend isPassivo = (topRank > 0 and ativos == 0)\n| extend hasSQLServerESUVersion = qtdSQLServerESU > 0\n| extend coresDetectados = coalesce(logicalCores, physicalCores, 0)\n| extend coresHost = iff(coresDetectados < 4, 4, coresDetectados)\n| extend coresLicencaEstimados = case(topEdition == \"Sem instância\", 0, isFreeEdition, 0, isPassivo and licenseTypeRaw in (\"Paid\", \"PAYG\"), 0, isempty(licenseTypeRaw), 0, coresHost)\n| extend coresPAYG = iff(coresLicencaEstimados > 0 and licenseTypeRaw == \"PAYG\", coresHost, 0)\n| extend coresPaid = iff(coresLicencaEstimados > 0 and licenseTypeRaw == \"Paid\", coresHost, 0)\n| extend coresLicenseOnlyComLicenciamento = iff(coresLicencaEstimados > 0 and licenseTypeRaw == \"LicenseOnly\", coresHost, 0)\n| extend coresRZero = case(isFreeEdition, coresHost, isPassivo and licenseTypeRaw in (\"Paid\", \"PAYG\"), coresHost, 0)\n| summarize CoresRZero = sum(coresRZero)",
              "size": 4,
              "title": "🆓 Cores R$ 0 (edições gratuitas/HA-DR)",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "tiles",
              "tileSettings": {
                "leftContent": {
                  "columnMatch": "CoresRZero",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "green"
                  }
                },
                "showBorder": true,
                "size": "small"
              }
            },
            "customWidth": "20",
            "name": "trueup_zero"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type == \"microsoft.hybridcompute/machines/extensions\"\n| where properties.publisher =~ \"Microsoft.AzureData\"\n| where tostring(properties.type) in (\"WindowsAgent.SqlServer\", \"LinuxAgent.SqlServer\")\n| extend hostId = tolower(substring(id, 0, indexof(id, \"/extensions\")))\n| extend licenseTypeRaw = tostring(properties.settings.LicenseType)\n| extend esuRaw = tostring(properties.settings.enableExtendedSecurityUpdates)\n| extend pcoreRaw = tostring(properties.settings.UsePhysicalCoreLicense.IsApplied)\n| extend extState = tostring(properties.provisioningState)\n| where resourceGroup in~ ({ResourceGroup})\n| project hostId, licenseTypeRaw, esuRaw, pcoreRaw, extState\n| join kind=inner (\n    resources\n    | where type == \"microsoft.hybridcompute/machines\"\n    | extend hostId = tolower(id)\n    | extend logicalCores = toint(properties.detectedProperties.logicalCoreCount)\n    | extend physicalCores = toint(properties.detectedProperties.coreCount)\n    | project hostId, machineName = name, logicalCores, physicalCores\n) on hostId\n| join kind=leftouter (\n    resources\n    | where type == \"microsoft.azurearcdata/sqlserverinstances\"\n    | extend hostId = tolower(tostring(properties.containerResourceId))\n    | extend edition = tostring(properties.edition)\n    | extend instLicType = tostring(properties.licenseType)\n    | extend sqlVersion = tostring(properties.version)\n    | extend SQLVersionMajor = case(sqlVersion has \"SQL Server 2014\" or sqlVersion startswith \"12.\", \"SQL Server 2014\", sqlVersion has \"SQL Server 2016\" or sqlVersion startswith \"13.\", \"SQL Server 2016\", sqlVersion has \"SQL Server 2017\" or sqlVersion startswith \"14.\", \"SQL Server 2017\", sqlVersion has \"SQL Server 2019\" or sqlVersion startswith \"15.\", \"SQL Server 2019\", sqlVersion has \"SQL Server 2022\" or sqlVersion startswith \"16.\", \"SQL Server 2022\", sqlVersion has \"SQL Server 2025\" or sqlVersion startswith \"17.\", \"SQL Server 2025\", \"Não identificado\")\n    | extend isSQLServerESUVersion = SQLVersionMajor in (\"SQL Server 2014\", \"SQL Server 2016\")\n    | extend editionRank = case(edition has \"Enterprise\", 6, edition has \"Standard\", 5, edition has \"Web\", 4, edition has \"Express\", 3, edition has \"Developer\", 2, edition has \"Evaluation\", 1, 0)\n    | summarize topRank = max(editionRank), ativos = countif(instLicType !~ \"HADR\"), qtdSQLServerESU = countif(isSQLServerESUVersion), versoesSQL = make_set(SQLVersionMajor, 20) by hostId\n) on hostId\n| extend topEdition = case(topRank == 6, \"Enterprise\", topRank == 5, \"Standard\", topRank == 4, \"Web\", topRank == 3, \"Express\", topRank == 2, \"Developer\", topRank == 1, \"Evaluation\", \"Sem instância\")\n| extend ed3 = case(topEdition == \"Enterprise\", \"Ent\", topEdition == \"Standard\", \"Std\", topEdition == \"Web\", \"Web\", topEdition == \"Express\", \"Exp\", topEdition)\n| extend isFreeEdition = topEdition in (\"Developer\", \"Evaluation\", \"Express\")\n| extend isPassivo = (topRank > 0 and ativos == 0)\n| extend hasSQLServerESUVersion = qtdSQLServerESU > 0\n| extend coresDetectados = coalesce(logicalCores, physicalCores, 0)\n| extend coresHost = iff(coresDetectados < 4, 4, coresDetectados)\n| extend coresLicencaEstimados = case(topEdition == \"Sem instância\", 0, isFreeEdition, 0, isPassivo and licenseTypeRaw in (\"Paid\", \"PAYG\"), 0, isempty(licenseTypeRaw), 0, coresHost)\n| extend coresPAYG = iff(coresLicencaEstimados > 0 and licenseTypeRaw == \"PAYG\", coresHost, 0)\n| extend coresPaid = iff(coresLicencaEstimados > 0 and licenseTypeRaw == \"Paid\", coresHost, 0)\n| extend coresLicenseOnlyComLicenciamento = iff(coresLicencaEstimados > 0 and licenseTypeRaw == \"LicenseOnly\", coresHost, 0)\n| extend coresRZero = case(isFreeEdition, coresHost, isPassivo and licenseTypeRaw in (\"Paid\", \"PAYG\"), coresHost, 0)\n| summarize CoresPaid = sum(coresPaid)",
              "size": 4,
              "title": "🏦 Cores LicenseType = Paid",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "tiles",
              "tileSettings": {
                "leftContent": {
