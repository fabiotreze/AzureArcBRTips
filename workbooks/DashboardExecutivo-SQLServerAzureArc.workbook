                },
                "showBorder": true,
                "size": "small"
              }
            },
            "customWidth": "9",
            "name": "kpi_sql_eos_esu_enabled"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\n| where type == \"microsoft.azurearcdata/sqlserverinstances\"\n| where resourceGroup in~ ({ResourceGroup})\n| extend hostId = tolower(tostring(properties.containerResourceId))\n| extend sqlVersion = tostring(properties.version)\n| extend SQLVersionMajor = case(sqlVersion has \"SQL Server 2014\" or sqlVersion startswith \"12.\", \"SQL Server 2014\", sqlVersion has \"SQL Server 2016\" or sqlVersion startswith \"13.\", \"SQL Server 2016\", \"Outro\")\n| where SQLVersionMajor in (\"SQL Server 2014\", \"SQL Server 2016\")\n| summarize by hostId\n| join kind=leftouter (\n    resources\n| where type == \"microsoft.hybridcompute/machines/extensions\"\n| where properties.publisher =~ \"Microsoft.AzureData\"\n| where tostring(properties.type) in (\"WindowsAgent.SqlServer\", \"LinuxAgent.SqlServer\")\n| extend hostId = tolower(substring(id, 0, indexof(id, \"/extensions\")))\n| where resourceGroup in~ ({ResourceGroup})\n    | extend esuRaw = tostring(properties.settings.enableExtendedSecurityUpdates)\n    | project hostId, esuRaw\n) on hostId\n| summarize HostsSQL2014_2016_ESU_NaoHabilitado = dcountif(hostId, esuRaw !~ \"true\" or isempty(esuRaw))",
              "size": 4,
              "title": "🚨 Hosts SQL 2014/2016 sem ESU",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
