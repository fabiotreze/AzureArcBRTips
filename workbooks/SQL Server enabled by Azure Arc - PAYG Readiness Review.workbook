    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "resources\n| where type =~ 'microsoft.azurearcdata/sqlserverinstances'\n| extend HostId = tolower(tostring(properties.containerResourceId))\n| extend Edition=tostring(properties.edition), Version=tostring(properties.version), InstanceLicenseType=tostring(properties.licenseType), VCore=toint(properties.vCore)\n| extend EditionRank = case(Edition has 'Enterprise', 6, Edition has 'Standard', 5, Edition has 'Web', 4, Edition has 'Express', 3, Edition has 'Developer', 2, Edition has 'Evaluation', 1, 0)\n| extend SqlVersionMajor = case(Version has 'SQL Server 2014' or Version startswith '12.', 'SQL Server 2014', Version has 'SQL Server 2016' or Version startswith '13.', 'SQL Server 2016', Version has 'SQL Server 2017' or Version startswith '14.', 'SQL Server 2017', Version has 'SQL Server 2019' or Version startswith '15.', 'SQL Server 2019', Version has 'SQL Server 2022' or Version startswith '16.', 'SQL Server 2022', Version has 'SQL Server 2025' or Version startswith '17.', 'SQL Server 2025', isnotempty(Version), Version, 'Not identified')\n| summarize Instances=count(), ActiveInstances=countif(InstanceLicenseType !~ 'HADR'), HadrInstances=countif(InstanceLicenseType =~ 'HADR'), TopEditionRank=max(EditionRank), Editions=make_set(Edition), Versions=make_set(SqlVersionMajor), InstanceLicenseTypes=make_set(InstanceLicenseType), InstanceVCores=sum(VCore) by HostId\n| extend TopEdition = case(TopEditionRank == 6, 'Enterprise', TopEditionRank == 5, 'Standard', TopEditionRank == 4, 'Web', TopEditionRank == 3, 'Express', TopEditionRank == 2, 'Developer', TopEditionRank == 1, 'Evaluation', 'Not identified')\n| extend IsFreeOrTestEdition = TopEdition in ('Developer','Evaluation','Express')\n| extend HadrOnlySignal = Instances > 0 and ActiveInstances == 0\n| join kind=leftouter (\n    resources\n    | where type =~ 'microsoft.hybridcompute/machines'\n    | extend HostId = tolower(id)\n    | project HostId, MachineName=tostring(name), ArcStatus=tostring(properties.status), MachineProvisioningState=tostring(properties.provisioningState), LogicalCoreCount=toint(properties.detectedProperties.logicalCoreCount), PhysicalCoreCount=toint(properties.detectedProperties.coreCount), ResourceGroup=resourceGroup, SubscriptionId=subscriptionId\n) on HostId\n| join kind=leftouter (\n    resources\n    | where type =~ 'microsoft.hybridcompute/machines/extensions'\n    | where tostring(properties.publisher) =~ 'Microsoft.AzureData'\n    | where tostring(properties.type) in~ ('WindowsAgent.SqlServer','LinuxAgent.SqlServer')\n    | extend HostId = tolower(substring(id, 0, indexof(id, '/extensions')))\n    | extend HostLicenseTypeRaw = tostring(properties.settings.LicenseType)\n    | extend HostLicenseType = case(HostLicenseTypeRaw =~ 'PAYG', 'PAYG', HostLicenseTypeRaw =~ 'Paid', 'Paid', HostLicenseTypeRaw =~ 'LicenseOnly', 'LicenseOnly', isempty(HostLicenseTypeRaw), 'Not reported', HostLicenseTypeRaw)\n    | extend UsePhysicalCoreLicenseRaw = tostring(properties.settings.UsePhysicalCoreLicense.IsApplied)\n    | extend UsePhysicalCoreLicense = case(UsePhysicalCoreLicenseRaw =~ 'true', 'Applied', UsePhysicalCoreLicenseRaw =~ 'false', 'Not applied', 'Not reported')\n    | extend RecurringPAYGConsent = tostring(properties.settings.ConsentToRecurringPAYG.Consented)\n    | extend RecurringPAYGConsentTimestamp = tostring(properties.settings.ConsentToRecurringPAYG.ConsentTimestamp)\n    | project HostId, ExtensionState=tostring(properties.provisioningState), HostLicenseType, EnableESU=tostring(properties.settings.enableExtendedSecurityUpdates), UsePhysicalCoreLicense, RecurringPAYGConsent, RecurringPAYGConsentTimestamp\n) on HostId\n| extend HostLicenseType = coalesce(HostLicenseType, 'Not reported')\n| extend UsePhysicalCoreLicense = coalesce(UsePhysicalCoreLicense, 'Not reported')\n| extend EstimatedCoreSignal = coalesce(InstanceVCores, LogicalCoreCount, PhysicalCoreCount, 0)\n| extend ValidationFlags = strcat(\n    iif(ArcStatus !~ 'Connected', strcat('Arc status: ', coalesce(ArcStatus,'Not reported'), '; '), ''),\n    iif(ExtensionState !~ 'Succeeded', strcat('Extension state: ', coalesce(ExtensionState,'Not reported'), '; '), ''),\n    iif(HostLicenseType == 'PAYG', 'Already reports PAYG; validate billing and recurring consent if CSP-managed; ', ''),\n    iif(HostLicenseType == 'PAYG' and RecurringPAYGConsent !~ 'Consented', 'Recurring PAYG consent not reported on extension; required for CSP-managed subscriptions; ', ''),\n    iif(HostLicenseType == 'Paid', 'Validate SA or SQL Server Subscription entitlement before change; ', ''),\n    iif(HostLicenseType == 'LicenseOnly', 'LicenseOnly/free/perpetual signal; not automatic PAYG; ', ''),\n    iif(tostring(InstanceLicenseTypes) has 'ServerCAL', 'Server+CAL signal; validate separately before PAYG because Arc PAYG is core-based; ', ''),\n    iif(HostLicenseType == 'Not reported', 'LicenseType not reported; validate SQL extension configuration; ', ''),\n    iif(UsePhysicalCoreLicense == 'Applied', 'pCore/SQLServerLicense signal; validate scope and billingPlan; ', ''),\n    iif(HadrOnlySignal, 'HA/DR-only signal; validate passive eligibility; ', ''),\n    iif(HadrInstances > 0 and ActiveInstances > 0, 'Mixed active + HADR instances; validate HA topology; ', ''),\n    iif(IsFreeOrTestEdition, 'Free/test top edition signal; ', '')\n)\n| extend ReviewScope = case(\n    HostLicenseType == 'Paid' and TopEdition in ('Enterprise','Standard') and ActiveInstances > 0, 'Paid Enterprise/Standard - review for PAYG',\n    HostLicenseType == 'Paid' and HadrOnlySignal, 'Paid HA/DR-only - review passive status',\n    HostLicenseType == 'PAYG', 'Already PAYG',\n    HostLicenseType == 'LicenseOnly', 'LicenseOnly - inventory only',\n    HostLicenseType == 'Not reported', 'Needs LicenseType configuration review',\n    IsFreeOrTestEdition, 'Free/test edition - inventory only',\n    'Review')\n| extend FirstWaveFit = case(\n    ReviewScope == 'Paid Enterprise/Standard - review for PAYG' and ArcStatus =~ 'Connected' and ExtensionState =~ 'Succeeded' and UsePhysicalCoreLicense != 'Applied' and HadrInstances == 0 and tostring(InstanceLicenseTypes) !has 'ServerCAL', 'Clean first-wave candidate after commercial approval',\n    ReviewScope == 'Paid Enterprise/Standard - review for PAYG', 'PAYG review scope with technical flags',\n    ReviewScope)\n| extend DryRunWouldInclude = iff(HostLicenseType != 'PAYG' and ExtensionState =~ 'Succeeded', 'Yes - script scope if SQL discovered', 'No')| project MachineName, ResourceGroup, SubscriptionId, ArcStatus, MachineProvisioningState, LogicalCoreCount, PhysicalCoreCount, HostLicenseType, UsePhysicalCoreLicense, RecurringPAYGConsent, RecurringPAYGConsentTimestamp, EnableESU, ExtensionState, TopEdition, Editions=tostring(Editions), Versions=tostring(Versions), InstanceLicenseTypes=tostring(InstanceLicenseTypes), Instances, ActiveInstances, HadrInstances, InstanceVCores, CoreSignalNotBilling=EstimatedCoreSignal, ReviewScope, FirstWaveFit, DryRunWouldInclude, ValidationFlags\n| order by MachineName asc",
        "size": 0,
        "title": "Complete Arc SQL host inventory (exportable)",
        "queryType": 1,
        "resourceType": "microsoft.resourcegraph/resources",
        "crossComponentResources": [
          "{Subscription}"
        ],
        "visualization": "table"
      },
      "conditionalVisibility": {
        "parameterName": "SelectedTab",
        "comparison": "isEqualTo",
        "value": "Inventory"
      },
      "name": "full_inventory"
    },
    {
      "type": 1,
      "content": {
        "json": "## Required validations outside this workbook\n- **CSP recurring PAYG consent:** required for CSP-managed subscriptions before enabling recurring PAYG billing. Check `PAYG-Recurring` onboarding tags and/or `ConsentToRecurringPAYG` on the SQL extension.\n- **Billing proof:** validate actual PAYG charges in Azure Cost Management / invoice after pilot. Use Service name = Azure Arc-enabled SQL Server, Charge type = Usage, Publisher type = Microsoft; group by Resource and Meter when needed.\n- **SA / SQL Server Subscription entitlement:** `Paid` is an attestation, not proof of entitlement. If instance license types show `ServerCAL`, validate the Server+CAL path separately before PAYG because Arc PAYG is core-based.\n- **pCore / unlimited virtualization:** when `UsePhysicalCoreLicense` is applied on a host, or when SQL Server License resources exist, validate scope, active resource, physical cores and `billingPlan` before bulk changes.\n- **Passive HA/DR:** `HADR` signals are not enough. Validate AG/FCI/passive eligibility, readable secondaries, user DBs outside AG, and associated services.\n- **Connectivity and usage upload:** PAYG depends on healthy Arc and SQL extension connectivity. Disconnections beyond 30 days can trigger recurring PAYG behavior based on last known configuration."
      },
      "conditionalVisibility": {
        "parameterName": "SelectedTab",
        "comparison": "isEqualTo",
        "value": "Validation"
      },
      "name": "external_validations"
    },
    {
      "type": 1,
      "content": {
        "json": "## Official ARG support checks added\nThese queries mirror Microsoft Learn guidance without replacing the workbook review logic: auto-deploy license tags, Arc machines with SQL discovered but missing the SQL extension, and connected billable Enterprise/Standard SQL instances. Use them to explain gaps before running any transition."
      },
      "conditionalVisibility": {
        "parameterName": "SelectedTab",
        "comparison": "isEqualTo",
        "value": [
          "Validation",
          "NewQueryItem"
        ]
      },
      "name": "autodeploy_note"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "resourcecontainers\n| where type in~ ('microsoft.resources/subscriptions','microsoft.resources/subscriptions/resourcegroups')\n| extend ScopeType = iff(type =~ 'microsoft.resources/subscriptions', 'Subscription', 'ResourceGroup')\n| extend ScopeName = name\n| extend ArcSQLServerExtensionDeployment = tostring(tags['ArcSQLServerExtensionDeployment'])\n| where isnotempty(ArcSQLServerExtensionDeployment)\n| project ScopeType, ScopeName, SubscriptionId=subscriptionId, ArcSQLServerExtensionDeployment\n| union (\n    resources\n    | where type =~ 'microsoft.hybridcompute/machines'\n    | extend ArcSQLServerExtensionDeployment = tostring(tags['ArcSQLServerExtensionDeployment'])\n    | where isnotempty(ArcSQLServerExtensionDeployment)\n    | project ScopeType='ArcMachine', ScopeName=name, SubscriptionId=subscriptionId, ArcSQLServerExtensionDeployment\n)\n| extend Interpretation = case(ArcSQLServerExtensionDeployment =~ 'PAYG-Recurring', 'CSP recurring PAYG consent tag / onboarding default', ArcSQLServerExtensionDeployment =~ 'PAYG', 'PAYG onboarding default', ArcSQLServerExtensionDeployment =~ 'Paid', 'Paid onboarding default', ArcSQLServerExtensionDeployment =~ 'LicenseOnly', 'LicenseOnly onboarding default', ArcSQLServerExtensionDeployment =~ 'Disabled', 'Auto-deploy disabled', 'Review tag value')\n| order by ScopeType asc, ScopeName asc",
        "size": 0,
        "title": "ArcSQLServerExtensionDeployment tags / onboarding defaults",
        "queryType": 1,
        "resourceType": "microsoft.resourcegraph/resources",
        "crossComponentResources": [
          "{Subscription}"
        ],
        "visualization": "table"
      },
      "conditionalVisibility": {
        "parameterName": "SelectedTab",
        "comparison": "isEqualTo",
        "value": "Validation"
      },
      "name": "autodeploy_tags"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "resources\n| where type =~ 'microsoft.hybridcompute/machines'\n| where tostring(properties.detectedProperties.mssqldiscovered) =~ 'true'\n| extend HostId = tolower(id)\n| join kind=leftouter (\n    resources\n    | where type =~ 'microsoft.hybridcompute/machines/extensions'\n    | where tostring(properties.type) in~ ('WindowsAgent.SqlServer','LinuxAgent.SqlServer') or tostring(name) has 'SqlServer'\n    | extend HostId = tolower(substring(id, 0, indexof(id, '/extensions')))\n    | summarize SqlExtensionCount=count(), ExtensionNames=make_set(name) by HostId\n) on HostId\n| where isempty(SqlExtensionCount) or SqlExtensionCount == 0\n| project MachineName=name, ArcStatus=tostring(properties.status), ResourceGroup=resourceGroup, SubscriptionId=subscriptionId, DetectedSql=tostring(properties.detectedProperties.mssqldiscovered), Action='SQL discovered by Arc but Azure Extension for SQL Server not found'\n| order by SubscriptionId, ResourceGroup, MachineName",
        "size": 0,
        "title": "SQL discovered but missing Azure Extension for SQL Server",
        "queryType": 1,
        "resourceType": "microsoft.resourcegraph/resources",
        "crossComponentResources": [
          "{Subscription}"
        ],
        "visualization": "table"
      },
      "conditionalVisibility": {
        "parameterName": "SelectedTab",
        "comparison": "isEqualTo",
        "value": "Validation"
      },
      "name": "missing_sql_extension"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "resources\n| where type =~ 'microsoft.hybridcompute/machines'\n| where tostring(properties.status) =~ 'Connected'\n| extend HostId = tolower(id)\n| extend LogicalCoreCount=toint(properties.detectedProperties.logicalCoreCount), PhysicalCoreCount=toint(properties.detectedProperties.coreCount)\n| join kind=inner (\n    resources\n    | where type =~ 'microsoft.hybridcompute/machines/extensions'\n    | where tostring(properties.publisher) =~ 'Microsoft.AzureData'\n    | where tostring(properties.type) in~ ('WindowsAgent.SqlServer','LinuxAgent.SqlServer')\n    | extend HostId = tolower(substring(id, 0, indexof(id, '/extensions')))\n    | project HostId, HostLicenseTypeRaw=tostring(properties.settings.LicenseType), ExtensionState=tostring(properties.provisioningState)\n) on HostId\n| join kind=inner (\n    resources\n    | where type =~ 'microsoft.azurearcdata/sqlserverinstances'\n    | where tostring(properties.edition) in~ ('Enterprise','Standard')\n    | where tostring(properties.licenseType) !~ 'HADR'\n    | extend HostId = tolower(tostring(properties.containerResourceId))\n    | summarize ActiveInstances=count(), Editions=make_set(tostring(properties.edition)), InstanceLicenseTypes=make_set(tostring(properties.licenseType)), InstanceVCores=sum(toint(properties.vCore)) by HostId\n) on HostId\n| extend HostLicenseType = iff(isempty(HostLicenseTypeRaw), 'Not reported', HostLicenseTypeRaw)\n| project MachineName=name, ResourceGroup=resourceGroup, SubscriptionId=subscriptionId, HostLicenseType, ExtensionState, ActiveInstances, Editions=tostring(Editions), InstanceLicenseTypes=tostring(InstanceLicenseTypes), CoreSignalNotBilling=coalesce(InstanceVCores, LogicalCoreCount, PhysicalCoreCount, 0)\n| order by CoreSignalNotBilling desc, MachineName asc",
        "size": 0,
        "title": "Connected Enterprise/Standard active SQL hosts (official-style check)",
        "queryType": 1,
        "resourceType": "microsoft.resourcegraph/resources",
        "crossComponentResources": [
          "{Subscription}"
        ],
        "visualization": "table"
      },
      "conditionalVisibility": {
        "parameterName": "SelectedTab",
        "comparison": "isEqualTo",
        "value": "Validation"
      },
      "name": "official_billable_connected"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "resources\n| where type =~ 'microsoft.hybridcompute/machines/extensions'\n| where tostring(properties.publisher) =~ 'Microsoft.AzureData'\n| where tostring(properties.type) in~ ('WindowsAgent.SqlServer','LinuxAgent.SqlServer')\n| extend HostId = tolower(substring(id, 0, indexof(id, '/extensions')))\n| extend Host = tostring(split(id, '/')[8])\n| extend LicenseTypeRaw = tostring(properties.settings.LicenseType)\n| extend LicenseType = iff(isempty(LicenseTypeRaw), 'Not reported', LicenseTypeRaw)\n| extend RecurringPAYGConsent = tostring(properties.settings.ConsentToRecurringPAYG.Consented)\n| extend RecurringPAYGConsentTimestamp = tostring(properties.settings.ConsentToRecurringPAYG.ConsentTimestamp)\n| extend Interpretation = case(LicenseType =~ 'PAYG' and RecurringPAYGConsent =~ 'Consented', 'PAYG with recurring consent reported', LicenseType =~ 'PAYG' and RecurringPAYGConsent !~ 'Consented', 'PAYG without recurring consent reported - validate if CSP-managed', isnotempty(RecurringPAYGConsent), 'Consent property reported but host is not PAYG', 'No consent property reported')\n| project Host, LicenseType, RecurringPAYGConsent, RecurringPAYGConsentTimestamp, Interpretation, ExtensionState=tostring(properties.provisioningState), ResourceGroup=resourceGroup, SubscriptionId=subscriptionId\n| order by LicenseType asc, Host asc",
        "size": 0,
        "title": "Recurring PAYG consent reported by SQL extension",
        "queryType": 1,
        "resourceType": "microsoft.resourcegraph/resources",
        "crossComponentResources": [
          "{Subscription}"
        ],
        "visualization": "table"
      },
      "conditionalVisibility": {
        "parameterName": "SelectedTab",
        "comparison": "isEqualTo",
        "value": "Validation"
      },
      "name": "recurring_payg_consent"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "resources\n| where type =~ 'microsoft.azurearcdata/sqlserverlicenses'\n| extend BillingPlan=tostring(properties.billingPlan), PhysicalCores=toint(coalesce(properties.physicalCores, properties.size)), ActivationState=tostring(properties.activationState), ScopeType=tostring(properties.scopeType), Scope=tostring(properties.scope), LicenseCategory=tostring(properties.licenseCategory)\n| extend Validation=case(ActivationState !~ 'Activated' and ActivationState !~ 'Active', 'Attention: license is not active', BillingPlan !in~ ('Paid','PAYG'), 'Attention: billingPlan not recognized', LicenseCategory !~ 'Core', 'Attention: licenseCategory should be Core', ScopeType !in~ ('Tenant','Subscription','ResourceGroup'), 'Attention: scopeType not recognized', isnull(PhysicalCores) or PhysicalCores <= 0, 'Attention: physical cores not reported', PhysicalCores < 16, 'Attention: documented minimum is 16 physical cores', 'Active resource; validate VM scope and billing plan')\n| project SQLServerLicense=name, BillingPlan, PhysicalCores, ActivationState, ScopeType, Scope, LicenseCategory, Validation, Location=location, ResourceGroup=resourceGroup, SubscriptionId=subscriptionId\n| order by ActivationState asc, SQLServerLicense asc",
        "size": 0,
        "title": "SQLServerLicense resources / pCore validation",
        "queryType": 1,
        "resourceType": "microsoft.resourcegraph/resources",
        "crossComponentResources": [
          "{Subscription}"
        ],
        "visualization": "table"
      },
      "conditionalVisibility": {
        "parameterName": "SelectedTab",
        "comparison": "isEqualTo",
        "value": "Validation"
      },
      "name": "sqlserverlicense_resources"
    },
    {
      "type": 1,
      "content": {
        "json": "## Recommended execution path\n1. Use this workbook for the first shared Arc SQL view and validation flags.\n2. Run `manage-payg-transition.ps1 -Target Arc -TargetLicenseType PAYG -ReportOnly` for the approved subscription/resource-group scope.\n3. Reconcile the dry-run CSV with this workbook and customer/licensing approval.\n4. Pilot a small set after commercial approval, then validate `LicenseType = PAYG` and Cost Management/billing.\n5. Scale only after recurring consent, pCore, passive/HA and entitlement checks are closed.\n\n## References\n\n- Manage licensing and billing: https://learn.microsoft.com/sql/sql-server/azure-arc/manage-license-billing\n- Configure SQL Server enabled by Azure Arc: https://learn.microsoft.com/sql/sql-server/azure-arc/manage-configuration\n- Automatic connection and license tags: https://learn.microsoft.com/sql/sql-server/azure-arc/manage-autodeploy\n- PAYG transition and recurring consent: https://learn.microsoft.com/sql/sql-server/azure-arc/manage-pay-as-you-go-transition\n- Billing during connectivity loss: https://learn.microsoft.com/sql/sql-server/azure-arc/extended-security-updates#billing-during-connectivity-loss-and-other-disruptions\n- PAYG transition script: https://github.com/microsoft/sql-server-samples/blob/master/samples/manage/manage-payg-transition/manage-payg-transition.ps1\n- PAYG transition README: https://github.com/microsoft/sql-server-samples/blob/master/samples/manage/manage-payg-transition/README.md"
      },
      "conditionalVisibility": {
        "parameterName": "SelectedTab",
        "comparison": "isEqualTo",
        "value": "References"
      },
      "name": "execution_refs"
    }
  ],
  "$schema": "https://github.com/Microsoft/Application-Insights-Workbooks/blob/master/schema/workbook.json",
