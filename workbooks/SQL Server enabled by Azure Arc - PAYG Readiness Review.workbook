        "version": "KqlItem/1.0",
        "query": "resources\n| where type =~ 'microsoft.azurearcdata/sqlserverinstances'\n| extend HostId = tolower(tostring(properties.containerResourceId))\n| extend Edition=tostring(properties.edition), Version=tostring(properties.version), InstanceLicenseType=tostring(properties.licenseType), VCore=toint(properties.vCore)\n| extend EditionRank = case(Edition has 'Enterprise', 6, Edition has 'Standard', 5, Edition has 'Web', 4, Edition has 'Express', 3, Edition has 'Developer', 2, Edition has 'Evaluation', 1, 0)\n| extend SqlVersionMajor = case(Version has 'SQL Server 2014' or Version startswith '12.', 'SQL Server 2014', Version has 'SQL Server 2016' or Version startswith '13.', 'SQL Server 2016', Version has 'SQL Server 2017' or Version startswith '14.', 'SQL Server 2017', Version has 'SQL Server 2019' or Version startswith '15.', 'SQL Server 2019', Version has 'SQL Server 2022' or Version startswith '16.', 'SQL Server 2022', Version has 'SQL Server 2025' or Version startswith '17.', 'SQL Server 2025', isnotempty(Version), Version, 'Not identified')\n| summarize Instances=count(), ActiveInstances=countif(InstanceLicenseType !~ 'HADR'), HadrInstances=countif(InstanceLicenseType =~ 'HADR'), TopEditionRank=max(EditionRank), Editions=make_set(Edition), Versions=make_set(SqlVersionMajor), InstanceLicenseTypes=make_set(InstanceLicenseType), InstanceVCores=sum(VCore) by HostId\n| extend TopEdition = case(TopEditionRank == 6, 'Enterprise', TopEditionRank == 5, 'Standard', TopEditionRank == 4, 'Web', TopEditionRank == 3, 'Express', TopEditionRank == 2, 'Developer', TopEditionRank == 1, 'Evaluation', 'Not identified')\n| extend IsFreeOrTestEdition = TopEdition in ('Developer','Evaluation','Express')\n| extend HadrOnlySignal = Instances > 0 and ActiveInstances == 0\n| join kind=leftouter (\n    resources\n    | where type =~ 'microsoft.hybridcompute/machines'\n    | extend HostId = tolower(id)\n    | project HostId, MachineName=tostring(name), ArcStatus=tostring(properties.status), MachineProvisioningState=tostring(properties.provisioningState), LogicalCoreCount=toint(properties.detectedProperties.logicalCoreCount), PhysicalCoreCount=toint(properties.detectedProperties.coreCount), ResourceGroup=resourceGroup, SubscriptionId=subscriptionId\n) on HostId\n| join kind=leftouter (\n    resources\n    | where type =~ 'microsoft.hybridcompute/machines/extensions'\n    | where tostring(properties.publisher) =~ 'Microsoft.AzureData'\n    | where tostring(properties.type) in~ ('WindowsAgent.SqlServer','LinuxAgent.SqlServer')\n    | extend HostId = tolower(substring(id, 0, indexof(id, '/extensions')))\n    | extend HostLicenseTypeRaw = tostring(properties.settings.LicenseType)\n    | extend HostLicenseType = case(HostLicenseTypeRaw =~ 'PAYG', 'PAYG', HostLicenseTypeRaw =~ 'Paid', 'Paid', HostLicenseTypeRaw =~ 'LicenseOnly', 'LicenseOnly', isempty(HostLicenseTypeRaw), 'Not reported', HostLicenseTypeRaw)\n    | extend UsePhysicalCoreLicenseRaw = tostring(properties.settings.UsePhysicalCoreLicense.IsApplied)\n    | extend UsePhysicalCoreLicense = case(UsePhysicalCoreLicenseRaw =~ 'true', 'Applied', UsePhysicalCoreLicenseRaw =~ 'false', 'Not applied', 'Not reported')\n    | extend RecurringPAYGConsent = tostring(properties.settings.ConsentToRecurringPAYG.Consented)\n    | extend RecurringPAYGConsentTimestamp = tostring(properties.settings.ConsentToRecurringPAYG.ConsentTimestamp)\n    | project HostId, ExtensionState=tostring(properties.provisioningState), HostLicenseType, EnableESU=tostring(properties.settings.enableExtendedSecurityUpdates), UsePhysicalCoreLicense, RecurringPAYGConsent, RecurringPAYGConsentTimestamp\n) on HostId\n| extend HostLicenseType = coalesce(HostLicenseType, 'Not reported')\n| extend UsePhysicalCoreLicense = coalesce(UsePhysicalCoreLicense, 'Not reported')\n| extend EstimatedCoreSignal = coalesce(InstanceVCores, LogicalCoreCount, PhysicalCoreCount, 0)\n| extend ValidationFlags = strcat(\n    iif(ArcStatus !~ 'Connected', strcat('Arc status: ', coalesce(ArcStatus,'Not reported'), '; '), ''),\n    iif(ExtensionState !~ 'Succeeded', strcat('Extension state: ', coalesce(ExtensionState,'Not reported'), '; '), ''),\n    iif(HostLicenseType == 'PAYG', 'Already reports PAYG; validate billing and recurring consent if CSP-managed; ', ''),\n    iif(HostLicenseType == 'PAYG' and RecurringPAYGConsent !~ 'Consented', 'Recurring PAYG consent not reported on extension; required for CSP-managed subscriptions; ', ''),\n    iif(HostLicenseType == 'Paid', 'Validate SA or SQL Server Subscription entitlement before change; ', ''),\n    iif(HostLicenseType == 'LicenseOnly', 'LicenseOnly/free/perpetual signal; not automatic PAYG; ', ''),\n    iif(tostring(InstanceLicenseTypes) has 'ServerCAL', 'Server+CAL signal; validate separately before PAYG because Arc PAYG is core-based; ', ''),\n    iif(HostLicenseType == 'Not reported', 'LicenseType not reported; validate SQL extension configuration; ', ''),\n    iif(UsePhysicalCoreLicense == 'Applied', 'pCore/SQLServerLicense signal; validate scope and billingPlan; ', ''),\n    iif(HadrOnlySignal, 'HA/DR-only signal; validate passive eligibility; ', ''),\n    iif(HadrInstances > 0 and ActiveInstances > 0, 'Mixed active + HADR instances; validate HA topology; ', ''),\n    iif(IsFreeOrTestEdition, 'Free/test top edition signal; ', '')\n)\n| extend ReviewScope = case(\n    HostLicenseType == 'Paid' and TopEdition in ('Enterprise','Standard') and ActiveInstances > 0, 'Paid Enterprise/Standard - review for PAYG',\n    HostLicenseType == 'Paid' and HadrOnlySignal, 'Paid HA/DR-only - review passive status',\n    HostLicenseType == 'PAYG', 'Already PAYG',\n    HostLicenseType == 'LicenseOnly', 'LicenseOnly - inventory only',\n    HostLicenseType == 'Not reported', 'Needs LicenseType configuration review',\n    IsFreeOrTestEdition, 'Free/test edition - inventory only',\n    'Review')\n| extend FirstWaveFit = case(\n    ReviewScope == 'Paid Enterprise/Standard - review for PAYG' and ArcStatus =~ 'Connected' and ExtensionState =~ 'Succeeded' and UsePhysicalCoreLicense != 'Applied' and HadrInstances == 0 and tostring(InstanceLicenseTypes) !has 'ServerCAL', 'Clean first-wave candidate after commercial approval',\n    ReviewScope == 'Paid Enterprise/Standard - review for PAYG', 'PAYG review scope with technical flags',\n    ReviewScope)\n| extend DryRunWouldInclude = iff(HostLicenseType != 'PAYG' and ExtensionState =~ 'Succeeded', 'Yes - script scope if SQL discovered', 'No')| project MachineName, ReviewScope, FirstWaveFit, DryRunWouldInclude, HostLicenseType, TopEdition, CoreSignalNotBilling=EstimatedCoreSignal, Instances, ActiveInstances, HadrInstances, UsePhysicalCoreLicense, RecurringPAYGConsent, RecurringPAYGConsentTimestamp, ArcStatus, ExtensionState, Editions=tostring(Editions), Versions=tostring(Versions), InstanceLicenseTypes=tostring(InstanceLicenseTypes), ResourceGroup, SubscriptionId, ValidationFlags\n| order by ReviewScope asc, FirstWaveFit asc, CoreSignalNotBilling desc, MachineName asc\n| where FirstWaveFit == 'Clean first-wave candidate after commercial approval'\n| order by CoreSignalNotBilling desc, MachineName asc",
